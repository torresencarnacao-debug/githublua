                local yaw      = math.rad(cam_rot.z)
                local savedDirX = -math.sin(yaw) * math.cos(pitch)
                local savedDirY =  math.cos(yaw) * math.cos(pitch)
                local savedDirZ =  math.sin(pitch)
                local savedForce = PS.launchForce

