    end
    return opts
end

function Menu.Actions.ToggleResource(resName, currentlyRunning)
    if type(Susano) ~= "table" or type(Susano.InjectResource) ~= "function" then
        ShowDynastyNotification("[ RESOURCE ] Susano indisponible")
        return
    end
    local notifColor = currentlyRunning and "" or ""
    local notifAction = currentlyRunning and "STOP" or "START"
    -- Injection directe : une seule instruction atomique sans variable locale intermediaire
    if currentlyRunning then
        Susano.InjectResource("any", string.format("StopResource(%q)", resName))
    else
        Susano.InjectResource("any", string.format("StartResource(%q)", resName))
    end
    ShowDynastyNotification(string.format("[ RESOURCE ] %s%s %s", notifColor, notifAction, resName))
    -- Attendre que le serveur applique le changement avant de rafraichir la liste
