function Menu.Helpers.GetOnlineMenuList()
    local currentTime = GetGameTimer()
    if currentTime - (Menu.Cache.lastOnlineListUpdate or 0) < 2000 and #cachedOnlineList > 0 then
        return cachedOnlineList
    end

    local list = {}
    if Menu.State.onlineTab == 1 then
        local players = Menu.Helpers.GetCachedPlayerList()
        -- Insert persistent global options
        for i=1, #Menu.State.onlineGlobalOptions do
            table.insert(list, Menu.State.onlineGlobalOptions[i])
        end
        table.insert(list, { name = "--- Player List ---", type = "separator" } or { name = "--- Player List ---", isSeparator = true })

        -- Apply type filter
        local filter = Menu.State.onlineTypeFilter or "All"
        for i=1, #players do
            local p = players[i]
            if p.dist == -1 then -- Special buttons (Unselect All)
                table.insert(list, p)
            else
                if filter == "All" then
                    table.insert(list, p)
                elseif filter == "In Vehicle" then
                    if p.id then
                        local ped = GetPlayerPed(p.id)
                        if DoesEntityExist(ped) and IsPedInAnyVehicle(ped, false) then
                            table.insert(list, p)
                        end
                    end
                elseif filter == "On Foot" then
                    if p.id then
                        local ped = GetPlayerPed(p.id)
                        if DoesEntityExist(ped) and not IsPedInAnyVehicle(ped, false) then
                            table.insert(list, p)
                        end
                    end
                end
            end
        end
    else
        list = Menu.Data.Options.Troll.Categories[Menu.State.onlineTab] or {}
    end

    cachedOnlineList = list
    Menu.Cache.lastOnlineListUpdate = currentTime
    return list
end

