local function DrawChamsHighlighter(entity, r, g, b, alpha)
    if not entity or entity == 0 or not DoesEntityExist(entity) then return end
    local isPed = IsEntityAPed(entity)
    local isVeh = IsEntityAVehicle(entity)
    local aInt = math.floor(alpha)
    local thick = Menu.State.highlighterThickness or 1.0

    -- Recupere la couleur dynamique du theme si disponible, sinon vert par defaut
    local vr, vg, vb = r, g, b

    -- 1. Native Outline Glow (chams) — wallhack visible à travers les murs
    pcall(SetEntityDrawOutline, entity, true)
    pcall(SetEntityDrawOutlineColor, vr, vg, vb, 255)
    pcall(SetEntityDrawOutlineShader, 1)  -- shader 1 = visible à travers la géométrie

    -- Purge _freecamHighlightTarget si l'entité a été supprimée entre deux frames
    if _G._freecamHighlightTarget and not DoesEntityExist(_G._freecamHighlightTarget) then
        _G._freecamHighlightTarget = nil
    end
    -- Pour les véhicules : en freecam on dessine aussi la boite wireframe (feedback visuel Crash)
    -- Hors freecam : on continue comme avant (outline glow seul pour les véhicules)
    if isVeh and not _G._freecamHighlightTarget then return end
    if isVeh and _G._freecamHighlightTarget ~= entity then return end

    -- 2. Fleche 3D pointee au-dessus de la tete (peds uniquement)
    local coords = GetEntityCoords(entity)
    local okDim, minDim, maxDim = pcall(GetModelDimensions, GetEntityModel(entity))
    local hOffset = (okDim and maxDim and minDim) and ((maxDim.z - minDim.z) + 0.55) or 2.15
    local markerSize = 0.25 + (thick - 1.0) * 0.1
    DrawMarker(2, coords.x, coords.y, coords.z + hOffset, 0.0, 0.0, 0.0, 180.0, 0.0, 0.0, markerSize, markerSize, markerSize, vr, vg, vb, 230, true, true, 2, false, nil, nil, false)

    -- 3. Boite 3D fil de fer encadrant l'entite
    if okDim and minDim and maxDim then
        local pad = 0.02 + (thick - 1.0) * 0.03
        local minX, minY, minZ, maxX, maxY, maxZ

        if isPed then
            -- Pour les peds la bounding box du modele est souvent trop large.
            -- On utilise les bones cles pour recalculer une boite fidele a la silhouette.
            local boneIds = {
                31086,  -- Head
                39317,  -- Neck
                24818,  -- Spine3 (epaules)
                23553,  -- Spine0 (bassin)
                45509,  -- L_UpperArm
                40269,  -- R_UpperArm
                18905,  -- L_Hand
                57005,  -- R_Hand
                58271,  -- L_Thigh
                63931,  -- L_Calf
                28252,  -- R_Calf
                14201,  -- L_Foot
                26610,  -- R_Foot
            }
            local bMinX, bMinY, bMinZ =  9999,  9999,  9999
            local bMaxX, bMaxY, bMaxZ = -9999, -9999, -9999
            local gotAny = false
            local entityCoords = GetEntityCoords(entity)
            for _, boneId in ipairs(boneIds) do
                local ok2, bx, by, bz = pcall(GetPedBoneCoords, entity, boneId, 0.0, 0.0, 0.0)
                if ok2 and bx then
                    -- Convertir en local entity space pour les comparaisons
                    local lx = bx - entityCoords.x
                    local ly = by - entityCoords.y
                    local lz = bz - entityCoords.z
                    if lx < bMinX then bMinX = lx end
                    if ly < bMinY then bMinY = ly end
                    if lz < bMinZ then bMinZ = lz end
