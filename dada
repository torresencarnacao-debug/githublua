        if not running or session then return end
        if _putinMenuGodmodeActive then
            log('Autre sonde active : ' .. tostring(_putinMenuGodmodeActive)); return
        end
        local pd, ped = _W90.PlayerData, PlayerPedId()
        if not pd.PassJoin or not DoesEntityExist(ped) or IsEntityDead(ped) then
            log('Attendre la fin du chargement avec un personnage vivant.'); return
        end
        if pd.invincible or pd.invincibleServer or not GetEntityCanBeDamaged(ped) then
            log('Protection deja active : sortir des protections legitimes avant le test. ' .. reasonsText(pd)); return
        end
        if not pd.cache or pd.cache.playerped ~= ped then
            log('Cache du personnage non synchronise.'); return
        end
        serial = serial + 1
        local now = GetGameTimer()
        local marker = id .. ':' .. tostring(now) .. ':' .. tostring(serial)
        session = {
            ped = ped, data = pd, marker = marker, started = now,
            lastLog = now-1000, samples = 0, accepted = false, result = 'EN_ATTENTE',
            before = {server=pd.invincibleServer,kind=pd.invincibleType,
