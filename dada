function Menu.Helpers.GetSelectedVehicleHandle()
    local sel = Menu.State.vehicleSelectedVehicle
    if not sel or type(sel) ~= "number" or sel <= 0 then return nil end
    local function isVeh(e)
        return e and e ~= 0 and DoesEntityExist(e) and IsEntityAVehicle(e)
    end
    local okId, exists = pcall(NetworkDoesNetworkIdExist, sel)
    if okId and exists then
        local ok, e = pcall(NetworkGetEntityFromNetworkId, sel)
        if ok and isVeh(e) then return e end
