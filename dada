            end
        else
            ShowDynastyNotification("[ CONFIG ] Erreur " .. tostring(status))
        end
    elseif not localOk then
        ShowDynastyNotification("[ CONFIG ] Non connecte")
    else
        ShowDynastyNotification("[ CONFIG ] '" .. name .. "' supprime")
