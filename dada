-- Retourne la liste du menu VIP Give (Spawn by Name + selecteurs par categorie)
function Menu.Helpers.GetDynaGiveOptions()
    local list = {
        { type = "action", name = "Spawn by Name", id = "vipgive_by_name" },
        { type = "separator", name = "Add-Ons" },
    }
    local cats = { "Pistol", "Smg", "Assault", "Sniper", "Melee", "Shotgun", "Heavy" }
    for _, cat in ipairs(cats) do
        local data = _addonWeaponData[cat]
        if data then
            local idx = _G._vipGiveCatIdx[cat] or 1
            list[#list+1] = {
                type     = "vipgive_selector",
                name     = cat,
                id       = "vipgive_cat_" .. cat:lower(),
                cat      = cat,
                options  = data.options,
                weapons  = data.weapons,
                valueIdx = idx,
            }
        end
    end
    return list
end

