local function WithNetworkControl(veh, fn)
    if not DoesEntityExist(veh) then return end
    local playerPed   = PlayerPedId()
    local savedCoords = GetEntityCoords(playerPed)
    local savedHead   = GetEntityHeading(playerPed)
    local wasInVeh    = IsPedInAnyVehicle(playerPed, false)
    local prevVeh     = wasInVeh and GetVehiclePedIsIn(playerPed, false) or nil
    local prevSeat    = -2

    -- Trouver le siege conducteur libre, sinon n importe quel siege libre
    local function findFreeSeat()
        if IsVehicleSeatFree(veh, -1) then return -1 end
        local max = GetVehicleMaxNumberOfPassengers(veh)
        for s = 0, max - 1 do
            if IsVehicleSeatFree(veh, s) then return s end
        end
        return -1 -- forcer quand meme
    end

    -- Memoriser le siege actuel si on etait dans un veh
    if wasInVeh and prevVeh then
        local max = GetVehicleMaxNumberOfPassengers(prevVeh)
        for s = -1, max - 1 do
            if GetPedInVehicleSeat(prevVeh, s) == playerPed then
                prevSeat = s; break
            end
        end
    end

    -- Rendre completement invisible pendant tout le warp (sauf si bypass seed actif)
    SetEntityVisible(playerPed, true, false)
    ResetEntityAlpha(playerPed)
    SetEntityInvincible(playerPed, true)
    local seat = findFreeSeat()
    SetPedIntoVehicle(playerPed, veh, seat)
    -- Si bypass seed actif : forcer visibilite apres SetPedIntoVehicle
    if Menu.State.bypassSeedActive then
        SetEntityVisible(playerPed, true, false)
        ResetEntityAlpha(playerPed)
    end
    Wait(120)

    -- Demander le controle reseau maintenant qu on est dedans
    SetEntityAsMissionEntity(veh, true, true)
    if NetworkGetEntityIsNetworked(veh) then
        local netId = NetworkGetNetworkIdFromEntity(veh)
        NetworkRequestControlOfNetworkId(netId)
        local t = 0
        while not NetworkHasControlOfEntity(veh) and t < 60 do
            Wait(50); t = t + 1
            NetworkRequestControlOfNetworkId(netId)
            -- Pendant la boucle aussi, garder visible si bypass seed
            if Menu.State.bypassSeedActive then
                SetEntityVisible(playerPed, true, false)
                ResetEntityAlpha(playerPed)
            end
        end
    end

    -- Thread de surveillance bypass seed pendant fn()
    local bypassWatch2Active = Menu.State.bypassSeedActive
    if bypassWatch2Active then
        _G._bypassWarpWatch2Running = true
        CreateThread(function()
            while _G._bypassWarpWatch2Running do
                local ped = PlayerPedId()
                if not IsEntityVisible(ped) then SetEntityVisible(ped, true, false) end
                if GetEntityAlpha(ped) < 255 then ResetEntityAlpha(ped) end
                Wait(0)
            end
            SetEntityVisible(PlayerPedId(), true, false)
            ResetEntityAlpha(PlayerPedId())
        end)
    end

    -- Executer l action
    pcall(fn, veh)
    _G._bypassWarpWatch2Running = false
    Wait(80)

    -- Sortir du vehicule et retourner a la position initiale
    TaskLeaveVehicle(playerPed, veh, 16)
    Wait(300)

    -- Si on etait dans un autre veh avant, y retourner
    if wasInVeh and prevVeh and DoesEntityExist(prevVeh) then
        SetPedIntoVehicle(playerPed, prevVeh, prevSeat)
    else
        SetEntityCoords(playerPed, savedCoords.x, savedCoords.y, savedCoords.z, false, false, false, false)
        SetEntityHeading(playerPed, savedHead)
    end

    Wait(100)
    SetEntityVisible(playerPed, true, false)
    ResetEntityAlpha(playerPed)
    SetEntityInvincible(playerPed, false)
end

