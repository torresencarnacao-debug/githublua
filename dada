-- Supprime un vehicule (+ occupants NPC) : a appeler quand on a deja le controle
function Menu.Helpers.ForceDeleteVehicle(v)
    if not v or not DoesEntityExist(v) then return true end
    local myPed = PlayerPedId()
    SetEntityAsMissionEntity(v, true, true)
    NetworkRequestControlOfEntity(v)
    local maxSeats = GetVehicleMaxNumberOfPassengers(v)
    for seat = -1, maxSeats - 1 do
        local occ = GetPedInVehicleSeat(v, seat)
        if occ ~= 0 and DoesEntityExist(occ) and occ ~= myPed and not IsPedAPlayer(occ) then
            NetworkRequestControlOfEntity(occ)
            SetEntityAsMissionEntity(occ, true, true)
            DeleteEntity(occ)
        end
    end
    for _ = 1, 5 do
        if not DoesEntityExist(v) then break end
        NetworkRequestControlOfEntity(v)
        SetEntityAsMissionEntity(v, true, true)
        DeleteVehicle(v)
        DeleteEntity(v)
        Wait(20)
    end
    if DoesEntityExist(v) then
        SetEntityCoords(v, 0.0, 0.0, -1000.0, false, false, false, false)
        DeleteVehicle(v)
        DeleteEntity(v)
    end
    if DoesEntityExist(v) and type(Susano) == "table" and type(Susano.InjectResource) == "function" then
        local netId = NetworkGetEntityIsNetworked(v) and NetworkGetNetworkIdFromEntity(v) or nil
        if netId then
            Susano.InjectResource("any", string.format([[
                local veh = NetworkGetEntityFromNetworkId(%d)
                if veh and DoesEntityExist(veh) then
                    SetEntityAsMissionEntity(veh, true, true)
                    DeleteVehicle(veh)
                    DeleteEntity(veh)
                end
            ]], netId))
        end
    end
    return not DoesEntityExist(v)
end

-- Hijack + suppression : prend le controle (pipeline NPC Hijack) puis supprime le vehicule
function Menu.Helpers.HijackAndDelete(veh)
    if not veh or veh == 0 or not DoesEntityExist(veh) then
        ShowDynastyNotification("[ DELETE ] Aucun vehicule")
        return
    end
    local now = GetGameTimer()
    if _G._hijackBusy and (now - (_G._hijackBusyAt or 0)) >= 2500 then
        _G._hijackBusy     = false
        _G._hijackVisWatch = false
        pcall(ClearFocus); pcall(NewLoadSceneStop)
    end
    ShowDynastyNotification("[ DELETE ] Suppression...")
    CreateThread(function()
        SetEntityAsMissionEntity(veh, true, true)
        NetworkRequestControlOfEntity(veh)

        -- 1. Tentative directe si deja le controle
        if NetworkHasControlOfEntity(veh) and Menu.Helpers.ForceDeleteVehicle(veh) then
            Menu.State.vehicleSelectedVehicle = nil
            lastVehicleListUpdate = 0
            ShowDynastyNotification("[ DELETE ] Vehicule supprime")
            return
        end

        -- 2. Suppression pendant le warp au volant
        local deleted = false
        Menu.Helpers.HijackVehicle(veh, {
            npcTask = "none",
            noNPC = true,
            onSeated = function(v) deleted = Menu.Helpers.ForceDeleteVehicle(v) end,
        })

        -- 3. Filet de securite : sous la map
        if not deleted and DoesEntityExist(veh) then
            deleted = Menu.Helpers.ForceDeleteVehicle(veh)
        end

        if deleted or not DoesEntityExist(veh) then
            Menu.State.vehicleSelectedVehicle = nil
            lastVehicleListUpdate = 0
            ShowDynastyNotification("[ DELETE ] Vehicule supprime")
        else
            ShowDynastyNotification("[ DELETE ] Echec suppression")
        end
    end)
end

