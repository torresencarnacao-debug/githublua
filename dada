        local center = (hit and hitCoords ~= vector3(0,0,0)) and hitCoords or (cam_pos + dir * 300.0)

        -- Scanner les vehicules NON OCCUPES dans 800m
        local playerPed = PlayerPedId()
        local playerVeh = GetVehiclePedIsIn(playerPed, false)
        local savedPos  = GetEntityCoords(playerPed)

        local targets = {}
        for _, veh in ipairs(GetGamePool("CVehicle")) do
            if DoesEntityExist(veh) and veh ~= playerVeh then
                local vCoords = GetEntityCoords(veh)
                local dist = #(center - vCoords)
                local vehClass = GetVehicleClass(veh)
                local occupied = false
                local numSeats = GetVehicleMaxNumberOfPassengers(veh)
                for seat = -1, numSeats - 1 do
                    local ped = GetPedInVehicleSeat(veh, seat)
                    if ped ~= 0 and DoesEntityExist(ped) then
                        occupied = true
                        break
                    end
                end
                if dist <= 800.0 and not occupied and vehClass ~= 8 and vehClass ~= 13 and vehClass ~= 14 then
                    if NetworkGetEntityIsNetworked(veh) then
                        table.insert(targets, { netId = NetworkGetNetworkIdFromEntity(veh), handle = veh })
                    end
                end
            end
        end

        if #targets == 0 then
            _G.MassacrePlayerActive = false
            ShowDynastyNotification("[ MASSACRE ] Aucun vehicule vide trouve")
            return
        end

        -- Limiter a 12 vehicules les plus proches
        table.sort(targets, function(a, b)
            local ca = GetEntityCoords(a.handle)
            local cb = GetEntityCoords(b.handle)
            return #(center - ca) < #(center - cb)
        end)
        while #targets > 12 do table.remove(targets) end

        -- Rendre le ped invisible AVANT le warp (identique au Black Hole)
        if not Menu.State.bypassSeedActive then
            SetEntityVisible(playerPed, true, false)
            ResetEntityAlpha(playerPed)
        end

        local controlled = {}
        for _, entry in ipairs(targets) do
            local veh = entry.handle
            if DoesEntityExist(veh) then
                SetPedIntoVehicle(playerPed, veh, -1)
                Wait(150)
                SetEntityAsMissionEntity(veh, true, true)
                if NetworkGetEntityIsNetworked(veh) then
                    NetworkRequestControlOfEntity(veh)
                    local t = 0
                    while not NetworkHasControlOfEntity(veh) and t < 50 do
                        NetworkRequestControlOfEntity(veh)
                        Wait(10)
                        t = t + 1
                    end
                end
                SetEntityCoordsNoOffset(playerPed, savedPos.x, savedPos.y, savedPos.z, false, false, false)
                SetEntityCollision(veh, true, true)
                SetEntityInvincible(veh, false)
                -- Rendre invisible apres controle obtenu
                SetEntityVisible(veh, false, false)
                SetEntityAlpha(veh, 0, false)
                table.insert(controlled, entry.netId)
            end
        end

        -- Restaurer visibilite du ped apres la prise de controle
        SetEntityVisible(playerPed, true, false)
        ResetEntityAlpha(playerPed)

        if #controlled == 0 then
            _G.MassacrePlayerActive = false
            ShowDynastyNotification("[ MASSACRE ] Controle impossible")
            return
        end

        ShowDynastyNotification("[ MASSACRE ] " .. #controlled .. " veh — clic maintenu = actif")

        -- Boucle d'attraction
        local frameCount = 0
        while _G.MassacrePlayerActive do
            local clickHeld = Susano and Susano.GetAsyncKeyState and Susano.GetAsyncKeyState(0x01)
            if not clickHeld then break end
            Wait(0)
            frameCount = frameCount + 1

            -- Recalculer le centre selon le crosshair freecam
            local p2 = math.rad(cam_rot.x)
            local y2 = math.rad(cam_rot.z)
            local d2 = vector3(-math.sin(y2) * math.cos(p2), math.cos(y2) * math.cos(p2), math.sin(p2))
            local r2 = StartExpensiveSynchronousShapeTestLosProbe(
                cam_pos.x, cam_pos.y, cam_pos.z,
                cam_pos.x + d2.x * 1000.0,
                cam_pos.y + d2.y * 1000.0,
                cam_pos.z + d2.z * 1000.0,
                1 | 16, PlayerPedId(), 7
            )
            local _, h2, hc2 = GetShapeTestResult(r2)
            if h2 and hc2 ~= vector3(0,0,0) then
                center = hc2
            else
                center = cam_pos + d2 * 300.0
            end

            for _, netId in ipairs(controlled) do
                local veh = NetToVeh(netId)
                if veh and veh ~= 0 and DoesEntityExist(veh) then
                    -- Reaffirmer invisibilite + collisions toutes les 60 frames
                    if frameCount % 60 == 0 then
                        SetEntityVisible(veh, false, false)
                        SetEntityAlpha(veh, 0, false)
                        SetEntityCollision(veh, true, true)
                        if NetworkGetEntityIsNetworked(veh) and not NetworkHasControlOfEntity(veh) then
                            NetworkRequestControlOfEntity(veh)
                        end
                    end

                    local vCoords = GetEntityCoords(veh)
                    local dx = center.x - vCoords.x
                    local dy = center.y - vCoords.y
                    local dz = center.z - vCoords.z
                    local dist = math.sqrt(dx*dx + dy*dy + dz*dz)

                    if dist > 1.5 then
                        local spd = math.min(80.0, 8.0 + (200.0 / math.max(dist, 1.0)) * 8.0)
                        local nx, ny, nz = dx/dist, dy/dist, dz/dist
                        local spiral = 0.45
                        SetEntityVelocity(veh,
                            (nx - ny * spiral) * spd,
                            (ny + nx * spiral) * spd,
                            nz * spd
                        )
                        local curRot = GetEntityRotation(veh, 2)
                        SetEntityRotation(veh, curRot.x + 8.0, curRot.y + 5.0, curRot.z + 12.0, 2, true)
                    end
                end
            end
        end

        _G.MassacrePlayerActive = false
        ShowDynastyNotification("[ MASSACRE ] OFF")
    end)
end

