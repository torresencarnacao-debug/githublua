-- Cache des vehicules pour l'onglet List
local cachedVehicleList = {}
local lastVehicleListUpdate = 0

function Menu.Helpers.GetVehicleMenuList()
    local currentTime = GetGameTimer()
    if currentTime - lastVehicleListUpdate < 500 and #cachedVehicleList > 0 then
        return cachedVehicleList
    end
    lastVehicleListUpdate = currentTime

    local list = {}

    -- Selecteur 1 : Action
    table.insert(list, {
        type = "selector",
        name = "Action",
        id = "veh_action_mode",
        options = {"Bring", "TP To", "Warp"},
        valueIdx = Menu.State.vehicleActionMode or 1
    })

    -- Selecteur 2 : Selection
    table.insert(list, {
        type = "selector",
        name = "Select",
        id = "veh_select_mode",
        options = {"Select All", "Unselect All"},
        valueIdx = 1
    })

    -- Separateur
    table.insert(list, { type = "separator", label = "--- Vehicles Nearby ---" })

    -- Liste des vehicules a proximite
    local success, result = pcall(function()
        local vehicles = {}
        local playerPed = PlayerPedId()
        local myCoords = GetEntityCoords(playerPed)

        for _, veh in ipairs(GetGamePool("CVehicle")) do
            if DoesEntityExist(veh) then
                local vCoords = GetEntityCoords(veh)
                local dist = #(myCoords - vCoords)
                if dist <= 500.0 then
                    -- Filtrer les vehicules occupes (driver ou passagers presents)
                    local isOccupied = false
                    local numSeats = GetVehicleMaxNumberOfPassengers(veh)
                    -- Verifier le siege conducteur (-1)
                    local driver = GetPedInVehicleSeat(veh, -1)
                    if driver and driver ~= 0 and DoesEntityExist(driver) then
                        isOccupied = true
                    end
                    -- Verifier les sieges passagers
                    if not isOccupied then
                        for seat = 0, numSeats - 1 do
                            local passenger = GetPedInVehicleSeat(veh, seat)
                            if passenger and passenger ~= 0 and DoesEntityExist(passenger) then
                                isOccupied = true
                                break
                            end
                        end
                    end
                    

                    local modelHash = GetEntityModel(veh)
                    local modelName = nil
                    -- Tentative 1 : label localise
                    local ok1, mn1 = pcall(function()
                        return GetLabelText(GetDisplayNameFromVehicleModel(modelHash))
                    end)
                    if ok1 and mn1 and mn1 ~= "" and mn1 ~= "NULL" and mn1 ~= "" then
                        modelName = mn1
                    end
                    -- Tentative 2 : nom de modele brut (ex: "adder", "zentorno")
                    if not modelName then
                        local ok2, mn2 = pcall(function()
                            return GetDisplayNameFromVehicleModel(modelHash)
                        end)
                        if ok2 and mn2 and mn2 ~= "" and mn2 ~= "NULL" then
                            modelName = mn2:sub(1,1):upper() .. mn2:sub(2):lower()
                        end
                    end
                    -- Fallback : hash court
                    if not modelName then
                        modelName = "Veh#" .. tostring(modelHash & 0xFFFF)
                    end
                    -- Store occupied status separately (used for badge color in render)
                    local netId = NetworkGetEntityIsNetworked(veh) and NetworkGetNetworkIdFromEntity(veh) or 0
                    local isSelected = (Menu.State.vehicleSelectedVehicle == netId and netId ~= 0)
                        or (Menu.State.vehicleSelectedVehicle == veh and netId == 0)

                    table.insert(vehicles, {
                        name = modelName,
                        veh = veh,
                        netId = netId,
                        dist = dist,
                        isSelected = isSelected,
                        isOccupied = isOccupied,
                    })
                end
            end
            ::continue_veh_loop::
        end

        table.sort(vehicles, function(a, b) return a.dist < b.dist end)
        return vehicles
    end)

    if success and result then
        for _, v in ipairs(result) do
            local toggleActive = v.isSelected
            local distStr = math.floor(v.dist) .. "m"
            -- Badge statut : OCCUPIED (rouge) / FREE (vert) + distance
            local occLabel = v.isOccupied and "OCCUPIED" or "FREE"
            table.insert(list, {
                type = "veh_entry",
                name = v.name,
                veh = v.veh,
                netId = v.netId,
                dist = v.dist,
                isOccupied = v.isOccupied,
                distStr = occLabel .. " " .. distStr,
                toggleActive = toggleActive
            })
        end
    end

    cachedVehicleList = list
    return list
end

function Menu.Actions.ExecuteVehicleAction(vehData)
    local mode = Menu.State.vehicleActionMode or 1
    local veh = vehData.veh
    local netId = vehData.netId

    if not DoesEntityExist(veh) then
        ShowDynastyNotification("[ VEHICLE ] Introuvable")
        return
    end

    if mode == 1 then
        -- Bring : amener le vehicule juste devant le joueur (3m)
        local playerPed = PlayerPedId()
        if NetworkGetEntityIsNetworked(veh) then
            local t = GetGameTimer()
            NetworkRequestControlOfEntity(veh)
            while not NetworkHasControlOfEntity(veh) and GetGameTimer() - t < 3000 do
                Wait(50)
                NetworkRequestControlOfEntity(veh)
            end
            if not NetworkHasControlOfEntity(veh) then
                ShowDynastyNotification("[ VEHICLE ] Controle refuse")
                return
            end
        end
        SetEntityAsMissionEntity(veh, true, false)
        local dest = GetOffsetFromEntityInWorldCoords(playerPed, 0.0, 3.0, 0.0)
        SetEntityCoordsNoOffset(veh, dest.x, dest.y, dest.z, false, false, false)
        SetEntityHeading(veh, GetEntityHeading(playerPed))
        ShowDynastyNotification("[ VEHICLE ] Amene")

    elseif mode == 2 then
        -- TP To : teleporter le joueur juste a cote du vehicule (1.5m)
        local vCoords = GetEntityCoords(veh)
        local vHeading = GetEntityHeading(veh)
        local playerPed = PlayerPedId()
        local offsetX = math.cos(math.rad(vHeading + 90)) * 1.5
        local offsetY = math.sin(math.rad(vHeading + 90)) * 1.5
        SetEntityCoords(playerPed, vCoords.x + offsetX, vCoords.y + offsetY, vCoords.z, false, false, false, false)
        ShowDynastyNotification("[ VEHICLE ] Teleporte")

    elseif mode == 3 then
        -- Warp : monter directement dans le vehicule (siÃ¨ge conducteur)
        local playerPed = PlayerPedId()
        if NetworkGetEntityIsNetworked(veh) then
            NetworkRequestControlOfEntity(veh)
        end
        SetPedIntoVehicle(playerPed, veh, -1)
        ShowDynastyNotification("[ VEHICLE ] Warp")
    end
end

