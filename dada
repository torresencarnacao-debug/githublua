local airborneSince = {}
local function suspectedNoclip(player, ped)
    local suspicious = not IsPedInAnyVehicle(ped, false)
        and not IsEntityAttached(ped) and not IsPedFalling(ped)
        and not IsPedJumping(ped) and not IsPedRagdoll(ped)
        and not IsPedInParachuteFreeFall(ped) and not IsPedSwimming(ped)
        and GetEntityHeightAboveGround(ped) > 1.5
    if not suspicious then airborneSince[player] = nil; return false end
    local now = GetGameTimer()
    local sample = airborneSince[player]
    if not sample or sample.ped ~= ped or now - sample.last > 500 then
        sample = {ped=ped, since=now, last=now}
        airborneSince[player] = sample
    end
    sample.last = now
    return now - sample.since >= 1200
end
local function staffFeet(ped)
    local left = GetPedBoneCoords(ped, 14201, 0.0, 0.0, 0.0)
    local right = GetPedBoneCoords(ped, 52301, 0.0, 0.0, 0.0)
    return {x=(left.x + right.x) * 0.5, y=(left.y + right.y) * 0.5, z=math.min(left.z, right.z)}
end

local function renderESP()
    local me = PlayerPedId()
    if not DoesEntityExist(me) then return end

    local myCoords = GetEntityCoords(me)
    local myFeet = staffFeet(me)
    local players = GetActivePlayers()

    for _, player in ipairs(players) do
        if player ~= PlayerId()
            and NetworkIsPlayerActive(player) then

            local ped = GetPlayerPed(player)

            if ped ~= 0
                and DoesEntityExist(ped)
                and not IsEntityDead(ped) then

                local coords = GetEntityCoords(ped)
                local dist = #(myCoords - coords)
                local invisible = isInvisible(ped)
                local noclip = suspectedNoclip(player, ped)

                if dist <= ESP.maxDistance
                    and (invisible or noclip) then

                    local r, g, b = rainbow(player * 0.35)
                    local feet = staffFeet(ped)

                    if ESP.tracers then
                        staffThickLine(
                            myFeet.x,
                            myFeet.y,
                            myFeet.z,
                            feet.x,
                            feet.y,
                            feet.z,
                            r, g, b, 255
                        )
                    end

                    if ESP.skeleton then
                        drawSkeleton(ped, r, g, b)
                    end

                    if ESP.names then
                        local name = GetPlayerName(player)
                            or "Unknown"

                        local label = name

                        if invisible then
                            label = "[INVISIBLE] " .. label
                        elseif noclip then
                            label = "[NOCLIP ?] " .. label
                        end

                        if ESP.distance then
                            label = label ..
                                string.format(
                                    " [%.0fm]", dist
                                )
                        end

                        drawText3D(
                            feet.x,
                            feet.y,
                            feet.z - 0.20,
                            label,
                            r, g, b
                        )
                    end
                end
            end
        end
    end
end

