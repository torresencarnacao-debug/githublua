    local models={Chariot={'prop_sign_road_01a','prop_sign_road_01b','prop_sign_road_02a','prop_rub_cage01a'},Cage={'prop_dog_cage_01'}}
    -- Nouveaux modeles : reutilisation stricte du script et du circuit Cage.
    for _,name in ipairs({'prop_rub_wheel_02','prop_box_wood06a','prop_boxpile_08a','prop_elec_heater_01','prop_gas_pump_1c'}) do
        models[name]={name}
        scripts[name]=scripts.Cage:gsub('prop_dog_cage_01',name)
    end
    local function enqueue(mode,point)
        if not Susano or type(Susano.GetInjectableResources)~='function' or type(Susano.InjectResource)~='function' then return end
        if _G._effectVehicleWarpBusy and not session then return end
        local target
        for _,name in ipairs(Susano.GetInjectableResources())do
            if type(name)=='string' and name:lower()=='ox_lib' then target=name;break end
        end
        if not target then return end
        local ped=PlayerPedId()
        if not DoesEntityExist(ped) or IsEntityDead(ped) then return end
        if not session then
            session=Menu.Helpers.CaptureShootCarOrigin()
            session.attachWasVisible=IsEntityVisible(ped)
            session.attachOriginalAlpha=GetEntityAlpha(ped)
        end
        if session.ped~=ped then session=nil;return end
        generation=generation+1
        local token=generation
        local origin=session
        _G._effectVehicleWarpBusy=true
        local existing={}
        for _,object in ipairs(GetGamePool('CObject'))do existing[object]=true end
        local hashes={}
        for _,name in ipairs(models[mode])do hashes[GetHashKey(name)]=true end
        local ok,err=pcall(function()
            if not origin.attachHidden then
                SetNoclipVisibility(ped,false)
                origin.attachHidden=true
            end
            local vehicle=GetVehiclePedIsIn(ped,false)
            if vehicle~=0 then TaskLeaveVehicle(ped,vehicle,16) end
            FreezeEntityPosition(ped,false)
            RequestCollisionAtCoord(point.x,point.y,point.z)
            SetEntityCoordsNoOffset(ped,point.x,point.y,point.z,false,false,true)
            -- Injection des le clic : aucun Wait, aucune attente de la requete precedente.
            Susano.InjectResource(target,scripts[mode],Susano.NEW_THREAD or 1)
        end)
        local returnAt=GetGameTimer()+500
        CreateThread(function()
            local safe,why=pcall(function()
                while ok and token==generation and GetGameTimer()<returnAt do
                    if PlayerPedId()~=ped or not DoesEntityExist(ped) then break end
                    Wait(0)
                end
            end)
            -- Un clic plus recent reprend la responsabilite du retour, sans attendre ce thread.
            if token~=generation then return end
            local returned,result=pcall(Menu.Helpers.RestoreShootCarOrigin,origin)
            -- Restaurer une seule fois apres le dernier clic, avec le meme helper que le noclip.
            if origin.attachHidden and PlayerPedId()==origin.ped and DoesEntityExist(origin.ped) then
                local shown,showError=pcall(SetNoclipVisibility,origin.ped,origin.attachWasVisible)
                if shown and origin.attachWasVisible and origin.attachOriginalAlpha~=255 then
                    pcall(SetEntityAlpha,origin.ped,origin.attachOriginalAlpha,false)
                end
                if not shown then print('[ ATTACH ] Visibilite : '..tostring(showError)) end
            end
            session=nil;_G._effectVehicleWarpBusy=false
            if not returned or not result then ShowDynastyNotification('[ ATTACH ] Retour du ped non confirme') end
            if not ok then print('[prop-ox] '..tostring(err))end
            if not safe then print('[prop-ox] '..tostring(why))end
        end)
    end
    function Menu.Actions.SpawnOxProgressCage(point)enqueue('Cage',point)end
    function Menu.Actions.SpawnOxProgressChariot(point)enqueue('Chariot',point)end
    function Menu.Actions.SpawnOxAttachModel(point,model)
        if models[model] and model~='Cage' and model~='Chariot' then enqueue(model,point) end
    end
end

function Menu.Helpers.NewAttachLayout(mode,dimensions,attached)
    local count=0
    local state={cursor=0,rects={},width=0,base=attached and -.75 or .05}
    local total,maxWidth=0,0
    for _,d in ipairs(dimensions) do total=total+d.width*d.length;maxWidth=math.max(maxWidth,d.width) end
    state.width=math.max(maxWidth,math.min(12,math.sqrt(math.max(total,1)*1.3)))
    local function nextPose(d)
        if mode=='Tour' then
            return {x=-d.cx,y=-d.cy,z=state.base+state.cursor-d.low.z,rx=0,ry=0,rz=0,advance=d.height}
        elseif mode=='Rampe' then
            local slope=math.rad(22);local co,si=math.cos(slope),math.sin(slope)
            local middle=state.cursor+d.length*.5
            return {x=-d.cx,y=1.5+middle*co-(d.cy*co-d.high.z*si),
                z=state.base+middle*si-(d.cy*si+d.high.z*co),rx=22,ry=0,rz=0,advance=d.length}
        end
        -- Skyline : chaque voiture occupe le plus bas intervalle libre du mur.
        local choices={0}
        for _,r in ipairs(state.rects) do choices[#choices+1]=r.x+r.w end
        local bestX,bestZ=0,math.huge
        for _,x in ipairs(choices) do
            if x+d.width<=state.width+.001 then
                local z=0
                for _,r in ipairs(state.rects) do
                    if x<r.x+r.w-.001 and x+d.width>r.x+.001 then z=math.max(z,r.z+r.h) end
                end
                if z<bestZ or (z==bestZ and x<bestX) then bestX,bestZ=x,z end
            end
        end
        if bestZ==math.huge then bestX,bestZ=0,state.cursor end
        return {x=bestX-state.width*.5-d.low.x,y=2.5+d.high.z,
            z=state.base+bestZ-d.low.y,rx=90,ry=0,rz=0,rect={x=bestX,z=bestZ,w=d.width,h=d.length}}
    end
    local function commit(p)
        count=count+1
        if p.rect then
            state.rects[#state.rects+1]=p.rect
            state.cursor=math.max(state.cursor,p.rect.z+p.rect.h)
        else state.cursor=state.cursor+p.advance-.04 end
    end
    return nextPose,commit,state
end

function Menu.Helpers.BuildProgressiveVehicleAttach(mode,pool,targetPed,point,yaw)
    if _G._progressiveAttachBusy then ShowDynastyNotification('[ ATTACH ] Construction deja en cours');return end
    _G._progressiveAttachBusy=true
    local count,refused=0,0
    local ok,err=pcall(function()
        local candidates,dimensions={},{}
        for _,entry in ipairs(pool) do
            local v=entry.handle
            if Menu.Helpers.CanUseEffectVehicle(v) then
                local low,high=GetModelDimensions(GetEntityModel(v))
                local d={low=low,high=high,width=math.max(.5,high.x-low.x),length=math.max(.5,high.y-low.y),
                    height=math.max(.3,high.z-low.z),cx=(high.x+low.x)*.5,cy=(high.y+low.y)*.5}
                candidates[#candidates+1]={v=v,d=d};dimensions[#dimensions+1]=d
            end
        end
        local plan,commit=Menu.Helpers.NewAttachLayout(mode,dimensions,targetPed~=nil)
        local heading=math.rad(yaw)
        ShowDynastyNotification(('[ %s ] Construction progressive : %d voitures'):format(mode:upper(),#candidates))
        for _,entry in ipairs(candidates) do
            if targetPed and not DoesEntityExist(targetPed) then break end
            while _G._effectVehicleWarpBusy do Wait(25) end
            local v=entry.v
            local acquired=Menu.Helpers.AcquireEffectVehicleByWarp(v,function()
                return not targetPed or DoesEntityExist(targetPed)
            end,{seatMs=100,stableMs=50,timeoutMs=700,pollMs=10})
            if acquired and Menu.Helpers.CanUseEffectVehicle(v)
                and (not NetworkGetEntityIsNetworked(v) or NetworkHasControlOfEntity(v)) then
                local pose=plan(entry.d)
                local placed=false
                SetEntityVelocity(v,0.0,0.0,0.0)
                SetEntityAngularVelocity(v,0.0,0.0,0.0)
                if targetPed and DoesEntityExist(targetPed) then
                    FreezeEntityPosition(v,false)
                    AttachEntityToEntity(v,targetPed,GetPedBoneIndex(targetPed,0),pose.x,pose.y,pose.z,
                        pose.rx,pose.ry,pose.rz,false,false,false,false,2,true)
                    Wait(0)
                    placed=DoesEntityExist(v) and IsEntityAttachedToEntity(v,targetPed)
                else
                    local x=point.x+pose.x*math.cos(heading)-pose.y*math.sin(heading)
                    local y=point.y+pose.x*math.sin(heading)+pose.y*math.cos(heading)
                    SetEntityCoordsNoOffset(v,x,y,point.z+pose.z,false,false,false)
                    SetEntityRotation(v,pose.rx,pose.ry,yaw+pose.rz,2,true)
                    FreezeEntityPosition(v,true)
                    placed=DoesEntityExist(v)
                end
                if placed then
                    -- Rampe utilisable ; mur/tour sans collisions entre les pieces attachees.
                    SetEntityCollision(v,mode=='Rampe',mode=='Rampe')
                    commit(pose);count=count+1
                else refused=refused+1 end
            else refused=refused+1 end
            Wait(50)
        end
    end)
    _G._progressiveAttachBusy=false
    if not ok then print('[ ATTACH ] '..tostring(err));ShowDynastyNotification('[ ATTACH ] Erreur : voir F8')
    else ShowDynastyNotification(('[ %s ] %d places / %d refuses'):format(mode:upper(),count,refused)) end
end

function Menu.Helpers.CanUseEffectVehicle(veh)
    if not veh or veh==0 or not DoesEntityExist(veh) or IsEntityDead(veh) or IsEntityAttached(veh) then return false end
    if veh==GetVehiclePedIsIn(PlayerPedId(),false) then return false end
    for seat=-1,GetVehicleMaxNumberOfPassengers(veh)-1 do
        local ped=GetPedInVehicleSeat(veh,seat)
        if ped~=0 and DoesEntityExist(ped) and IsPedAPlayer(ped) then return false end
    end
    return true
end
function Menu.Helpers.CaptureShootCarOrigin()
    local ped=PlayerPedId()
    local vehicle=GetVehiclePedIsIn(ped,false)
    local seat
    if vehicle~=0 then
        for i=-1,GetVehicleMaxNumberOfPassengers(vehicle)-1 do
            if GetPedInVehicleSeat(vehicle,i)==ped then seat=i;break end
        end
    end
    return {ped=ped,coords=GetEntityCoords(ped),heading=GetEntityHeading(ped),vehicle=vehicle,seat=seat,
        frozen=type(IsEntityPositionFrozen)=='function' and IsEntityPositionFrozen(ped) or false}
end
function Menu.Helpers.RestoreShootCarOrigin(saved)
    if not saved or PlayerPedId()~=saved.ped or not DoesEntityExist(saved.ped) then return false end
    local ped=saved.ped
    local deadline=GetGameTimer()+650
    repeat
        if PlayerPedId()~=ped or not DoesEntityExist(ped) then return false end
        local current=GetVehiclePedIsIn(ped,false)
        local seatAvailable=saved.vehicle~=0 and DoesEntityExist(saved.vehicle) and saved.seat~=nil
            and (GetPedInVehicleSeat(saved.vehicle,saved.seat)==ped or IsVehicleSeatFree(saved.vehicle,saved.seat))
        if not seatAvailable and current==0 and #(GetEntityCoords(ped)-saved.coords)<1.0 then
            FreezeEntityPosition(ped,saved.frozen);return true
        end
        if seatAvailable then
            if GetPedInVehicleSeat(saved.vehicle,saved.seat)==ped then
                FreezeEntityPosition(ped,saved.frozen);return true
            end
            SetPedIntoVehicle(ped,saved.vehicle,saved.seat)
        else
            if current~=0 then TaskLeaveVehicle(ped,current,16);ClearPedTasksImmediately(ped) end
            RequestCollisionAtCoord(saved.coords.x,saved.coords.y,saved.coords.z)
            SetEntityCoordsNoOffset(ped,saved.coords.x,saved.coords.y,saved.coords.z,false,false,true)
            SetEntityHeading(ped,saved.heading)
        end
        Wait(0)
        if seatAvailable and GetPedInVehicleSeat(saved.vehicle,saved.seat)==ped then
            FreezeEntityPosition(ped,saved.frozen);return true
        elseif not seatAvailable and GetVehiclePedIsIn(ped,false)==0
            and #(GetEntityCoords(ped)-saved.coords)<1.0 then
            FreezeEntityPosition(ped,saved.frozen);return true
        end
    until GetGameTimer()>=deadline
    return false
end

-- Prise de controle par un passage confirme dans un siege libre.
function Menu.Helpers.AcquireEffectVehicleByWarp(vehicle,continue,timing)
    timing=timing or {}
    local seatMs=timing.seatMs or 300
    local stableMs=timing.stableMs or 150
    local timeoutMs=timing.timeoutMs or 1800
    local pollMs=timing.pollMs or 25
    local leaveMs=timing.leaveMs or 900
    local leavePollMs=timing.leavePollMs or 25
    if _G._effectVehicleWarpBusy then return false,'busy' end
    if not Menu.Helpers.CanUseEffectVehicle(vehicle) then return false,'ineligible' end
    _G._effectVehicleWarpBusy=true
    local player=PlayerPedId()
    local origin=GetEntityCoords(player)
    local heading=GetEntityHeading(player)
    local originalVehicle=GetVehiclePedIsIn(player,false)
    local originalSeat
    if originalVehicle~=0 then
        for seat=-1,GetVehicleMaxNumberOfPassengers(originalVehicle)-1 do
            if GetPedInVehicleSeat(originalVehicle,seat)==player then originalSeat=seat;break end
        end
    end
    local wasFrozen=type(IsEntityPositionFrozen)=='function' and IsEntityPositionFrozen(player) or false
    local acquired=false
    local function leave()
        local v=GetVehiclePedIsIn(player,false)
        if v==0 then return true end
        TaskLeaveVehicle(player,v,16)
        local start=GetGameTimer()
        while GetVehiclePedIsIn(player,false)==v do
            if PlayerPedId()~=player or not DoesEntityExist(player) then return false end
            if GetGameTimer()-start>=leaveMs then return false end
            Wait(leavePollMs)
        end
        return true
    end
    local ok,err=pcall(function()
        local seat
        for s=-1,GetVehicleMaxNumberOfPassengers(vehicle)-1 do
            if IsVehicleSeatFree(vehicle,s) then seat=s;break end
        end
        if seat==nil or not leave() then return end
        FreezeEntityPosition(player,false)
        local coords=GetEntityCoords(vehicle)
        RequestCollisionAtCoord(coords.x,coords.y,coords.z)
        SetPedIntoVehicle(player,vehicle,seat)
        local started,confirmed=GetGameTimer(),nil
        repeat
            if not DoesEntityExist(vehicle) or PlayerPedId()~=player or IsEntityDead(player) then return end
            if continue and not continue() then return end
            if IsPedInVehicle(player,vehicle,false) and GetPedInVehicleSeat(vehicle,seat)==player then
                if NetworkGetEntityIsNetworked(vehicle) then NetworkRequestControlOfEntity(vehicle) end
                if not NetworkGetEntityIsNetworked(vehicle) or NetworkHasControlOfEntity(vehicle) then
                    confirmed=confirmed or GetGameTimer()
                    -- Magneto garde ses delais ; Rain fournit ses delais courts.
                    if GetGameTimer()-started>=seatMs and GetGameTimer()-confirmed>=stableMs then acquired=true;break end
                else confirmed=nil end
            else confirmed=nil end
            Wait(pollMs)
        until GetGameTimer()-started>=timeoutMs
    end)
    local restored,restoreErr=pcall(function()
        if timing.returnOrigin then return Menu.Helpers.RestoreShootCarOrigin(timing.returnOrigin) end
        if PlayerPedId()~=player or not DoesEntityExist(player) then return false end
        if not leave() then return false end
        if originalVehicle~=0 and DoesEntityExist(originalVehicle) and originalSeat~=nil and IsVehicleSeatFree(originalVehicle,originalSeat) then
            SetPedIntoVehicle(player,originalVehicle,originalSeat)
        else
            SetEntityCoordsNoOffset(player,origin.x,origin.y,origin.z,false,false,false)
            SetEntityHeading(player,heading)
        end
        FreezeEntityPosition(player,wasFrozen)
        return true
    end)
    _G._effectVehicleWarpBusy=false
    if not ok then print('[ VEHICLE ACQUIRE ] '..tostring(err)) end
    if not restored then print('[ VEHICLE ACQUIRE ] Retour : '..tostring(restoreErr)) end
    return ok and restored and restoreErr==true and acquired
end


-- Shoot Car accepte uniquement les vehicules synchronises avec un ID reseau valide.
function Menu.Helpers.IsNetworkShootVehicle(vehicle)
    if not vehicle or vehicle==0 or not DoesEntityExist(vehicle) then return false end
    if type(IsEntityAVehicle)=='function' and not IsEntityAVehicle(vehicle) then return false end
    if not NetworkGetEntityIsNetworked(vehicle) then return false end
    local id=NetworkGetNetworkIdFromEntity(vehicle)
    if not id or id==0 then return false end
    if type(NetworkDoesNetworkIdExist)=='function' and not NetworkDoesNetworkIdExist(id) then return false end
    return true
end

