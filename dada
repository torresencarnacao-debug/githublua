    ShowDynastyNotification("[ SPINBOT ] " .. (Menu.State.spinbotActive and "ON" or "OFF"))
    if Menu.State.spinbotActive then
        if not Menu.State._spinbotThread then
            Citizen.CreateThread(function()
                Menu.State._spinbotThread = true
                local heading = 0.0
                while Menu.State.spinbotActive do
                    local ped = PlayerPedId()
                    if DoesEntityExist(ped) and not IsPedInAnyVehicle(ped, false) and not IsPedDeadOrDying(ped, true) then
                        heading = (heading + 15.0) % 360.0
                        pcall(SetEntityHeading, ped, heading)

                        -- Gestion des déplacements ZQSD / WASD relatifs à la caméra
                        local fwd = IsControlPressed(0, 32) or IsControlPressed(0, 71)    -- W / Up
                        local bwd = IsControlPressed(0, 33) or IsControlPressed(0, 72)    -- S / Down
                        local lft = IsControlPressed(0, 34) or IsControlPressed(0, 63)    -- A / Left
                        local rgt = IsControlPressed(0, 35) or IsControlPressed(0, 64)    -- D / Right

                        if fwd or bwd or lft or rgt then
                            local camRot = GetGameplayCamRot(2)
                            if camRot and type(camRot) == "vector3" then
                                local rad = math.rad(camRot.z or 0.0)
                                local camFwdX, camFwdY = -math.sin(rad), math.cos(rad)
                                local camRgtX, camRgtY = math.cos(rad), math.sin(rad)

                                local moveX, moveY = 0.0, 0.0
                                if fwd then moveX = moveX + camFwdX; moveY = moveY + camFwdY end
                                if bwd then moveX = moveX - camFwdX; moveY = moveY - camFwdY end
                                if rgt then moveX = moveX + camRgtX; moveY = moveY + camRgtY end
                                if lft then moveX = moveX - camRgtX; moveY = moveY - camRgtY end

                                if moveX ~= 0.0 or moveY ~= 0.0 then
                                    local speed = (IsControlPressed(0, 21) and 7.0 or 3.5)
                                    local curVel = GetEntityVelocity(ped)
                                    local curZ = (curVel and type(curVel) == "vector3") and curVel.z or 0.0
                                    pcall(SetEntityVelocity, ped, moveX * speed, moveY * speed, curZ)
                                end
                            end
                        end
                    end
                    Wait(20)
                end
                Menu.State._spinbotThread = false
            end)
        end
    end
end
