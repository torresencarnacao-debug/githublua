        if Menu.State.superPunchActive then
            local ped = PlayerPedId()
            if DoesEntityExist(ped) and not IsPedInAnyVehicle(ped, false) then
                local isAttacking = IsPedDoingMeleeAction(ped) 
                    or IsPedInMeleeCombat(ped) 
                    or IsControlJustPressed(0, 24) 
                    or IsDisabledControlJustPressed(0, 24) 
                    or (IsControlPressed(0, 24) and not IsPedArmed(ped, 4))

                if isAttacking then
                    local now = GetGameTimer()
                    if now - lastPunchTime > 120 then
                        local pCoords = GetEntityCoords(ped)
                        local pFwd    = GetEntityForwardVector(ped)
                        local targetPos = pCoords + (pFwd * 5.0)

                        -- 1. Raycast direct devant le ped
                        local ray = StartExpensiveSynchronousShapeTestLosProbe(
                            pCoords.x, pCoords.y, pCoords.z + 0.5,
                            targetPos.x, targetPos.y, targetPos.z + 0.5,
                            10, ped, 7
                        )
                        local _, hit, hitCoords, _, entityHit = GetShapeTestResult(ray)

                        local targetVeh = nil
                        if hit == 1 and entityHit and DoesEntityExist(entityHit) and IsEntityAVehicle(entityHit) then
                            targetVeh = entityHit
                        else
                            -- 2. Recherche du véhicule le plus proche dans l'axe d'attaque
                            local closest = GetClosestVehicle(pCoords.x + pFwd.x * 2.5, pCoords.y + pFwd.y * 2.5, pCoords.z, 5.0, 0, 70)
                            if closest and closest ~= 0 and DoesEntityExist(closest) and IsEntityAVehicle(closest) then
                                targetVeh = closest
                            else
                                -- 3. Détection des dégâts récents par le ped
                                for _, v in ipairs(GetGamePool("CVehicle")) do
                                    if DoesEntityExist(v) and HasEntityBeenDamagedByEntity(v, ped) then
                                        ClearEntityLastDamageEntity(v)
                                        ClearEntityLastWeaponDamage(v)
                                        targetVeh = v
                                        break
                                    end
                                end
                            end
                        end

                        if targetVeh and DoesEntityExist(targetVeh) then
                            lastPunchTime = now
                            if NetworkGetEntityIsNetworked(targetVeh) then NetworkRequestControlOfEntity(targetVeh) end
                            SetEntityAsMissionEntity(targetVeh, true, true)
                            SetEntityCollision(targetVeh, true, true)
                            SetEntityDynamic(targetVeh, true)
                            ActivatePhysics(targetVeh)

                            -- Projection ultra-puissante (Éjection véhicule)
                            SetEntityVelocity(targetVeh, pFwd.x * 160.0, pFwd.y * 160.0, 45.0)
                            ApplyForceToEntity(targetVeh, 1, pFwd.x * 380.0, pFwd.y * 380.0, 110.0, 0.0, 0.0, 0.0, 0, false, true, true, false, true)
                        end
                    end
                end
            end
        end
    end
end)

