do
    local running=false
    function Menu.Actions.ActionRainVehicle()
        if running then ShowDynastyNotification('[ RAIN ] Operation deja en cours'); return end
        if not selectedPlayer then ShowDynastyNotification('[ RAIN ] Selectionne un joueur');return end
        local targetId,targetServer=selectedPlayer.id,selectedPlayer.serverId
        local function target()
            local id=targetServer and GetPlayerFromServerId(targetServer) or targetId
            if not id or id==-1 or not NetworkIsPlayerActive(id) then return nil end
            local p=GetPlayerPed(id)
            if p==0 or not DoesEntityExist(p) or IsEntityDead(p) then return nil end
            return p
        end
        if not target() then ShowDynastyNotification('[ RAIN ] Cible indisponible');return end
        running=true
        CreateThread(function()
            local player=PlayerPedId()
            local saved=GetEntityCoords(player)
            local heading=GetEntityHeading(player)
            local previous=GetVehiclePedIsIn(player,false)
            local previousSeat
            if previous~=0 then
                for s=-1,GetVehicleMaxNumberOfPassengers(previous)-1 do
                    if GetPedInVehicleSeat(previous,s)==player then previousSeat=s;break end
                end
            end
            local function leave()
                local currentVehicle=GetVehiclePedIsIn(player,false)
                if currentVehicle==0 then return true end
                TaskLeaveVehicle(player,currentVehicle,16)
                local deadline=GetGameTimer()+450
                repeat
                    if not DoesEntityExist(player) or PlayerPedId()~=player then return false end
                    if not IsPedInVehicle(player,currentVehicle,false) then return true end
                    Wait(0)
                until GetGameTimer()>=deadline
                return false
            end
            local function restore()
                if not DoesEntityExist(player) or PlayerPedId()~=player then return false end
                if not leave() then return false end
                if previous~=0 and DoesEntityExist(previous) and previousSeat~=nil and IsVehicleSeatFree(previous,previousSeat) then
                    SetPedIntoVehicle(player,previous,previousSeat)
                else
                    SetEntityCoordsNoOffset(player,saved.x,saved.y,saved.z,false,false,false)
                    SetEntityHeading(player,heading)
                end
                return true
            end
            local launched,refused=0,0
            local ok,err=pcall(function()
                local vehicles={}
                for _,v in ipairs(GetGamePool('CVehicle')) do
                    if Menu.Helpers.CanUseEffectVehicle(v) then
                        local distance=#(GetEntityCoords(v)-saved)
                        local class=GetVehicleClass(v)
                        if distance<=300 and class~=14 and class~=15 and class~=16 and class~=21 then
                            vehicles[#vehicles+1]={v=v,d=distance}
                        end
                    end
                end
                table.sort(vehicles,function(a,b)return a.d<b.d end)
                ShowDynastyNotification(('[ RAIN ] %d voitures : prise et lancement directs'):format(#vehicles))
                for i,item in ipairs(vehicles) do
                    if not target() or PlayerPedId()~=player or IsEntityDead(player) then return end
                    local v=item.v
                    while _G._effectVehicleWarpBusy do
                        if not target() or PlayerPedId()~=player or IsEntityDead(player) then return end
                        Wait(0)
                    end
                    local acquired=Menu.Helpers.AcquireEffectVehicleByWarp(v,function()
                        return target()~=nil and PlayerPedId()==player and not IsEntityDead(player)
                    end,{seatMs=0,stableMs=0,timeoutMs=350,pollMs=0})
                    if not restore() then
                        ShowDynastyNotification('[ RAIN ] Sortie du vehicule refusee : arret')
                        return
                    end
                    local t=target()
                    if not t then return end
                    -- Aucun stockage : la voiture part immediatement apres sa prise.
                    if acquired and Menu.Helpers.CanUseEffectVehicle(v)
                        and (not NetworkGetEntityIsNetworked(v) or NetworkHasControlOfEntity(v)) then
                        local position=GetEntityCoords(t);local motion=GetEntityVelocity(t)
                        local height=32.0
                        local angle=i*2.399963;local spread=1.5
                        local x=position.x+motion.x*.85+math.cos(angle)*spread
                        local y=position.y+motion.y*.85+math.sin(angle)*spread
                        FreezeEntityPosition(v,false)
                        SetEntityHasGravity(v,true)
                        SetEntityDynamic(v,true)
                        RequestCollisionAtCoord(x,y,position.z)
                        SetEntityCoordsNoOffset(v,x,y,position.z+height,false,false,false)
                        SetEntityAngularVelocity(v,0.0,0.0,0.0)
                        SetEntityVelocity(v,motion.x*.5,motion.y*.5,-38.0)
                        launched=launched+1
                        Wait(40)
                    else refused=refused+1 end
                end
            end)
            local restored,restoreErr=pcall(restore)
            running=false
            if not restored then print('[ RAIN ] Retour : '..tostring(restoreErr)) end
            if not ok then print('[ RAIN ] '..tostring(err));ShowDynastyNotification('[ RAIN ] Erreur : voir F8')
            else ShowDynastyNotification(('[ RAIN ] %d lances / %d refuses'):format(launched,refused)) end
        end)
    end
end

function Menu.Actions.ActionDropVehicle()
    if not selectedPlayer then
        ShowDynastyNotification("[ ERREUR ] Aucun joueur")
        return
    end

    local targetPlayerId = selectedPlayer.id
    local targetPed = GetPlayerPed(targetPlayerId)

    if not DoesEntityExist(targetPed) then
        ShowDynastyNotification("[ ERREUR ] Cible introuvable")
        return
    end

    CreateThread(function()
        local playerPed = PlayerPedId()
        local myCoords = GetEntityCoords(playerPed)

        local closestVeh = GetClosestVehicle(myCoords.x, myCoords.y, myCoords.z, 100.0, 0, 70)
        if not closestVeh or closestVeh == 0 then
            ShowDynastyNotification("[ ERREUR ] Aucun vehicule")
            return
        end

        SetPedIntoVehicle(playerPed, closestVeh, -1)
        Wait(150)

        SetEntityAsMissionEntity(closestVeh, true, true)
        if NetworkGetEntityIsNetworked(closestVeh) then
            NetworkRequestControlOfEntity(closestVeh)
        end

        TaskLeaveVehicle(playerPed, closestVeh, 0)
        Wait(150)

        SetEntityCoordsNoOffset(playerPed, myCoords.x, myCoords.y, myCoords.z, false, false, false)
        Wait(100)

        local targetCoords = GetEntityCoords(targetPed)
        SetEntityCoordsNoOffset(closestVeh, targetCoords.x, targetCoords.y, targetCoords.z + 15.0, false, false, false)
        SetEntityRotation(closestVeh, 0.0, -90.0, 0.0, 2, true)
        SetEntityVelocity(closestVeh, 0.0, 0.0, -40.0)
        ShowDynastyNotification("[ FALL ] OK")
    end)
end

function Menu.Actions.ToggleBlackHole()
    Menu.State.blackHoleActive = not Menu.State.blackHoleActive

    if not Menu.State.blackHoleActive then
        if _G.black_hole_active then
            _G.black_hole_active = false
            _G.black_hole_vehicles = {}
            _G.black_hole_target_player = nil
        end
        ShowDynastyNotification("[ BLACK HOLE ] OFF")
        return
    end

    if not selectedPlayer then
        Menu.State.blackHoleActive = false
        ShowDynastyNotification("[ ERREUR ] Aucun joueur")
        return
    end

    local targetPlayerId = selectedPlayer.id
    local targetPed = GetPlayerPed(targetPlayerId)

    if not DoesEntityExist(targetPed) then
        Menu.State.blackHoleActive = false
        ShowDynastyNotification("[ ERREUR ] Cible introuvable")
        return
    end

    CreateThread(function()
        if not _G.black_hole_active then
            _G.black_hole_active = true
            _G.black_hole_vehicles = {}
            _G.black_hole_target_player = targetPlayerId

            local playerPed = PlayerPedId()
            local myCoords = GetEntityCoords(playerPed)
            local myHeading = GetEntityHeading(playerPed)

            local blackHoleCam = CreateCam('DEFAULT_SCRIPTED_CAMERA', true)
            local camCoords = GetGameplayCamCoord()
            local camRot = GetGameplayCamRot(2)
            SetCamCoord(blackHoleCam, camCoords.x, camCoords.y, camCoords.z)
            SetCamRot(blackHoleCam, camRot.x, camRot.y, camRot.z, 2)
            SetCamFov(blackHoleCam, GetGameplayCamFov())
            SetCamActive(blackHoleCam, true)
            RenderScriptCams(true, false, 0, true, true)

            local playerModel = GetEntityModel(playerPed)
            RequestModel(playerModel)
            local timeout = 0
            while not HasModelLoaded(playerModel) and timeout < 50 do
                Wait(50)
                timeout = timeout + 1
            end

            local groundZ = myCoords.z
            local rayHandle = StartShapeTestRay(myCoords.x, myCoords.y, myCoords.z + 2.0, myCoords.x, myCoords.y, myCoords.z - 100.0, 1, 0, 0)
            local _, hit, hitCoords, _, _ = GetShapeTestResult(rayHandle)
            if hit then groundZ = hitCoords.z end

            local clonePed = CreatePed(4, playerModel, myCoords.x, myCoords.y, groundZ, myHeading, false, false)
            SetEntityCollision(clonePed, false, false)
            FreezeEntityPosition(clonePed, true)
            SetEntityInvincible(clonePed, true)
            SetBlockingOfNonTemporaryEvents(clonePed, true)
            SetPedCanRagdoll(clonePed, false)
            ClonePedToTarget(playerPed, clonePed)
            SetEntityVisible(playerPed, true, false)

            local emptyVehicles = {}
            local searchRadius = 1000.0
            local vehHandle, veh = FindFirstVehicle()
            local success

            repeat
                if veh and veh ~= 0 and DoesEntityExist(veh) then -- safety: skip invalid/null vehicle handles
                    local vehCoords = GetEntityCoords(veh)
                    local distance = #(myCoords - vehCoords)
                    local vehClass = GetVehicleClass(veh)
                    local driver = GetPedInVehicleSeat(veh, -1)
                    local isEmpty = (driver == 0 or not DoesEntityExist(driver))

                    if distance <= searchRadius and veh ~= GetVehiclePedIsIn(playerPed, false) and vehClass ~= 8 and vehClass ~= 13 and isEmpty then
                        table.insert(emptyVehicles, {handle = veh, distance = distance})
                    end
                end

                success, veh = FindNextVehicle(vehHandle)
            until not success

            EndFindVehicle(vehHandle)

            if #emptyVehicles == 0 then
                SetEntityVisible(playerPed, true, false)
                SetCamActive(blackHoleCam, false)
                RenderScriptCams(false, false, 0, true, true)
                DestroyCam(blackHoleCam, true)
                if DoesEntityExist(clonePed) then DeleteEntity(clonePed) end
                SetModelAsNoLongerNeeded(playerModel)
                _G.black_hole_active = false
                Menu.State.blackHoleActive = false
                ShowDynastyNotification("[ ERREUR ] Aucun vehicule")
                return
            end

            table.sort(emptyVehicles, function(a, b) return a.distance < b.distance end)
            while #emptyVehicles > 6 do table.remove(emptyVehicles) end

            for i, vehData in ipairs(emptyVehicles) do
                local veh = vehData.handle
                if DoesEntityExist(veh) and _G.black_hole_active then
                    SetPedIntoVehicle(playerPed, veh, -1)
                    Wait(150)
                    SetEntityAsMissionEntity(veh, true, true)
                    if NetworkGetEntityIsNetworked(veh) then
                        NetworkRequestControlOfEntity(veh)
                        local t = 0
                        while not NetworkHasControlOfEntity(veh) and t < 50 do
                            NetworkRequestControlOfEntity(veh)
                            Wait(10)
                            t = t + 1
                        end
                    end
                    SetEntityCoordsNoOffset(playerPed, myCoords.x, myCoords.y, myCoords.z, false, false, false)
                    SetEntityHeading(playerPed, myHeading)

                    local tCoords = GetEntityCoords(targetPed)
                    local angle = math.atan2(tCoords.y - myCoords.y, tCoords.x - myCoords.x)
                    local spawnX = tCoords.x - math.cos(angle) * 50.0
                    local spawnY = tCoords.y - math.sin(angle) * 50.0

                    SetEntityCoordsNoOffset(veh, spawnX, spawnY, tCoords.z, false, false, false)
                    SetEntityHeading(veh, math.deg(angle))
                    SetEntityVelocity(veh, math.cos(angle) * 50.0, math.sin(angle) * 50.0, 0.0)
                    table.insert(_G.black_hole_vehicles, veh)
                end
            end

            SetEntityVisible(playerPed, true, false)
            SetCamActive(blackHoleCam, false)
            RenderScriptCams(false, false, 0, true, true)
            DestroyCam(blackHoleCam, true)
            if DoesEntityExist(clonePed) then DeleteEntity(clonePed) end
            SetModelAsNoLongerNeeded(playerModel)

            ShowDynastyNotification("[ BLACK HOLE ] " .. #_G.black_hole_vehicles .. " veh")

            CreateThread(function()
                while _G.black_hole_active and Menu.State.blackHoleActive do
                    Wait(50) -- BUG FIX: Was Wait(0)  caused severe frame drops when multiple vehicles active
                    if not _G.black_hole_target_player then break end
                    local tPed = GetPlayerPed(_G.black_hole_target_player)
                    if DoesEntityExist(tPed) then
                        local tCoords = GetEntityCoords(tPed)
                        for _, veh in ipairs(_G.black_hole_vehicles) do
                            if DoesEntityExist(veh) then
                                local vCoords = GetEntityCoords(veh)
                                local dir = vector3(tCoords.x - vCoords.x, tCoords.y - vCoords.y, tCoords.z - vCoords.z)
                                local dist = #dir
                                if dist > 0.1 then
                                    dir = dir / dist
                                    SetEntityVelocity(veh, dir.x * 30.0, dir.y * 30.0, dir.z * 5.0)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end)
end


