        if not _W90 or _W90.PlayerData ~= s.data or PlayerPedId() ~= s.ped
            or not DoesEntityExist(s.ped) or IsEntityDead(s.ped) then
            stop('contexte_change'); return
        end
        local pd, now = s.data, GetGameTimer()
        if s.accepted and (pd.invincibleType ~= s.marker or pd.invincibleServer ~= true) then
