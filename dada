function Menu.Actions.UpdateSitPose()
    if not Menu.State.sitOnVehicleActive then return end
    local ped = PlayerPedId()
    local veh = Menu.State.sitOnVehicleHandle
    if not DoesEntityExist(ped) or not DoesEntityExist(veh) then return end

    local poseIdx = Menu.State.sitPoseIdx or 1
    local pose = _G.SitVehiclePoses[poseIdx] or _G.SitVehiclePoses[1]

    RequestAnimDict(pose.dict)
    local t0 = GetGameTimer()
    while not HasAnimDictLoaded(pose.dict) and (GetGameTimer() - t0) < 1000 do Wait(20) end

    local vehModel = GetEntityModel(veh)
    local minDim, maxDim = GetModelDimensions(vehModel)
    local baseRoofZ = (maxDim and maxDim.z or 1.5)
    local targetZ = baseRoofZ + (pose.offsetZ or 0.0)

    ClearPedTasksImmediately(ped)
    if HasAnimDictLoaded(pose.dict) then
        TaskPlayAnim(ped, pose.dict, pose.anim, 8.0, -8.0, -1, pose.flag or 1, 0.0, false, false, false)
    end

    AttachEntityToEntity(ped, veh, 0, pose.offsetX or 0.0, pose.offsetY or 0.0, targetZ, pose.rotX or 0.0, pose.rotY or 0.0, pose.rotZ or 0.0, false, false, false, false, 2, true)
end

function Menu.Actions.ToggleSitOnVehicle()
    Menu.State.sitOnVehicleActive = not Menu.State.sitOnVehicleActive

    if Menu.State.sitOnVehicleActive then
        local ped = PlayerPedId()
        local veh = Menu.Helpers.GetSelectedVehicleHandle()
        if not veh or not DoesEntityExist(veh) then
            ShowDynastyNotification("[ SIT ] Aucun vehicule")
            Menu.State.sitOnVehicleActive = false
            return
        end

        -- Prise de contrôle réseau
        if NetworkGetEntityIsNetworked(veh) then
            local t = GetGameTimer()
            NetworkRequestControlOfEntity(veh)
            while not NetworkHasControlOfEntity(veh) and GetGameTimer() - t < 1500 do
                Wait(40)
                NetworkRequestControlOfEntity(veh)
            end
        end
        SetEntityAsMissionEntity(veh, true, false)
        Menu.State.sitOnVehicleHandle = veh

        -- Sortir du véhicule si dedans
        if IsPedInVehicle(ped, veh, false) then
            local right = GetOffsetFromEntityInWorldCoords(veh, 2.0, 0.0, 0.5)
            SetEntityCoordsNoOffset(ped, right.x, right.y, right.z, false, false, false)
            Wait(100)
        end

        -- Appliquer la pose sélectionnée
        Menu.Actions.UpdateSitPose()

        -- Thread de surveillance sécurisé (Anti-Crash : vérifie l'existence des entités sans fuite mémoire)
        CreateThread(function()
            while Menu.State.sitOnVehicleActive do
                Wait(150)
                local currentPed = PlayerPedId()
                local currentVeh = Menu.State.sitOnVehicleHandle

                -- Si le véhicule ou le joueur est détruit/supprimé, cleanup propre sans crash
                if not DoesEntityExist(currentPed) or not DoesEntityExist(currentVeh) or IsEntityDead(currentVeh) or IsPedDeadOrDying(currentPed, true) then
                    Menu.State.sitOnVehicleActive = false
                    if DoesEntityExist(currentPed) and IsEntityAttached(currentPed) then
                        DetachEntity(currentPed, true, true)
                        ClearPedTasks(currentPed)
                    end
                    Menu.State.sitOnVehicleHandle = nil
                    ShowDynastyNotification("[ SIT ] Vehicule perdu")
                    break
                end

                -- Maintien de l'animation si interrompue
                local poseIdx = Menu.State.sitPoseIdx or 1
                local pose = _G.SitVehiclePoses[poseIdx] or _G.SitVehiclePoses[1]
                if pose and HasAnimDictLoaded(pose.dict) then
                    if not IsEntityPlayingAnim(currentPed, pose.dict, pose.anim, 3) then
                        TaskPlayAnim(currentPed, pose.dict, pose.anim, 8.0, -8.0, -1, pose.flag or 1, 0.0, false, false, false)
                    end
                end
            end
        end)

        local poseName = (_G.SitVehiclePoses[Menu.State.sitPoseIdx or 1] and _G.SitVehiclePoses[Menu.State.sitPoseIdx or 1].name) or "Meditation"
        ShowDynastyNotification("[ SIT ] ON (" .. poseName .. ")")
    else
        -- Détachement et nettoyage propre
        local ped = PlayerPedId()
        if DoesEntityExist(ped) and IsEntityAttached(ped) then
            DetachEntity(ped, true, true)
            ClearPedTasks(ped)
        end
        Menu.State.sitOnVehicleHandle = nil
        ShowDynastyNotification("[ SIT ] OFF")
    end
end

