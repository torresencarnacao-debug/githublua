-- Rocket / Roadster : controleur unique, integration en secondes et effets locaux.
do
    local activeMode, generation, current = nil, 0, nil
    local tune = {
        rocket = {cruise=25.0, boost=48.0, accel=10.0, lift=5.0, yaw=65.0},
        roadster = {topSpeed=112.0, accel=14.0, boostAccel=30.0, lift=16.0}
    }
    local function clamp(v, lo, hi) return math.max(lo, math.min(hi, v)) end
    local function smooth(a, b, rate, dt) return a + (b-a) * (1.0-math.exp(-rate*dt)) end
    local function held(key) return IsControlPressed(0,key) or IsDisabledControlPressed(0,key) end
    local function pressed(key) return IsControlJustPressed(0,key) or IsDisabledControlJustPressed(0,key) end
    local function stopJets(c, tag)
        for i=#c.fx,1,-1 do
            local fx=c.fx[i]
            if not tag or fx.tag==tag then StopParticleFxLooped(fx.h,false); table.remove(c.fx,i) end
        end
    end
    local function jets(c, tag, on)
        if not on then stopJets(c,tag); return end
        for _,fx in ipairs(c.fx) do if fx.tag==tag then return end end
        if not HasNamedPtfxAssetLoaded('core') then RequestNamedPtfxAsset('core'); return end
        local low,high=GetModelDimensions(GetEntityModel(c.veh))
        local points
        if tag=='bottom' then
            points={{low.x*.65,high.y*.45,low.z-.06,180.0,1.15},
                {high.x*.65,high.y*.45,low.z-.06,180.0,1.15},
                {low.x*.65,low.y*.45,low.z-.06,180.0,1.15},
                {high.x*.65,low.y*.45,low.z-.06,180.0,1.15}}
        elseif tag=='rocket' then
            points={{low.x*.50,low.y-.15,low.z+.35,90.0,1.15},
                {high.x*.50,low.y-.15,low.z+.35,90.0,1.15}}
        else
            -- Double jet : noyau dense et panache plus large d'air comprime.
            points={{low.x*.50,low.y-.12,low.z+.30,90.0,1.35},
                {high.x*.50,low.y-.12,low.z+.30,90.0,1.35},
                {low.x*.50,low.y-.25,low.z+.30,90.0,.80},
                {high.x*.50,low.y-.25,low.z+.30,90.0,.80}}
        end
        for _,p in ipairs(points) do
            UseParticleFxAssetNextCall('core')
            local effect=tag=='rocket' and 'veh_rocket_boost' or 'ent_sht_steam'
            -- Variante NON NETWORKED : flammes et air visibles seulement sur ce client.
            local h=StartParticleFxLoopedOnEntity(effect,c.veh,p[1],p[2],p[3],p[4],0.0,0.0,p[5],false,false,false)
            if (not h or h==0) and tag=='rocket' then
                UseParticleFxAssetNextCall('core')
                h=StartParticleFxLoopedOnEntity('ent_sht_flame',c.veh,p[1],p[2],p[3],p[4],0.0,0.0,p[5],false,false,false)
            end
            if h and h~=0 then
                c.fx[#c.fx+1]={h=h,tag=tag}
                if tag~='rocket' then
                    SetParticleFxLoopedColour(h,.85,.94,1.0,false)
                    SetParticleFxLoopedAlpha(h,.95)
                end
            end
        end
    end
    local function restore()
        local c=current
        if not c then return end
        stopJets(c)
        if DoesEntityExist(c.veh) then
            SetVehicleGravityAmount(c.veh,c.gravity)
            if type(SetVehicleWheelYRotation)=='function' then
                for i,value in pairs(c.wheels) do SetVehicleWheelYRotation(c.veh,i,value) end
            end
        end
        if DoesEntityExist(c.veh) and type(SetVehicleWheelXOffset)=='function' then
            for i,value in pairs(c.wheelOffsets) do SetVehicleWheelXOffset(c.veh,i,value) end
        end
        current=nil
    end
    local function capture(veh)
        local gravity=9.8
        if type(GetVehicleGravityAmount)=='function' then gravity=GetVehicleGravityAmount(veh) end
        local c={veh=veh,gravity=gravity,wheels={},wheelOffsets={},fx={},flight=false,fold=0.0,boostUntil=0,nextBoost=0}
        if type(GetVehicleWheelYRotation)=='function' and type(SetVehicleWheelYRotation)=='function' then
            local count=type(GetVehicleNumberOfWheels)=='function' and GetVehicleNumberOfWheels(veh) or 4
            -- La simulation Deluxo concerne les voitures a quatre roues.
            if count==4 then
                for i=0,3 do
                    c.wheels[i]=GetVehicleWheelYRotation(veh,i)
                    if type(GetVehicleWheelXOffset)=='function' and type(SetVehicleWheelXOffset)=='function' then
                        c.wheelOffsets[i]=GetVehicleWheelXOffset(veh,i)
                    end
                end
            end
        end
        return c
    end
    local function wheels(c, dt)
        c.fold=smooth(c.fold,c.flight and 1.0 or 0.0,5.0,dt)
        for i,value in pairs(c.wheels) do
            local side=(i%2==0) and 1.0 or -1.0
            SetVehicleWheelYRotation(c.veh,i,value+(side*0.92-value)*c.fold)
        end
        for i,value in pairs(c.wheelOffsets) do
            -- Rapprocher chaque roue de 20 % de sa distance laterale au centre.
            SetVehicleWheelXOffset(c.veh,i,value*(1.0-0.20*c.fold))
        end
    end
    local function orient(c,pitch,roll,yaw,dt)
        local r=GetEntityRotation(c.veh,2)
        SetEntityRotation(c.veh,smooth(r.x,pitch,4.0,dt),smooth(r.y,roll,4.0,dt),r.z+yaw*dt,2,true)
    end
    local function rocket(c, dt)
        local v=c.veh
        local up,down=held(22),held(36)
        local forward,brake=held(71),held(72)
        local steer=(held(63) and 1 or 0)-(held(64) and 1 or 0)
        if up then c.flight=true end
        -- En hover les roues ne touchent pas forcement : tester aussi la garde au sol.
        if c.flight and down and not up
            and (IsVehicleOnAllWheels(v) or GetEntityHeightAboveGround(v)<=1.25) then
            c.flight=false
            c.trick=nil
            c.fold=0.0
            for i,value in pairs(c.wheels) do SetVehicleWheelYRotation(v,i,value) end
            for i,value in pairs(c.wheelOffsets) do SetVehicleWheelXOffset(v,i,value) end
            local r=GetEntityRotation(v,2)
            SetEntityRotation(v,r.x,0.0,r.z,2,true)
            local velocity=GetEntityVelocity(v)
            SetEntityVelocity(v,velocity.x,velocity.y,math.min(velocity.z,0.0))
        end
        wheels(c,dt)
        if not c.flight then SetVehicleGravityAmount(v,c.gravity); jets(c,'rocket',false); c.trick=nil; return end
        DisableControlAction(0,75,true)
        DisableControlAction(0,76,true)
        SetVehicleGravityAmount(v,0.0)
        -- Les commandes sont lues avant blocage ; empecher le pilotage GTA de piquer
        -- le nez ou de pousser le moteur dans la direction inclinee de la caisse.
        for _,key in ipairs({59,60,61,62,63,64,71,72}) do DisableControlAction(0,key,true) end
        local vel=GetEntityVelocity(v)
        local rot=GetEntityRotation(v,2)
        local yaw=math.rad(rot.z)
        local fx,fy=-math.sin(yaw),math.cos(yaw)
        local along=vel.x*fx+vel.y*fy
        local lateral=vel.x*fy-vel.y*fx
        local boost=held(21)
        local cap=boost and tune.rocket.boost or tune.rocket.cruise
        local target=(forward or boost) and cap or (brake and (along>1.0 and 0.0 or -8.0) or 0.0)
        local accel=boost and 18.0 or tune.rocket.accel
        along=along+clamp(target-along,-accel*dt,accel*dt)
        lateral=smooth(lateral,0.0,2.8,dt)
        local vzTarget=up and tune.rocket.lift or (down and -4.0 or 0.0)
        -- Coussin d'air pres du sol, sans TP ni gel du vehicule.
        local height=GetEntityHeightAboveGround(v)
        if not down and height<1.2 then vzTarget=math.max(vzTarget,(1.2-height)*2.0) end
        local vz=smooth(vel.z,vzTarget,4.5,dt)
        if boost and not up and not down then
            local z=GetEntityCoords(v).z
            c.boostHeight=c.boostHeight or z
            vz=clamp((c.boostHeight-z)*3.0,-2.5,2.5)
        else
            c.boostHeight=nil
        end
        SetEntityVelocity(v,fx*along+fy*lateral,fy*along-fx*lateral,vz)
        -- E ne deploie jamais le vol : tonneau seulement lorsque le hover est actif.
        if pressed(38) and not c.trick then
            local axis,sign='roll',steer>0 and -1.0 or 1.0
            if steer==0 then
                if forward and not brake then axis,sign='pitch',-1.0
                elseif brake and not forward then axis,sign='pitch',1.0
                elseif math.abs(along)>1.0 then axis,sign='pitch',along>0 and -1.0 or 1.0 end
            end
            c.trick={elapsed=0.0,pitch=rot.x,yaw=rot.z,roll=rot.y,axis=axis,sign=sign}
        end
        if c.trick then
            local t=c.trick
            t.elapsed=t.elapsed+dt
            local phase=clamp(t.elapsed/0.85,0.0,1.0)
            local ease=phase*phase*(3.0-2.0*phase)
            local angle=t.sign*360.0*ease
            SetEntityRotation(v,t.pitch+(t.axis=='pitch' and angle or 0.0),
                t.roll+(t.axis=='roll' and angle or 0.0),t.yaw,2,true)
            if phase>=1.0 then
                SetEntityRotation(v,t.pitch,t.roll,t.yaw,2,true)
                c.trick=nil
            end
        else
            orient(c,boost and 0.0 or (forward and -6.0 or (brake and 7.0 or 0.0)),-steer*8.0,steer*tune.rocket.yaw,dt)
        end
        jets(c,'rocket',boost)
    end
    local function roadster(c,dt)
        local v=c.veh
        local up,down=held(22),held(36)
        local forward,brake=held(71),held(72)
        local steer=(held(63) and 1 or 0)-(held(64) and 1 or 0)
        local now=GetGameTimer()
        if (pressed(21) or pressed(38)) and now>=c.nextBoost then
            c.boostUntil=now+850; c.nextBoost=now+2400
        end
        local boost=now<c.boostUntil
        local ground=IsVehicleOnAllWheels(v)
        if up then c.flight=true elseif ground then c.flight=false end
        SetVehicleGravityAmount(v,c.gravity)
        local vel=GetEntityVelocity(v)
        local f=GetEntityForwardVector(v)
        local along=vel.x*f.x+vel.y*f.y+vel.z*f.z
        local vx,vy,vz=vel.x,vel.y,vel.z
        if ground and not up then
            -- Acceleration electrique progressive ; pas d'impulsion liee au framerate.
            local a=forward and tune.roadster.accel*(1.0-clamp(along/tune.roadster.topSpeed,0.0,.95)) or 0.0
            if boost then a=a+tune.roadster.boostAccel end
            if brake and along>0 then a=-math.min(22.0,along/dt) end
            if not forward and not brake and not boost and along>0 then a=-math.min(2.2,along/dt) end
            if along>=tune.roadster.topSpeed and a>0 then a=0 end
            vx=vx+f.x*a*dt; vy=vy+f.y*a*dt; vz=vz+f.z*a*dt
            -- Amortissement lateral, sans ecraser la suspension avec une gravite x3.
            local lateral=vx*f.y-vy*f.x
            local grip=1.0-math.exp(-3.5*dt)
            vx=vx-f.y*lateral*grip; vy=vy+f.x*lateral*grip
            SetEntityVelocity(v,vx,vy,vz)
        elseif c.flight then
            DisableControlAction(0,75,true)
            DisableControlAction(0,76,true)
            if up then vz=math.min(vz+(c.gravity+tune.roadster.lift)*dt,8.0) end
            if down then vz=math.max(vz-12.0*dt,-12.0) end
            local thrust=(forward and 8.0 or 0.0)+(boost and 24.0 or 0.0)
            local r=GetEntityRotation(v,2); local yaw=math.rad(r.z)
            local fx,fy=-math.sin(yaw),math.cos(yaw)
            local speed=math.sqrt(vx*vx+vy*vy)
            if speed<tune.roadster.topSpeed then vx=vx+fx*thrust*dt; vy=vy+fy*thrust*dt end
            if brake then vx=vx*math.exp(-2.5*dt); vy=vy*math.exp(-2.5*dt) end
            SetEntityVelocity(v,vx,vy,vz)
            orient(c,forward and -7.0 or 0.0,-steer*10.0,steer*75.0,dt)
        end
        jets(c,'bottom',up)
        jets(c,'rear',boost)
    end
    local function toggle(mode,enable)
        local flag=mode=='rocket' and 'rocketCarActive' or 'roadsterActive'
        if not enable and activeMode~=mode then Menu.State[flag]=false; return end
        if enable and activeMode==mode then Menu.State[flag]=true; return end
        generation=generation+1
        restore()
        Menu.State.rocketCarActive=false; Menu.State.roadsterActive=false
        activeMode=enable and mode or nil
        Menu.State[flag]=enable
        if not enable then ShowDynastyNotification('[ '..mode:upper()..' ] OFF'); return end
        RequestNamedPtfxAsset('core')
        local token=generation
        ShowDynastyNotification(mode=='rocket'
            and '[ ROCKET ] ESPACE=vol/monter | CTRL=descendre/atterrir | E=flip directionnel | SHIFT=boost'
            or '[ ROADSTER ] SHIFT/E=propulsion | ESPACE=poussee verticale | CTRL=descendre')
        CreateThread(function()
            local ok,err=pcall(function()
                while token==generation and Menu.State[flag] do
                    Wait(0)
                    if token~=generation or not Menu.State[flag] then break end
                    local ped=PlayerPedId(); local veh=GetVehiclePedIsIn(ped,false)
                    local valid=veh~=0 and DoesEntityExist(veh) and GetPedInVehicleSeat(veh,-1)==ped
                        and not IsEntityDead(ped) and not IsEntityDead(veh)
                    if not valid then
                        restore(); Wait(100)
                    else
                        if not current or current.veh~=veh then restore(); current=capture(veh) end
                        local dt=clamp(GetFrameTime(),0.001,0.05)
                        if mode=='rocket' then rocket(current,dt) else roadster(current,dt) end
                    end
                end
            end)
            if token==generation then
                restore(); activeMode=nil; Menu.State[flag]=false
                if not ok then print('[ VEHICLE MODE ] '..tostring(err)); ShowDynastyNotification('[ VEHICLE MODE ] Arrete : voir F8') end
            end
        end)
    end
    function Menu.Actions.ToggleRoadster(enable) toggle('roadster',enable) end
    function Menu.Actions.ToggleRocketCar(enable) toggle('rocket',enable) end
end


local throwCarriedVehicle = nil

function Menu.Actions.ToggleThrowVehicle()
    Menu.State.throwVehicleActive = not Menu.State.throwVehicleActive

    if not Menu.State.throwVehicleActive then
        if throwCarriedVehicle and DoesEntityExist(throwCarriedVehicle) then
            DetachEntity(throwCarriedVehicle, true, true)
            SetEntityCollision(throwCarriedVehicle, true, true)
            throwCarriedVehicle = nil
        end

        return
    end

    CreateThread(function()
        while Menu.State.throwVehicleActive do
            Wait(0)

            if not throwCarriedVehicle then
                BeginTextCommandDisplayHelp("STRING")
                AddTextComponentSubstringPlayerName("[E] Pick up vehicle")
                EndTextCommandDisplayHelp(0, false, true, -1)
            else
                BeginTextCommandDisplayHelp("STRING")
                AddTextComponentSubstringPlayerName("[E] Throw vehicle")
                EndTextCommandDisplayHelp(0, false, true, -1)
            end

            if IsControlJustPressed(0, 51) then
                local ped = PlayerPedId()
                if not ped or ped == 0 then
                    -- skip
                else

                if not throwCarriedVehicle then
                    local coords = GetEntityCoords(ped)
                    local closestVeh = nil
                    local closestDist = 10.0

                    for _, veh in ipairs(GetGamePool('CVehicle')) do
                        if DoesEntityExist(veh) then
                            local vehCoords = GetEntityCoords(veh)
                            local dist = #(coords - vehCoords)
                            if dist < closestDist then
                                closestDist = dist
                                closestVeh = veh
                            end
                        end
                    end

                    if closestVeh then
                        NetworkRequestControlOfEntity(closestVeh)
                        throwCarriedVehicle = closestVeh
                        AttachEntityToEntity(throwCarriedVehicle, ped, GetPedBoneIndex(ped, 28422), 0.0, 0.0, 2.0, 0.0, 0.0, 0.0, false, false, false, false, 2, true)
                        SetEntityCollision(throwCarriedVehicle, false, false)
                    end
                else
                    DetachEntity(throwCarriedVehicle, true, true)
                    local forward = GetEntityForwardVector(ped)
                    SetEntityVelocity(throwCarriedVehicle, forward.x * 70.0, forward.y * 70.0, 30.0)
                    ApplyForceToEntity(throwCarriedVehicle, 1, 0.0, 0.0, 0.0, math.random(-50, 50) + 0.0, math.random(-50, 50) + 0.0, math.random(-50, 50) + 0.0, 0, false, true, true, false, true)
                    SetEntityCollision(throwCarriedVehicle, true, true)

                    throwCarriedVehicle = nil
                end
                end -- ped guard
            end
        end

        if throwCarriedVehicle and DoesEntityExist(throwCarriedVehicle) then
            DetachEntity(throwCarriedVehicle, true, true)
            SetEntityCollision(throwCarriedVehicle, true, true)
            throwCarriedVehicle = nil
        end
    end)
end

local function LocalRotationToDirection(rotation)
    local rx = (math.pi / 180) * rotation.x
    local rz = (math.pi / 180) * rotation.z
    local dir = vector3(
        -math.sin(rz) * math.abs(math.cos(rx)),
