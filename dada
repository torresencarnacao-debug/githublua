-- ── RESOURCE MANAGER ────────────────────────────────────────────────────────
function Menu.Helpers.FetchResourceList()
    local now = GetGameTimer()
    -- Refresh toutes les 3 secondes max
    if Menu.State.resourceManagerList and (now - Menu.State.resourceManagerLastFetch) < 3000 then
        return Menu.State.resourceManagerList
    end
    Menu.State.resourceManagerLastFetch = now
    local list = {}
    if type(Susano) == "table" and type(Susano.InjectResource) == "function" then
        -- Récupère la liste via GetNumResources / GetResourceByFindIndex (client-side natifs disponibles)
        local count = GetNumResources()
        for i = 0, count - 1 do
            local ok, name = pcall(GetResourceByFindIndex, i)
            if ok and type(name) == "string" and name ~= "" then
                -- Sanitize strict : garde uniquement les caracteres ASCII imprimables (0x20-0x7E)
                -- Evite les ? et glyphs corrompus qui apparaissent avec certains noms de ressources
                local clean = name:gsub("[^\32-\126]", "")
                -- Filtre supplementaire : retire les caracteres de controle qui pourraient subsister
                clean = clean:match("^%s*(.-)%s*$") or clean -- trim
                if clean ~= "" and #clean >= 1 then
                    -- Validation : le nom doit contenir au moins une lettre ou chiffre
                    if clean:match("[%w%-_]") then
                        local state = GetResourceState(clean) or "unknown"
                        table.insert(list, { name = clean, state = state })
                    end
                end
            end
        end
    end
    -- Tri : running en premier, puis stopped, alphabétique dans chaque groupe
    table.sort(list, function(a, b)
        local aRun = (a.state == "started") and 0 or 1
        local bRun = (b.state == "started") and 0 or 1
        if aRun ~= bRun then return aRun < bRun end
        return a.name < b.name
    end)
    Menu.State.resourceManagerList = list
    return list
end

function Menu.Helpers.GetResourceManagerOptions()
