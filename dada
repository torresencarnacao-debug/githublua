            ShowDynastyNotification("[ CONFIG ] Executeur manquant")
            return
        end
        local cfg = {
            sidebarSide     = Menu.State.sidebarSide or "right",
            menuScale       = _G.menuScale or 1.0,
            themeIndex      = Menu.ThemeIndex or 1,
            bannerIndex     = Menu.BannerIndex or 1,
            freecam_layout  = _G.freecam_layout or 1,
            fullGodMode     = Menu.State.fullGodModeActive,
            semiGodMode     = Menu.State.semiGodModeActive,
            noWanted        = Menu.State.noWantedActive,
            noReload        = Menu.State.noReloadActive,
            infiniteAmmo    = Menu.State.infiniteAmmoActive,
            superJump       = Menu.State.superJumpActive,
            ragdollOff      = Menu.State.ragdollOffActive,
            playerInvisible = Menu.State.playerInvisible,
            shiftBoost      = Menu.State.shiftBoostActive,
            noclipInvisible    = Menu.State.noclipInvisible,
            noclipPose         = Menu.State.noclipPose,
            noclipSpeed        = Menu.State.noclipSpeed,
            slide              = Menu.State.slideActive,
            antiCollision      = Menu.State.antiCollisionActive,
            damageBoost        = Menu.State.damageBoostActive,
            rapidFire          = Menu.State.rapidFireActive,
            noClip             = Menu.State.noclipActive,
            highlighterSizeIdx = Menu.State.highlighterSizeIdx,
        }

        -- Inclure les binds dans la config
        local bindsStr = "{"
        if _G.UniversalKeyBinds then
            for k, v in pairs(_G.UniversalKeyBinds) do
                bindsStr = bindsStr .. string.format("[%d]={menu=%q,index=%d,label=%q,vk=%d},", k, v.menu or "", v.index or 0, v.label or "", v.vk or 0)
            end
        end
        bindsStr = bindsStr .. "}"
        cfg.binds = bindsStr

        -- Serialiser la config
        local str = "{"
        for k, v in pairs(cfg) do
            if type(v) == "string" then
                str = str .. string.format("[%q]=%q,", k, v)
            elseif type(v) == "boolean" then
                str = str .. string.format("[%q]=%s,", k, tostring(v))
            else
                str = str .. string.format("[%q]=%s,", k, tostring(v))
            end
        end
