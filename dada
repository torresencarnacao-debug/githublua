-- au-delÃ  de laquelle SetEntityVelocity peut crasher GTA sur certains serveurs.
-- La valeur de 150 m/s d'origine Ã©tait bien au-dessus de ce seuil.
local SHIFT_BOOST_MAX_SPEED = 80.0
local SHIFT_BOOST_ACCEL     = 6.0  -- m/s ajoutÃ©s par frame (~0 â†’ max en ~13 frames)

function Menu.Actions.ToggleShiftBoost(enable)
    -- Supporte: appel sans argument (toggle) OU avec true/false (force)
    if enable == nil then
        enable = not Menu.State.shiftBoostActive
    end
    shiftBoostActive = enable
    Menu.State.shiftBoostActive = enable

    if enable then
        -- Guard strict : si un thread tourne dÃ©jÃ , on ne crÃ©e pas un second
        if Menu.State._shiftBoostThread then return end
        ShowDynastyNotification("[ SHIFT BOOST ] ON")
        CreateThread(function()
            Menu.State._shiftBoostThread = true
            while shiftBoostActive and Menu.State.shiftBoostActive do
                Wait(0)
                pcall(function()
                    local ped = PlayerPedId()
                    if not ped or ped == 0 then return end
                    if not IsPedInAnyVehicle(ped, false) then return end
                    local veh = GetVehiclePedIsIn(ped, false)
                    if not veh or veh == 0 or not DoesEntityExist(veh) then return end
                    local shiftHeld = false
                    if Susano and Susano.GetAsyncKeyState then
                        shiftHeld = Susano.GetAsyncKeyState(0x10)
                    end
                    if not shiftHeld then
                        shiftHeld = IsControlPressed(0, 21) or IsDisabledControlPressed(0, 21)
                    end
                    if shiftHeld then
                        local fwd = GetEntityForwardVector(veh)
                        local vel = GetEntityVelocity(veh)
                        local curSpeed = math.sqrt(vel.x*vel.x + vel.y*vel.y)
                        local newSpeed = math.min(curSpeed + SHIFT_BOOST_ACCEL, SHIFT_BOOST_MAX_SPEED)
                        local clampedZ = math.max(-30.0, math.min(30.0, vel.z))
                        SetEntityVelocity(veh, fwd.x * newSpeed, fwd.y * newSpeed, clampedZ)
                    end
                end)
            end
            -- Nettoyage : on s'assure que les deux flags sont bien Ã  false
            shiftBoostActive = false
            Menu.State.shiftBoostActive = false
            Menu.State._shiftBoostThread = false
        end)
    else
        ShowDynastyNotification("[ SHIFT BOOST ] OFF")
    end
end

