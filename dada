-- Faire foncer un NPC dans le vehicule selectionne sur le joueur/vehicule le plus proche
function Menu.Actions.CrazyNPC()
    local veh = Menu.Helpers.GetSelectedVehicleHandle()
    if not veh then
        ShowDynastyNotification("[ CRAZY NPC ] Aucun vehicule")
        return
    end

    CreateThread(function()
        local playerPed      = PlayerPedId()
        local initialCoords  = GetEntityCoords(playerPed)
        local initialHeading = GetEntityHeading(playerPed)
        local vPos           = GetEntityCoords(veh)

        local function WaitNetControl(entity, timeoutMs)
            if not entity or not DoesEntityExist(entity) then return false end
            local t0 = GetGameTimer()
            while not NetworkHasControlOfEntity(entity) do
                NetworkRequestControlOfEntity(entity)
                Wait(10)
                if not DoesEntityExist(entity) then return false end
                if GetGameTimer() - t0 > (timeoutMs or 1000) then return false end
            end
            return true
        end

        local function GetClosestTarget(fromVeh)
            if not fromVeh or not DoesEntityExist(fromVeh) then return nil end
            local fromCoords = GetEntityCoords(fromVeh)
            local bestEnt    = nil
            local bestDist   = math.huge
            for i = 0, 31 do
                local p = GetPlayerPed(i)
                if p and p ~= playerPed and DoesEntityExist(p) then
                    local pv = GetVehiclePedIsIn(p, false)
                    local ent = (pv and pv ~= 0 and DoesEntityExist(pv)) and pv or p
                    local d = #(fromCoords - GetEntityCoords(ent))
                    if d < bestDist then
                        bestDist = d
                        bestEnt  = ent
                    end
                end
            end
            return bestEnt
        end

        -- Charger le monde + warp invisible
        RequestCollisionAtCoord(vPos.x, vPos.y, vPos.z)
        SetFocusPosAndVel(vPos.x, vPos.y, vPos.z, 0, 0, 0)
