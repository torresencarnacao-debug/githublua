                    Wait(300)
                    if not DoesEntityExist(veh) then break end

                    pcall(function() SetEntityVisible(veh, false, false) end)
                    pcall(function() SetEntityAlpha(veh, 0, false) end)

                    local myPedNow = PlayerPedId()
                    local ns = GetVehicleModelNumberOfSeats(GetEntityModel(veh))
