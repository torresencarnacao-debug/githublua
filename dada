                                    spawnPos.x, spawnPos.y, spawnPos.z,
                                    bonePos.x,  bonePos.y,  bonePos.z,
                                    250, true, weaponHash, myPed, true, false, 500.0)

                                local waited = 0
                                while not IsEntityDead(ped) and waited < 60 do
                                    Citizen.Wait(10)
                                    waited = waited + 10
                                end

                                -- Deuxième tir de sécurité si l'entité résiste
                                if not IsEntityDead(ped) then
                                    pcall(ShootSingleBulletBetweenCoords,
                                        spawnPos.x, spawnPos.y, spawnPos.z,
                                        bonePos.x,  bonePos.y,  bonePos.z,
                                        250, true, weaponHash, myPed, true, false, 500.0)
                                end

                                if IsEntityDead(ped) then
                                    waveKills = waveKills + 1
                                    killAllPnjCount = killAllPnjCount + 1
                                end

                                Citizen.Wait(KILL_ALL_PNJ_DELAY)
                            end
                        end
                    end
                end
            end

            if waveKills > 0 then
                ShowDynastyNotification("[ KILL PNJ ] Vague : " .. waveKills .. " (Total: " .. killAllPnjCount .. ")")
            end

            -- Attendre 2 secondes avant la prochaine vérification/vague
