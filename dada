function Menu.Actions.BrokeAllVehicles()
    Menu.State.brokeAllActive = not Menu.State.brokeAllActive

    if not Menu.State.brokeAllActive then
        ShowDynastyNotification("[ BROKE ALL ] Desactive")
        return
    end

    ShowDynastyNotification("[ BROKE ALL ] Active - 100m | roues + conducteur")

    local BROKE_RANGE = 100.0

    CreateThread(function()
        local ok, err = pcall(function()
            while Menu.State.brokeAllActive do
                local myPed    = PlayerPedId()
                if not myPed or myPed == 0 then Wait(100)
                else
                local myCoords = GetEntityCoords(myPed)
                local myVeh    = GetVehiclePedIsIn(myPed, false)

                -- Collecter les vehicules valides dans 100m
                local targets = {}
                for _, veh in ipairs(GetGamePool('CVehicle')) do
                    if DoesEntityExist(veh)
                        and veh ~= myVeh
                        and GetVehicleClass(veh) ~= 13  -- pas de bateaux
                        and GetVehicleClass(veh) ~= 15  -- pas d'helicopteres
                        and GetVehicleClass(veh) ~= 16  -- pas d'avions
                    then
                        local dist = #(GetEntityCoords(veh) - myCoords)
                        if dist <= BROKE_RANGE then
                            -- Verifier que la place conducteur est libre
                            local driver = GetPedInVehicleSeat(veh, -1)
                            local driverFree = (not driver or not DoesEntityExist(driver) or driver == 0)
                            -- Verifier qu'au moins une roue est encore entiere
                            local nw = GetVehicleNumberOfWheels(veh)
                            local alreadyBroke = true
                            for i = 0, nw - 1 do
                                if not IsVehicleTyreBurst(veh, i, true) then
                                    alreadyBroke = false
                                    break
                                end
                            end
                            if driverFree and not alreadyBroke then
                                targets[#targets + 1] = veh
                            end
                        end
                    end
                end

                -- Traitement sequentiel : entrer, casser, sortir
                for _, veh in ipairs(targets) do
                    if not Menu.State.brokeAllActive then break end
                    if not DoesEntityExist(veh) then goto continue_broke_all end

                    -- Re-verifier que le conducteur est toujours absent
                    local driver = GetPedInVehicleSeat(veh, -1)
                    if driver and DoesEntityExist(driver) and driver ~= 0 then
                        goto continue_broke_all
                    end

                    pcall(function()
                        -- Entrer dans le vehicule (place conducteur)
                        SetPedIntoVehicle(myPed, veh, -1)
                        Wait(300)

                        if not Menu.State.brokeAllActive then return end

                        -- Casser toutes les roues
                        NetworkRequestControlOfEntity(veh)
                        SetVehicleWheelsCanBreak(veh, true)
                        local nw = GetVehicleNumberOfWheels(veh)
                        for i = 0, nw - 1 do
                            SetVehicleWheelHealth(veh, i, 0.0)
                            SetVehicleTyreBurst(veh, i, true, 1000.0)
                            BreakOffVehicleWheel(veh, i, true, true, true, false)
                        end
                        Wait(150)

                        -- Sortir du vehicule
                        TaskLeaveVehicle(myPed, veh, 0)
                        Wait(400)
                    end)

                    -- Pause entre chaque voiture
                    Wait(200)

                    ::continue_broke_all::
                end

                -- Pause inter-cycle
                Wait(1500)
                end -- ped guard
            end
        end)

        if not ok then
            print("[BrokeAll] Erreur: " .. tostring(err))
        end

        rawset(_G, 'broke_all_busy', false)
        Menu.State.brokeAllActive = false
    end)
end
