function Menu.Helpers.ProcessSelectionHighlighter()
    if Menu.State.selectionHighlighterActive == false then
        if _lastHighlightedEntity and DoesEntityExist(_lastHighlightedEntity) then
            pcall(SetEntityDrawOutline, _lastHighlightedEntity, false)
            _lastHighlightedEntity = nil
        end
        return
    end

    local targetEntity = nil

    -- 0. Freecam : si active et highlighter ON, on cherche le véhicule visé par la caméra
    --    Utilise cam_rot (rotation freecam réelle) au lieu de GetGameplayCameraRot,
    --    portée maximale GTA (10 000 m), perce les murs via le flag de penetration.
    if freecam_active and Menu.State.selectionHighlighterActive ~= false then
        local camCoord = cam_pos
        if camCoord and cam_rot then
            local pitch = math.rad(cam_rot.x)
            local yaw   = math.rad(cam_rot.z)
            local dirX  = -math.sin(yaw) * math.cos(pitch)
            local dirY  =  math.cos(yaw) * math.cos(pitch)
            local dirZ  =  math.sin(pitch)
            local endX  = camCoord.x + dirX * 10000.0
            local endY  = camCoord.y + dirY * 10000.0
            local endZ  = camCoord.z + dirZ * 10000.0
            -- flag -1 = toutes entités, options 4 = perce les murs (wallhack)
            local ray = StartExpensiveSynchronousShapeTestLosProbe(
                camCoord.x, camCoord.y, camCoord.z,
                endX, endY, endZ,
                -1, PlayerPedId(), 4)
            local _, hit, _, _, hitEntity = GetShapeTestResult(ray)
            if hit and hitEntity and hitEntity ~= 0 and DoesEntityExist(hitEntity) then
                if IsEntityAVehicle(hitEntity) then
                    targetEntity = hitEntity
                elseif IsEntityAPed(hitEntity) then
                    -- Si on vise un occupant, cibler son véhicule
                    local pedVeh = GetVehiclePedIsIn(hitEntity, false)
                    if pedVeh and pedVeh ~= 0 and DoesEntityExist(pedVeh) then
                        targetEntity = pedVeh
                    end
                end
            end
            -- Mémoriser la cible freecam pour le rendu wireframe wallhack
            _G._freecamHighlightTarget = targetEntity
        end
    else
        _G._freecamHighlightTarget = nil
    end

    -- Si pas en freecam : logique selection explicite (joueur / vehicule selectionne)
    if not freecam_active then
        if selectedPlayer and selectedPlayer.id then
            local ped = GetPlayerPed(selectedPlayer.id)
            if DoesEntityExist(ped) and ped ~= PlayerPedId() then
                if IsPedInAnyVehicle(ped, false) then
                    targetEntity = GetVehiclePedIsIn(ped, false)
                else
                    targetEntity = ped
                end
            end
        -- 2. Vehicule EXPLICITEMENT selectionne (via la touche Entree dans le Vehicle Menu)
        elseif Menu.State.vehicleSelectedVehicle then
            local key = Menu.State.vehicleSelectedVehicle
            local veh = nil
            if type(key) == "number" then
                if NetworkDoesEntityExistWithNetworkId(key) then
                    veh = NetworkGetEntityFromNetworkId(key)
                elseif DoesEntityExist(key) then
                    veh = key
                end
            end
            if veh and DoesEntityExist(veh) then
                targetEntity = veh
            end
        end
    end

    -- Nettoyage si l'entite selectionnee a change ou a ete deselectionnee
    if _lastHighlightedEntity and _lastHighlightedEntity ~= targetEntity and DoesEntityExist(_lastHighlightedEntity) then
        pcall(SetEntityDrawOutline, _lastHighlightedEntity, false)
        _lastHighlightedEntity = nil
    end

    -- Surlignage continu (RESTE ACTIF MEME SI LE MENU EST FERME tant qu'il n'est pas deselectionne !)
    if targetEntity and DoesEntityExist(targetEntity) then
        _lastHighlightedEntity = targetEntity

        local themeColor = (Menu.Colors and (Menu.Colors.HeaderPink or Menu.Colors.SelectedBg)) or { r = 40, g = 220, b = 90 }
        local r, g, b = themeColor.r or 40, themeColor.g or 220, themeColor.b or 90
        local pulseAlpha = math.floor(180 + math.sin(GetGameTimer() * 0.007) * 75)

        DrawChamsHighlighter(targetEntity, r, g, b, pulseAlpha)
    end
end


