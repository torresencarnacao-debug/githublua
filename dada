function Menu.Actions.RefreshNearbyRadios()
    local rows={{type='action',name='Quitter la radio',id='radio_leave'},{type='action',name='Actualiser (50 m)',id='radio_refresh'}}
    local mine=PlayerPedId()
    local unreadable=0
    if mine and DoesEntityExist(mine) then
        local origin=GetEntityCoords(mine)
        local entries={}
        for _,player in ipairs(GetActivePlayers()) do
            if player~=PlayerId() and NetworkIsPlayerActive(player) then
                local ped=GetPlayerPed(player)
                if ped~=0 and DoesEntityExist(ped) then
                    local distance=#(GetEntityCoords(ped)-origin)
                    if distance<=50.0 then
                        local serverId=GetPlayerServerId(player)
                        local ok,value=pcall(function()
                            if type(Player)~='function' then return nil end
                            local remote=Player(serverId)
                            return remote and remote.state and remote.state.radioChannel
                        end)
                        local channel=ok and tonumber(value) or nil
                        if channel and channel>0 then
                            local name=tostring(GetPlayerName(player) or serverId):gsub('~','')
                            entries[#entries+1]={type='action',id='radio_channel_info',channel=channel,
                                name=('%s - Radio %s (%dm)'):format(name,tostring(channel),math.floor(distance)),distance=distance}
                        elseif not ok or value==nil then unreadable=unreadable+1 end
                    end
                end
            end
        end
        table.sort(entries,function(a,b)
            if a.channel==b.channel then return a.distance<b.distance end
            return a.channel<b.channel
        end)
        for _,entry in ipairs(entries)do
            rows[#rows+1]=entry
            print('[Radio] '..entry.name)
        end
        if #entries==0 then rows[#rows+1]={type='info',name='Aucune radio publiee a proximite'} end
    else rows[#rows+1]={type='info',name='Personnage indisponible'} end
    if unreadable>0 then
        rows[#rows+1]={type='info',name=('%d canal(aux) non publie(s)'):format(unreadable)}
    end
    Menu.State.radioNearbyRows=rows
    Menu.State.radioTestActive=false
    return rows
end
