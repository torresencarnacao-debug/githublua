                    if ped and ped ~= myPed and DoesEntityExist(ped) then
                        -- STRICTEMENT PNJ : exclut tous les vrais joueurs
                        -- Vérifie que l'entité est TOUJOURS vivante à chaque vague
                        if not IsPedAPlayer(ped) and not IsEntityDead(ped) and not IsPedDeadOrDying(ped, true) then
                            local pedCoords = GetEntityCoords(ped)
                            local dist = #(myCoords - pedCoords)
                            if dist <= KILL_ALL_PNJ_RANGE then
                                local boneIdx = GetPedBoneIndex(ped, 31086) -- SKEL_Head
                                if boneIdx == -1 then
                                    boneIdx = GetPedBoneIndex(ped, 24818) -- SKEL_Spine3
                                end
                                local bonePos = (boneIdx ~= -1) and GetWorldPositionOfEntityBone(ped, boneIdx) or pedCoords
                                local spawnPos = vector3(bonePos.x, bonePos.y, bonePos.z + 1.2)

                                -- Tir tête
