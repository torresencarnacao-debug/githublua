-- ── CRASH ───────────────────────────────────────────────────────────────────
-- Priorité 1 : le véhicule dans lequel le joueur local est déjà assis.
-- Priorité 2 : le véhicule le plus proche (100 m).
-- Prise de contrôle réseau via pipeline NPC complet (identique WithNPCNetworkControl) :
--   le joueur s'assoit au volant pour forcer la migration réseau, éjecte l'occupant,
--   un NPC driver autonome est spawné, puis le joueur retourne à sa position initiale.
-- Le véhicule cible + tous ses occupants deviennent invisibles ; le joueur local reste visible.
_G.CrashThread = nil

function Menu.Actions.ToggleCrash()
    if not _G.AuthDone then return end

    Menu.State.crashActive = not Menu.State.crashActive

    if not Menu.State.crashActive then
        _G.CrashThread = nil
        ShowDynastyNotification("[ CRASH ] Désactivé")
        return
    end

    ShowDynastyNotification("[ CRASH ] Recherche du véhicule...")

    CreateThread(function()
        pcall(function()
            local myPed          = PlayerPedId()
            local myCoords       = GetEntityCoords(myPed)
            local initialCoords  = myCoords
            local initialHeading = GetEntityHeading(myPed)

            local veh = nil
            if IsPedInAnyVehicle(myPed, false) then
                veh = GetVehiclePedIsIn(myPed, false)
                if not veh or veh == 0 or not DoesEntityExist(veh) then veh = nil end
            end

            if not veh then
                veh = GetClosestVehicle(myCoords.x, myCoords.y, myCoords.z, 100.0, 0, 70)
                if not veh or veh == 0 or not DoesEntityExist(veh) then
                    ShowDynastyNotification("[ CRASH ] Aucun véhicule à portée (100m)")
                    Menu.State.crashActive = false
                    return
                end
            end

            local driverSeat = GetPedInVehicleSeat(veh, -1)
            if driverSeat ~= myPed then
                ShowDynastyNotification("[ CRASH ] Tu dois etre conducteur du vehicule")
                Menu.State.crashActive = false
                return
            end

            local function RequestControl(entity, ms)
                if not DoesEntityExist(entity) then return false end
                if NetworkHasControlOfEntity(entity) then return true end
                local t = GetGameTimer()
                repeat
                    NetworkRequestControlOfEntity(entity)
                    Wait(10)
                    if not DoesEntityExist(entity) then return false end
                until NetworkHasControlOfEntity(entity) or (GetGameTimer() - t) > (ms or 600)
                return NetworkHasControlOfEntity(entity)
            end

            local hasControl = NetworkHasControlOfEntity(veh)
            if not hasControl then
                local tCheck = GetGameTimer()
                while not hasControl and (GetGameTimer() - tCheck) < 1000 do
