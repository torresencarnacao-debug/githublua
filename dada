        local localOk = false

        -- Sauvegarde cloud via POST
        if _G.AuthedCode and _G.AuthedCode ~= "" and Susano.HttpPost then
            local AUTH_API = "https://fpsbn-auth-production.up.railway.app"
            local safeConfig = fullSerialized:gsub('\\', '\\\\'):gsub('"', '\\"')
            local jsonBody = '{"code":"' .. _G.AuthedCode .. '","config":"' .. safeConfig .. '"}'
            local status, resp = Susano.HttpPost(AUTH_API .. "/config/save", jsonBody, "application/json")
