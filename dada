    local function reasonsText(pd)
        local r, parts = readReasons(pd), {}
        for _, key in ipairs({'server','zone','instance','jail','AFK','revive','KO',
            'gunfight','drop','exemption_revive'}) do
            parts[#parts+1] = key .. '=' .. tostring(r[key])
        end
        return table.concat(parts, ' ')
    end
    local function otherProtection(pd)
        local r = readReasons(pd)
        return isTrue(r.zone) or isTrue(r.instance) or isTrue(r.AFK)
            or isTrue(r.revive) or isTrue(r.KO) or isTrue(r.gunfight) or isTrue(r.drop)
            or (type(r.jail) == 'number' and r.jail > 0)
