        session = nil
        if _putinMenuGodmodeActive == id then _putinMenuGodmodeActive = nil end
        local restored = false
        local pd = _W90 and _W90.PlayerData
        if pd == s.data and pd.invincibleType == s.marker and pd.invincibleServer == true then
            -- Retire seulement l'etat dont cette sonde possede encore le marqueur.
            pd.invincibleServer = s.before.server
            pd.invincibleType = s.before.kind
            local keepProtection = otherProtection(pd)
            if not keepProtection then pd.invincible = s.before.invincible end
            restored = true
            if not keepProtection and PlayerPedId() == s.ped and DoesEntityExist(s.ped) then
                local nativeOK, nativeErr = pcall(function()
                    SetEntityInvincible(s.ped, isTrue(s.before.invincible)
                        or isTrue(s.before.playerInvincible) or not isTrue(s.before.canDamage))
                    SetEntityCanBeDamaged(s.ped, s.before.canDamage)
                end)
                if not nativeOK then
                    restored = false
                    log('ECHEC restauration native : ' .. tostring(nativeErr))
                end
            end
        end
        log(('STOP cause=%s elapsed_ms=%d samples=%d marker_restored=%s result=%s'):format(
            reason, GetGameTimer()-s.started, s.samples, tostring(restored), s.result))
        if not restored and s.accepted then
