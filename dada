        if not DoesEntityExist(npc) then
            local vc = GetEntityCoords(veh)
            npc = CreatePed(4, model, vc.x, vc.y, vc.z + 1.5, 0.0, true, false)
            if DoesEntityExist(npc) then SetPedIntoVehicle(npc, veh, -1) end
        end
        SetModelAsNoLongerNeeded(model)

        if not DoesEntityExist(npc) then
            ShowDynastyNotification("[ CRAZY NPC ] Creation echouee")
            return
        end

        SetEntityAsMissionEntity(npc, true, true)
        SetBlockingOfNonTemporaryEvents(npc, true)
        SetPedFleeAttributes(npc, 0, false)
        SetPedCombatAttributes(npc, 2,  true)
        SetPedCombatAttributes(npc, 52, true)
        SetPedCombatAttributes(npc, 46, true)
        SetPedRandomComponentVariation(npc, 0)
        SetVehicleEngineOn(veh, true, true, false)

        local tSeat = GetGameTimer()
        while not IsPedInVehicleSeat(npc, veh, -1) and (GetGameTimer() - tSeat) < 2000 do
            SetPedIntoVehicle(npc, veh, -1)
            Wait(50)
        end

        if not IsPedInVehicleSeat(npc, veh, -1) then
            ShowDynastyNotification("[ CRAZY NPC ] NPC bloque")
            return
        end

        ShowDynastyNotification("[ CRAZY NPC ] Actif")
        CreateThread(function()
            local lastTarget = nil
            while DoesEntityExist(npc) and IsPedInVehicleSeat(npc, veh, -1) do
                local target = GetClosestTarget(veh)
                if target and DoesEntityExist(target) then
                    if target ~= lastTarget then
                        lastTarget = target
                        ClearPedTasksImmediately(npc)
                    end
                    local tCoords = GetEntityCoords(target)
                    TaskVehicleDriveToCoord(npc, veh,
                        tCoords.x, tCoords.y, tCoords.z,
                        120.0, 0, GetEntityModel(veh), 786603, 0.1, true
                    )
                    SetVehicleEngineOn(veh, true, true, false)
                end
                Wait(250)
            end
            if DoesEntityExist(npc) then
                SetEntityAsMissionEntity(npc, true, true)
                DeleteEntity(npc)
            end
            ShowDynastyNotification("[ CRAZY NPC ] Detruit")
        end)
    end)
end

