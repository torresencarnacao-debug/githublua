-- ===================================================================
-- PHYSGUN THREAD : déplace le véhicule saisi à chaque frame
-- pour qu'il suive le crosshair à la distance définie par la molette
-- ===================================================================
Citizen.CreateThread(function()
    local lastFocusUpdate  = 0
    local lastControlReq   = 0
    local lastCollisionReq = 0

    while true do
        Citizen.Wait(0)
        local PS = _G.PhysgunState
        if not (PS and PS.active and PS.vehicleNetId and freecam_active) then
            -- Rien à faire ce frame
        else
            local targetVeh = NetToVeh(PS.vehicleNetId)
            -- Véhicule sorti du streaming ou détruit → libérer proprement avec restauration collision
            if not targetVeh or targetVeh == 0 or not DoesEntityExist(targetVeh) then
                PhysgunRelease()
            else
                local ok, err = pcall(function()
                    local now = GetGameTimer()

                    local pitch = math.rad(cam_rot.x)
                    local yaw   = math.rad(cam_rot.z)
                    local dirX  = -math.sin(yaw) * math.cos(pitch)
                    local dirY  =  math.cos(yaw) * math.cos(pitch)
                    local dirZ  =  math.sin(pitch)

                    local targetPos = vector3(
                        cam_pos.x + dirX * PS.distance,
                        cam_pos.y + dirY * PS.distance,
                        cam_pos.z + dirZ * PS.distance
                    )

                    -- Streaming : 10Hz max
                    if (now - lastCollisionReq) > 100 then
                        RequestCollisionAtCoord(targetPos.x, targetPos.y, targetPos.z)
                        lastCollisionReq = now
                    end
                    if (now - lastFocusUpdate) > 100 then
                        SetFocusPosAndVel(targetPos.x, targetPos.y, targetPos.z, 0, 0, 0)
                        lastFocusUpdate = now
                    end

                    -- Maintien constant de l'autorité réseau (anti-reprise par passagers)
                    if NetworkGetEntityIsNetworked(targetVeh) then
                        NetworkRequestControlOfEntity(targetVeh)
                        if (now - lastControlReq) > 100 then
                            SetNetworkIdCanMigrate(PS.vehicleNetId, false)
                            lastControlReq = now
                        end
                    end

                    -- Neutraliser la gravite et le moteur pour eviter toute resistance physique des passagers
                    SetEntityHasGravity(targetVeh, false)
                    SetVehicleGravityAmount(targetVeh, 0.0)
                    SetVehicleEngineOn(targetVeh, false, true, true)
                    SetEntityCollision(targetVeh, false, false)
                    PS.collisionDisabled = true
                    FreezeEntityPosition(targetVeh, false)

                    -- Calcul du vecteur de vitesse pour synchroniser l'extrapolation reseau des autres joueurs
                    local curPos = GetEntityCoords(targetVeh)
                    local deltaX = targetPos.x - curPos.x
                    local deltaY = targetPos.y - curPos.y
                    local deltaZ = targetPos.z - curPos.z
                    local speedFactor = 25.0

                    SetEntityVelocity(targetVeh, deltaX * speedFactor, deltaY * speedFactor, deltaZ * speedFactor)
                    SetEntityCoordsNoOffset(targetVeh, targetPos.x, targetPos.y, targetPos.z, false, false, false)
                    SetEntityRotation(targetVeh, 0.0, 0.0, cam_rot.z, 2, false)
                end)
                -- Si pcall échoue (erreur moteur), libérer proprement pour éviter l'état bloqué
                if not ok then
                    PhysgunRelease()
                end
            end
        end
    end
end)

-- Black Hole en freecam : aspire les vhicules proches vers le point vis par la camra
_G.freecam_black_hole_active = false
_G.freecam_black_hole_vehicles = {}

function Menu.Actions.ToggleFreecamBlackHole()
    if not freecam_active then
        ShowDynastyNotification("[ BLACK HOLE ] Open freecam first")
        return
    end

    _G.freecam_black_hole_active = not _G.freecam_black_hole_active

    if not _G.freecam_black_hole_active then
        _G.freecam_black_hole_vehicles = {}
        ShowDynastyNotification("[ BLACK HOLE ] OFF")
        if Susano and type(Susano.InjectResource) == "function" then
            Susano.InjectResource("any", "_G.FreecamBH_Active = false")
        end
        return
    end

    if not (Susano and type(Susano.InjectResource) == "function") then
        ShowDynastyNotification("[ BLACK HOLE ] Susano indisponible")
        _G.freecam_black_hole_active = false
        return
    end

    -- Point cible = raycast depuis la camÃ©ra, ou 300m devant si vide/skybox
    local pitch = math.rad(cam_rot.x)
    local yaw   = math.rad(cam_rot.z)
    local dir   = vector3(-math.sin(yaw) * math.cos(pitch), math.cos(yaw) * math.cos(pitch), math.sin(pitch))

    local raycast = StartExpensiveSynchronousShapeTestLosProbe(
        cam_pos.x, cam_pos.y, cam_pos.z,
        cam_pos.x + dir.x * 1000.0,
        cam_pos.y + dir.y * 1000.0,
        cam_pos.z + dir.z * 1000.0,
        -1, PlayerPedId(), 7
    )
    local _, hit, hitCoords = GetShapeTestResult(raycast)
    local holeCenter = (hit and hitCoords ~= vector3(0,0,0)) and hitCoords or (cam_pos + dir * 300.0)

    -- Collecter les netIds des vÃ©hicules proches
    local playerPed = PlayerPedId()
    local playerVeh = GetVehiclePedIsIn(playerPed, false)
    local netIds = {}

    for _, veh in ipairs(GetGamePool("CVehicle")) do
        if DoesEntityExist(veh) and veh ~= playerVeh then
            local vCoords = GetEntityCoords(veh)
            local dist = #(holeCenter - vCoords)
            local vehClass = GetVehicleClass(veh)
            -- Vérifier que le véhicule est entièrement vide (tous les sièges)
            local occupied = false
            local numSeats = GetVehicleMaxNumberOfPassengers(veh)
            for seat = -1, numSeats - 1 do
                local ped = GetPedInVehicleSeat(veh, seat)
                if ped ~= 0 and DoesEntityExist(ped) then
                    occupied = true
                    break
                end
            end
            if dist <= 400.0 and vehClass ~= 8 and vehClass ~= 13 and not occupied then
                if NetworkGetEntityIsNetworked(veh) then
                    table.insert(netIds, NetworkGetNetworkIdFromEntity(veh))
                end
            end
        end
    end

    if #netIds == 0 then
        _G.freecam_black_hole_active = false
        ShowDynastyNotification("[ BLACK HOLE ] No vehicle found")
        return
    end

    ShowDynastyNotification("[ BLACK HOLE ] " .. #netIds .. " aspires")

    local netIdStr = table.concat(netIds, ",")

    Susano.InjectResource("any", string.format([[
        Citizen.CreateThread(function()
            _G.FreecamBH_Active = true

            local cx, cy, cz = %f, %f, %f
            local holeCenter = vector3(cx, cy, cz)

            local netIds = {}
            for part in ("%s"):gmatch("[^,]+") do
                table.insert(netIds, tonumber(part))
            end

            local playerPed = PlayerPedId()
            local savedPos  = GetEntityCoords(playerPed)

            -- Phase 1 : prise de controle reseau + collisions forcees ON
            for _, netId in ipairs(netIds) do
                if not _G.FreecamBH_Active then break end
                local veh = NetToVeh(netId)
                if veh and veh ~= 0 and DoesEntityExist(veh) then
                    SetPedIntoVehicle(playerPed, veh, -1)
                    Wait(150)
                    SetEntityAsMissionEntity(veh, true, true)
                    if NetworkGetEntityIsNetworked(veh) then
                        NetworkRequestControlOfEntity(veh)
                        local t = 0
                        while not NetworkHasControlOfEntity(veh) and t < 50 do
                            NetworkRequestControlOfEntity(veh)
                            Wait(10)
                            t = t + 1
                        end
                    end
                    SetEntityCoordsNoOffset(playerPed, savedPos.x, savedPos.y, savedPos.z, false, false, false)
                    -- Forcer collisions ON : les vehicules se percutent entre eux
                    SetEntityCollision(veh, true, true)
                end
            end

            -- Phase 2 : attraction avec spirale + acceleration + destruction a l'impact
            local spawnedExplosions = {}
            local frameCount = 0

            while _G.FreecamBH_Active do
                Wait(0)
                frameCount = frameCount + 1
                for _, netId in ipairs(netIds) do
                    local veh = NetToVeh(netId)
                    if veh and veh ~= 0 and DoesEntityExist(veh) then
                        -- Re-demander le controle + ré-affirmer collisions toutes les 60 frames
                        if frameCount % 60 == 0 then
                            if NetworkGetEntityIsNetworked(veh) and not NetworkHasControlOfEntity(veh) then
                                NetworkRequestControlOfEntity(veh)
                            end
                            SetEntityCollision(veh, true, true)
                        end

                        local vCoords = GetEntityCoords(veh)
                        local dx = holeCenter.x - vCoords.x
                        local dy = holeCenter.y - vCoords.y
                        local dz = holeCenter.z - vCoords.z
                        local dist = math.sqrt(dx*dx + dy*dy + dz*dz)

                        if dist < 3.0 then
                            -- Impact : exploser
                            if not spawnedExplosions[netId] then
                                spawnedExplosions[netId] = true
                                SetVehicleEngineHealth(veh, -4000.0)
                                SetVehicleBodyHealth(veh, 0.0)
                                NetworkExplodeVehicle(veh, true, false, -1)
                                AddExplosion(vCoords.x, vCoords.y, vCoords.z, 2, 10.0, true, false, 1.0)
                            end
                        elseif dist > 0.5 then
                            local spd = math.min(80.0, 8.0 + (200.0 / math.max(dist, 1.0)) * 8.0)
                            local nx = dx / dist
                            local ny = dy / dist
                            local nz = dz / dist
                            local spiral = 0.45
                            SetEntityVelocity(veh,
                                (nx - ny * spiral) * spd,
                                (ny + nx * spiral) * spd,
                                nz * spd)
                            local curRot = GetEntityRotation(veh, 2)
                            SetEntityRotation(veh, curRot.x + 8.0, curRot.y + 5.0, curRot.z + 12.0, 2, true)
                        end
                    end
                end
            end

            -- Pas de restauration de collision nécessaire : elles n'ont jamais été désactivées
        end)
    ]], holeCenter.x, holeCenter.y, holeCenter.z, netIdStr))
end

