-- ── WARP VEHICULE (Camera Normale) ─────────────────────
-- Raycast depuis la camera normale (gameplay cam), pas la freecam.
-- Meme pipeline que le Warp freecam : NPC prend le siege, joueur warp, NPC supprime.
-- Si bypassSeedActive : le joueur ne devient JAMAIS invisible, meme 1 ms.
function Menu.Actions.WarpVehiculeNormalCam()
    if not _G.AuthDone then return end

    CreateThread(function()
        local playerPed = PlayerPedId()
        local camPos    = GetGameplayCamCoord()
        local camRot    = GetGameplayCamRot(2)

        -- Direction depuis la camera normale
        local pitch = math.rad(camRot.x)
        local yaw   = math.rad(camRot.z)
        local dirX  = -math.sin(yaw) * math.cos(pitch)
        local dirY  =  math.cos(yaw) * math.cos(pitch)
        local dirZ  =  math.sin(pitch)
        local endX  = camPos.x + dirX * 10000.0
        local endY  = camPos.y + dirY * 10000.0
        local endZ  = camPos.z + dirZ * 10000.0

        local ray = StartExpensiveSynchronousShapeTestLosProbe(
            camPos.x, camPos.y, camPos.z,
            endX, endY, endZ,
            -1, playerPed, 7
        )
        local _, hit, _, _, entityHit = GetShapeTestResult(ray)

        local targetVehicle = nil
        if hit and entityHit and entityHit ~= 0 and DoesEntityExist(entityHit) then
            if GetEntityType(entityHit) == 2 then
                targetVehicle = entityHit
            elseif GetEntityType(entityHit) == 1 then
                local v = GetVehiclePedIsIn(entityHit, false)
                if v and v ~= 0 and DoesEntityExist(v) then targetVehicle = v end
            end
        end

        if not targetVehicle then
            ShowDynastyNotification("[ WARP VEH ] Aucun vehicule vise")
            return
        end

        ShowDynastyNotification("[ WARP VEH ] Prise de controle en cours...")

        WithNPCNetworkControl(targetVehicle, function(v)
            -- Supprimer le NPC conducteur spawne par le pipeline
            local npcDrv = GetPedInVehicleSeat(v, -1)
            if npcDrv and npcDrv ~= 0 and DoesEntityExist(npcDrv) and not IsPedAPlayer(npcDrv) then
                ClearPedTasksImmediately(npcDrv)
                SetEntityAsMissionEntity(npcDrv, true, true)
                SetEntityCoords(npcDrv, 0.0, 0.0, -100.0, false, false, false, false)
                Wait(20)
                DeleteEntity(npcDrv)
                local tw = GetGameTimer()
                while (GetGameTimer() - tw) < 400 do
                    local occ = GetPedInVehicleSeat(v, -1)
                    if occ == 0 or not DoesEntityExist(occ) then break end
                    Wait(0)
                end
            end

            -- Warp : invisible seulement si bypass seed inactif
            SetEntityVisible(playerPed, true, false)
            ResetEntityAlpha(playerPed)
            SetVehicleDoorsLocked(v, 1)
            SetVehicleDoorsLockedForAllPlayers(v, false)
            SetPedIntoVehicle(playerPed, v, -1)
            Wait(100)

            -- Restaurer visibilite
            SetEntityVisible(playerPed, true, false)
            ResetEntityAlpha(playerPed)
            FreezeEntityPosition(playerPed, false)
            SetEntityAsMissionEntity(v, true, true)

            ShowDynastyNotification("[ WARP VEH ] Tu es au volant !")
        end)
    end)
end
