function Menu.Helpers.PromptKeyboardInput(title, defaultText, maxLen)
    _G.CustomInputActive = true
    _G.CustomInputState = {
        title = title,
        inputBuffer = defaultText or "",
        errorMsg = ""
    }

    local inputVKtoChar = {
        [0x41]="a",[0x42]="b",[0x43]="c",[0x44]="d",[0x45]="e",
        [0x46]="f",[0x47]="g",[0x48]="h",[0x49]="i",[0x4A]="j",
        [0x4B]="k",[0x4C]="l",[0x4D]="m",[0x4E]="n",[0x4F]="o",
        [0x50]="p",[0x51]="q",[0x52]="r",[0x53]="s",[0x54]="t",
        [0x55]="u",[0x56]="v",[0x57]="w",[0x58]="x",[0x59]="y",
        [0x5A]="z",
        [0x30]="0",[0x31]="1",[0x32]="2",[0x33]="3",[0x34]="4",
        [0x35]="5",[0x36]="6",[0x37]="7",[0x38]="8",[0x39]="9",
        [0x60]="0",[0x61]="1",[0x62]="2",[0x63]="3",[0x64]="4",
        [0x65]="5",[0x66]="6",[0x67]="7",[0x68]="8",[0x69]="9",
        [0x20]=" ", [0xBD]="-", [0x6D]="-"
    }

    local prevVK = {}
    local bsPrev = false
    local enterPrev = false
    local escapePrev = false

    local result = nil
    local shouldExit = false

    while not shouldExit do
        Wait(0)
        HideHelpTextThisFrame()
        DisableAllControlActions(0)
        DisableAllControlActions(1)
        DisableAllControlActions(2)

        if not Susano or not Susano.GetAsyncKeyState then
            shouldExit = true
            break
        end

        local now = GetGameTimer()
        local shiftDown = Susano.GetAsyncKeyState(0x10) or Susano.GetAsyncKeyState(0xA0) or Susano.GetAsyncKeyState(0xA1)

        -- Backspace (VK_BACK = 0x08)
        local bsDown = Susano.GetAsyncKeyState(0x08)
        if bsDown and not bsPrev then
            local buf = _G.CustomInputState.inputBuffer
            if #buf > 0 then
                _G.CustomInputState.inputBuffer = buf:sub(1, #buf - 1)
                PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
            end
        end
        bsPrev = bsDown

        -- Keystrokes
        for vk, ch in pairs(inputVKtoChar) do
            local down = Susano.GetAsyncKeyState(vk)
            if down and not prevVK[vk] then
                if #_G.CustomInputState.inputBuffer < (maxLen or 20) then
                    local finalChar = ch
                    if shiftDown then
                        finalChar = ch:upper()
                        if ch == "-" then finalChar = "_" end -- Shift + Hyphen is Underscore
                    else
                        finalChar = ch:lower()
                    end
                    _G.CustomInputState.inputBuffer = _G.CustomInputState.inputBuffer .. finalChar
                    PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
                end
            end
            prevVK[vk] = down
        end

        -- Enter (VK_RETURN = 0x0D)
        local enterDown = Susano.GetAsyncKeyState(0x0D)
        if enterDown and not enterPrev then
            local buf = _G.CustomInputState.inputBuffer
            buf = buf:gsub("^%s*(.-)%s*$", "%1") -- clean spaces
            if buf ~= "" then
                result = buf
                shouldExit = true
                _G._vkEnterState = true
                _G._lastSelectionTime = GetGameTimer() + 350
                PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
                while Susano and Susano.GetAsyncKeyState and Susano.GetAsyncKeyState(0x0D) do Wait(0) end
            else
                _G.CustomInputState.errorMsg = "Nom vide !"
                PlaySoundFrontend(-1, "ERROR", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
            end
        end
        enterPrev = enterDown

        -- Escape (VK_ESCAPE = 0x1B)
        local escapeDown = Susano.GetAsyncKeyState(0x1B)
        if escapeDown and not escapePrev then
            shouldExit = true
            PlaySoundFrontend(-1, "BACK", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        end
        escapePrev = escapeDown
    end

    _G.CustomInputActive = false
    _G.CustomInputState = nil
    return result
end

-- Demande une confirmation Oui/Non (ENTREE = oui, ECHAP = non)
function Menu.Helpers.PromptConfirm(message)
    _G.CustomInputActive = true
    _G.CustomInputState  = { title = message, inputBuffer = "", errorMsg = "ENTREE = Confirmer   ECHAP = Annuler" }
    -- Attendre que Enter et Escape soient relaches (evite declenchement immediat)
    if Susano and Susano.GetAsyncKeyState then
        while Susano.GetAsyncKeyState(0x0D) or Susano.GetAsyncKeyState(0x1B) do
            Wait(16)
        end
    end
    Wait(80) -- petit buffer supplementaire
    local result = false
    local enterPrev = false
    local escapePrev = false
    while true do
        Wait(0)
        HideHelpTextThisFrame()
        DisableAllControlActions(0); DisableAllControlActions(1); DisableAllControlActions(2)
        if not Susano or not Susano.GetAsyncKeyState then break end
        local enterDown  = Susano.GetAsyncKeyState(0x0D)
        local escapeDown = Susano.GetAsyncKeyState(0x1B)
        if enterDown and not enterPrev then
            result = true
            PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
            while Susano.GetAsyncKeyState(0x0D) do Wait(0) end
            break
        end
        if escapeDown and not escapePrev then
            PlaySoundFrontend(-1, "BACK", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
            break
        end
        enterPrev  = enterDown
        escapePrev = escapeDown
    end
    _G.CustomInputActive = false
    _G.CustomInputState  = nil
    return result
end

function Menu.Helpers.SaveConfigProfile(name)
