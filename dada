local MicESPConfig = { maxDistance = 150.0, heightOffset = -1.15, scale = 0.38 }
local function DrawMicESP(x, y, z)
    if not HasStreamedTextureDictLoaded("mpleaderboard") then
        RequestStreamedTextureDict("mpleaderboard", true)
        return
    end
    local visible, sx, sy = World3dToScreen2d(x, y, z)
    if not visible then return end
    local aspect = GetAspectRatio(false)
    if aspect <= 0 then aspect = 1.777778 end
    local size = 0.042
    DrawSprite("mpleaderboard", "leaderboard_audio_3", sx, sy, size / aspect, size, 0.0, 0, 255, 60, 255)
end
