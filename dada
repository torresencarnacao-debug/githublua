end

function Menu.Helpers.LoadConfigProfile(name)
    if not Menu.CloudConfigs or not Menu.CloudConfigs.profiles or not Menu.CloudConfigs.profiles[name] then
        ShowDynastyNotification("[ CONFIG ] Profil inconnu")
        return
    end

    local content = Menu.CloudConfigs.profiles[name]
    local fn, err = load("return " .. content)
    if fn then
        local ok, data = pcall(fn)
        if ok and type(data) == "table" then
            Menu.Helpers.ApplyConfigData(data)
            ShowDynastyNotification("[ CONFIG ] '" .. name .. "' charge")
        else
            ShowDynastyNotification("[ CONFIG ] Echec chargement")
        end
    else
        ShowDynastyNotification("[ CONFIG ] Profil corrompu")
    end
end

function Menu.Helpers.GetConfigsOptions()
    local options = { "Create new config..." }
    if Menu.CloudConfigs and Menu.CloudConfigs.profiles then
        local sortedNames = {}
        for pName in pairs(Menu.CloudConfigs.profiles) do
            table.insert(sortedNames, pName)
        end
        table.sort(sortedNames)
        
        if #sortedNames > 0 then
            table.insert(options, { type = "separator", name = "--- SAVED PROFILES ---" })
            for _, pName in ipairs(sortedNames) do
                table.insert(options, pName)
            end
        end
    end
    return options
end

