    VIP_GIVE_ASSAULT = "Assault",
    VIP_GIVE_SNIPER  = "Sniper",
    VIP_GIVE_MELEE   = "Melee",
    VIP_GIVE_SHOTGUN = "Shotgun",
    VIP_GIVE_HEAVY   = "Heavy",
}
function Menu.Helpers.GetVipGiveCatOptions(menuId)
    local key  = _vipGiveCatKey[menuId]
    local data = key and _addonWeaponData[key]
    if not data then return {} end
    local list = {}
    for i = 1, math.min(5, #data.options) do
        list[#list+1] = { type = "weapon_entry", name = data.options[i], weapon = data.weapons[i] }
    end
    return list
end

