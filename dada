    ClearFocus()
    if _freecam_fov_cam and _freecam_fov_cam ~= 0 and DoesCamExist(_freecam_fov_cam) then
        SetCamActive(_freecam_fov_cam, false)
        RenderScriptCams(false, false, 0, true, true)
        DestroyCam(_freecam_fov_cam, false)
    end
    _freecam_fov_cam = nil
    freecam_active = false
    _G.freecam_active = false
    shootVisionActive = false  -- Reset du Shoot Vision freecam  la sortie
    -- Nettoyer le Physgun si actif
    PhysgunRelease()
end

