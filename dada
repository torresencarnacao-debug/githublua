-- Helper interne : warp invisible dans le veh pour forcer le controle reseau, execute fn(), puis sort
-- Pipeline NPC hijack pour obtenir le controle reseau d'un vehicule
-- Utilise un NPC invisible pour prendre le siege conducteur si le vehicule est occupe,
-- ce qui force le transfert de controle reseau cote serveur (identique a NPCHijackDriver).
-- fn(veh) est execute une fois le controle acquis.
-- Pipeline universel pour executer fn(veh) avec le controle reseau garanti.
-- Copie exacte du pipeline physgun :
--   1. NetworkHasControlOfEntity → action directe, pas de warp.
--   2. Sinon : joueur warp invisible dans le veh, boucle takeover (ejecter driver, prendre volant),
--      puis sortir + spawner NPC conducteur pour remplacer le joueur, puis action.
local function WithNPCNetworkControl(veh, fn)
    if not veh or not DoesEntityExist(veh) then return end
    local playerPed = PlayerPedId()

    -- Deja le controle reseau : action directe
    if NetworkHasControlOfEntity(veh) then
        SetEntityAsMissionEntity(veh, true, true)
        pcall(fn, veh)
        return
    end

    -- Sinon : pipeline NPC Hijack unique (NPC immobile au volant pour garder le controle)
    local ok = Menu.Helpers.HijackVehicle(veh, { npcTask = "none" })
    if not ok then
        ShowDynastyNotification("[ CTRL ] Controle refuse")
        return
    end

    NetworkRequestControlOfEntity(veh)
    SetEntityAsMissionEntity(veh, true, true)

    local watch = Menu.State.bypassSeedActive
    if watch then
        _G._bypassWarpWatchRunning = true
        CreateThread(function()
            while _G._bypassWarpWatchRunning do
                local ped = PlayerPedId()
                if not IsEntityVisible(ped) then SetEntityVisible(ped, true, false) end
                if GetEntityAlpha(ped) < 255 then ResetEntityAlpha(ped) end
                Wait(0)
            end
            SetEntityVisible(PlayerPedId(), true, false)
            ResetEntityAlpha(PlayerPedId())
        end)
    end

    local _ok = pcall(fn, veh)
    _G._bypassWarpWatchRunning = false
    SetEntityVisible(playerPed, true, false)
    ResetEntityAlpha(playerPed)
    if not _ok then ShowDynastyNotification("[ CTRL ] Erreur interne") end
end

-- =============================================================================
--  PIPELINE UNIQUE DE HIJACK VEHICULE (base : NPC Hijack freecam)
--  Utilise par : NPC Hijack (freecam), NPC Drive, Delete Vehicle, Bug Vehicle,
--  Broke Wheel, Physgun, TP Passenger, Warp Vehicle (via WithNPCNetworkControl).
--  A appeler DANS un CreateThread (utilise Wait).
--  opts.npcTask : "wander" (V1) | "v2" (boost chaotique) | "none" (NPC immobile)
--  opts.freezeAfter : fige le ped local a la fin (comportement freecam)
--  Retourne : success (bool), npc (entity ou nil)
-- =============================================================================
function Menu.Helpers.NPCHijackV2Loop(veh, pnj)
    CreateThread(function()
        local startTime = GetGameTimer()
        while (GetGameTimer() - startTime) < 90000 do
            if not DoesEntityExist(veh) or not DoesEntityExist(pnj) then break end
            if not IsPedInVehicle(pnj, veh, false) then break end
            NetworkRequestControlOfEntity(veh)

            local boostType = math.random(1, 4)
            local speed = math.random(60, 100) + 0.0
            local fwd = GetEntityForwardVector(veh)

            if boostType == 1 then
                SetEntityVelocity(veh, fwd.x * speed, fwd.y * speed, math.random(3, 12) + 0.0)
                ApplyForceToEntity(veh, 1, fwd.x * 500.0, fwd.y * 500.0, 150.0, 0.0, 0.0, 0.0, 0, false, true, true, false, true)
            elseif boostType == 2 then
                local sign = (math.random(0, 1) == 0) and -1.0 or 1.0
                local sideX, sideY = -fwd.y * sign, fwd.x * sign
                SetEntityVelocity(veh, (fwd.x * 0.3 + sideX * 0.9) * speed, (fwd.y * 0.3 + sideY * 0.9) * speed, math.random(4, 16) + 0.0)
                SetEntityAngularVelocity(veh, 0.0, 0.0, sign * math.random(6, 16))
                ApplyForceToEntity(veh, 1, sideX * 600.0, sideY * 600.0, 180.0, 0.0, 0.0, 0.0, 0, false, true, true, false, true)
            elseif boostType == 3 then
                SetEntityVelocity(veh, fwd.x * (speed * 0.6), fwd.y * (speed * 0.6), math.random(25, 50) + 0.0)
                ApplyForceToEntity(veh, 1, fwd.x * 250.0, fwd.y * 250.0, 700.0, 0.0, 0.0, 0.0, 0, false, true, true, false, true)
            else
                local angle = math.random() * math.pi * 2.0
                local dirX, dirY = math.cos(angle), math.sin(angle)
                SetEntityVelocity(veh, dirX * speed, dirY * speed, math.random(5, 22) + 0.0)
                SetEntityAngularVelocity(veh, (math.random() - 0.5) * 12.0, (math.random() - 0.5) * 12.0, (math.random() - 0.5) * 25.0)
                ApplyForceToEntity(veh, 1, dirX * 600.0, dirY * 600.0, 250.0, 0.0, 0.0, 0.0, 0, false, true, true, false, true)
            end

            if math.random(1, 4) == 1 then StartVehicleHorn(veh, 300, "HELDDOWN", false) end
            TaskVehicleDriveWander(pnj, veh, 150.0, 1074528293)
            Wait(math.random(200, 380))
        end
    end)
end

function Menu.Helpers._HijackVehicleImpl(veh, opts)
    opts = opts or {}
    if not veh or veh == 0 or not DoesEntityExist(veh) then return false, nil end

    -- Toujours marquer comme mission entity d'emblee pour empecher GTA de le supprimer
    SetEntityAsMissionEntity(veh, true, true)

    local playerPed      = PlayerPedId()
    local initialCoords  = GetEntityCoords(playerPed)
    local initialHeading = GetEntityHeading(playerPed)
    local vPos           = GetEntityCoords(veh)
    local npcTask        = opts.npcTask or "wander"

    -- Si le joueur est dans son propre vehicule : on y retourne a la fin
    local prevVeh, prevSeat = nil, -2
    if IsPedInAnyVehicle(playerPed, false) then
        local pv = GetVehiclePedIsIn(playerPed, false)
        if pv and pv ~= 0 and pv ~= veh then
            prevVeh = pv
            for s = -1, GetVehicleMaxNumberOfPassengers(pv) - 1 do
                if GetPedInVehicleSeat(pv, s) == playerPed then prevSeat = s; break end
            end
        end
    end

    local function RequestControl(entity, timeoutMs)
        if not entity or not DoesEntityExist(entity) then return false end
        local start = GetGameTimer()
        NetworkRequestControlOfEntity(entity)
        while not NetworkHasControlOfEntity(entity) do
            Wait(10)
            if not DoesEntityExist(entity) then return false end
            if GetGameTimer() - start > (timeoutMs or 500) then return false end
            NetworkRequestControlOfEntity(entity)
        end
        return true
    end

    local warped = false

    local function restorePlayer()
        SetEntityCoordsNoOffset(playerPed, initialCoords.x, initialCoords.y, initialCoords.z, false, false, false, false)
        SetEntityHeading(playerPed, initialHeading)
        SetEntityVisible(playerPed, true, false)
        ResetEntityAlpha(playerPed)
        if warped then
            warped = false
            pcall(ClearFocus)
            pcall(NewLoadSceneStop)
        end
        if prevVeh and prevSeat ~= -2 and DoesEntityExist(prevVeh) and IsVehicleSeatFree(prevVeh, prevSeat) then
            SetPedIntoVehicle(playerPed, prevVeh, prevSeat)
        end
    end

    -- Garder le joueur visible pendant tout le pipeline si bypass seed actif
    if Menu.State.bypassSeedActive then
        _G._hijackVisWatch = true
        CreateThread(function()
            while _G._hijackVisWatch do
                local ped = PlayerPedId()
                if not IsEntityVisible(ped) then SetEntityVisible(ped, true, false) end
                if GetEntityAlpha(ped) < 255 then ResetEntityAlpha(ped) end
                Wait(0)
            end
        end)
    end

    -- Si le joueur n'est pas deja dans le vehicule cible : warp a proximite immediate
    if GetVehiclePedIsIn(playerPed, false) ~= veh then
        warped = true
        RequestCollisionAtCoord(vPos.x, vPos.y, vPos.z)
        SetEntityCoordsNoOffset(playerPed, vPos.x, vPos.y, vPos.z + 0.5, false, false, false)
        Wait(60)
        if not DoesEntityExist(veh) then
            _G._hijackVisWatch = false
            restorePlayer()
            return false, nil
        end
    end

    SetEntityVisible(playerPed, true, false)
    ResetEntityAlpha(playerPed)
    SetEntityAsMissionEntity(veh, true, true)
    RequestControl(veh, 600)
    SetVehicleDoorsLocked(veh, 1)
    SetVehicleDoorsLockedForAllPlayers(veh, false)
    ClearPedTasksImmediately(playerPed)

    -- Ejecter un eventuel PNJ deja au volant (pas un joueur)
    local existingDriver = GetPedInVehicleSeat(veh, -1)
    if existingDriver ~= 0 and existingDriver ~= playerPed and DoesEntityExist(existingDriver) and not IsPedAPlayer(existingDriver) then
        RequestControl(existingDriver, 300)
        ClearPedTasksImmediately(existingDriver)
        SetEntityAsMissionEntity(existingDriver, true, true)
        SetEntityCoords(existingDriver, 0.0, 0.0, -100.0, false, false, false, false)
        DeleteEntity(existingDriver)
        Wait(20)
    end

    -- Prendre le siege conducteur
    SetPedIntoVehicle(playerPed, veh, -1)
    local takeoverSuccess = false
    local tStart = GetGameTimer()
    while (GetGameTimer() - tStart) < 800 do
        if not DoesEntityExist(veh) then break end
        RequestControl(veh, 200)
        if IsPedInVehicle(playerPed, veh, false) and GetPedInVehicleSeat(veh, -1) == playerPed then
            takeoverSuccess = true
            break
        end
        SetPedIntoVehicle(playerPed, veh, -1)
        Wait(30)
    end

    if not takeoverSuccess then
        _G._hijackVisWatch = false
        restorePlayer()
        if opts.freezeAfter then FreezeEntityPosition(playerPed, true) end
        return false, nil
    end

    -- Le joueur est au volant : controle reseau garanti, execution de onSeated
    if opts.onSeated then
        RequestControl(veh, 400)
        local okCb, errCb = pcall(opts.onSeated, veh)
        if not okCb then print("[HIJACK] onSeated erreur : " .. tostring(errCb)) end
    end

    -- Si le vehicule a ete supprime pendant onSeated
    if not DoesEntityExist(veh) then
        _G._hijackVisWatch = false
        restorePlayer()
        if opts.freezeAfter then FreezeEntityPosition(playerPed, true) end
        return true, nil
    end

    -- Remplacer le joueur par un NPC conducteur AVANT de restaurer la position du joueur
    local npc = nil
    if not opts.noNPC and DoesEntityExist(veh) then
        local model = GetHashKey("s_m_y_marine_01")
        RequestModel(model)
        local tModel = GetGameTimer()
        while not HasModelLoaded(model) and (GetGameTimer() - tModel) < 1500 do Wait(10) end

        -- Ejecter le joueur sur le cote du vehicule
        TaskLeaveVehicle(playerPed, veh, 16)
        SetEntityCoordsNoOffset(playerPed, vPos.x + 2.0, vPos.y, vPos.z + 0.5, false, false, false)
        Wait(40)

        if HasModelLoaded(model) and DoesEntityExist(veh) then
            npc = CreatePedInsideVehicle(veh, 4, model, -1, true, false)
            if not npc or not DoesEntityExist(npc) then
                npc = CreatePed(4, model, vPos.x, vPos.y, vPos.z, 0.0, true, false)
                if npc and DoesEntityExist(npc) then SetPedIntoVehicle(npc, veh, -1) end
            end
            if npc and DoesEntityExist(npc) then
                SetEntityAsMissionEntity(npc, true, true)
                SetEntityAsMissionEntity(veh, true, true)
                SetBlockingOfNonTemporaryEvents(npc, true)
                SetPedRandomComponentVariation(npc, 0)
                SetPedCanRagdoll(npc, false)
                SetPedCanBeDraggedOut(npc, false)
                SetPedKeepTask(npc, true)
                SetDriverAggressiveness(npc, 1.0)
                SetDriverAbility(npc, 1.0)
                SetVehicleEngineOn(veh, true, true, false)
                SetPedIntoVehicle(npc, veh, -1)

                if npcTask == "v2" then
                    SetEntityInvincible(veh, true)
                    SetEntityInvincible(npc, true)
                    pcall(SetVehicleEnginePowerMultiplier, veh, 50.0)
                    pcall(SetVehicleCheatPowerIncrease, veh, 5.0)
                    TaskVehicleDriveWander(npc, veh, 150.0, 1074528293)
                    Menu.Helpers.NPCHijackV2Loop(veh, npc)
                elseif npcTask == "none" then
                    SetEntityInvincible(npc, true)
                else
                    TaskVehicleDriveWander(npc, veh, 40.0, 786603)
                end
            end
            SetModelAsNoLongerNeeded(model)
        end
    else
        if IsPedInVehicle(playerPed, veh, false) then
            TaskLeaveVehicle(playerPed, veh, 16)
            Wait(40)
        end
    end

    -- Restaurer le joueur a sa position d'origine
    restorePlayer()
    if opts.freezeAfter then FreezeEntityPosition(playerPed, true) end

    _G._hijackVisWatch = false
    SetEntityVisible(playerPed, true, false)
    ResetEntityAlpha(playerPed)
    return true, npc
end

-- Wrapper : anti-double-lancement + garantit le nettoyage meme en cas d'erreur
function Menu.Helpers.HijackVehicle(veh, opts)
    local now = GetGameTimer()
    if _G._hijackBusy and (now - (_G._hijackBusyAt or 0)) < 2500 then
        local waitStart = now
        while _G._hijackBusy and (GetGameTimer() - waitStart) < 2500 do
            Wait(50)
        end
        if _G._hijackBusy then
            _G._hijackBusy     = false
            _G._hijackVisWatch = false
            local ped = PlayerPedId()
            pcall(SetEntityVisible, ped, true, false)
            pcall(ResetEntityAlpha, ped)
            pcall(ClearFocus)
            pcall(NewLoadSceneStop)
        end
    else
        _G._hijackBusy = false
    end
    _G._hijackBusy   = true
    _G._hijackBusyAt = GetGameTimer()
    local ok, res, npc = pcall(Menu.Helpers._HijackVehicleImpl, veh, opts)
    _G._hijackBusy     = false
    _G._hijackVisWatch = false
    local ped = PlayerPedId()
    SetEntityVisible(ped, true, false)
    ResetEntityAlpha(ped)
    if not ok then
        pcall(ClearFocus)
        pcall(NewLoadSceneStop)
        print("[HIJACK] erreur : " .. tostring(res))
        return false, nil
    end
    return res, npc
end

