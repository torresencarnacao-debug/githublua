function Menu.Helpers.DrawGradientRect(x, y, w, h, r1, g1, b1, a1, r2, g2, b2, a2)
    if Susano and Susano.DrawRectFilled then
        local steps = 80
        local stepW = w / steps
        for i = 0, steps - 1 do
            local t = i / (steps - 1)
            local r = r1 + (r2 - r1) * t
            local g = g1 + (g2 - g1) * t
            local b = b1 + (b2 - b1) * t
            local a = a1 + (a2 - a1) * t
            Susano.DrawRectFilled(x + i * stepW, y, stepW + 0.5, h, r, g, b, a, 0.0)
        end
    end
end




local function StaffRotationToDirection(rotation)
    local rx = (math.pi / 180) * rotation.x
    local rz = (math.pi / 180) * rotation.z
    return vector3(
        -math.sin(rz) * math.abs(math.cos(rx)),
         math.cos(rz) * math.abs(math.cos(rx)),
         math.sin(rx)
    )
end

