    if Menu.State.superJumpActive then
        if not Menu.State._superJumpThread then
            Citizen.CreateThread(function()
                Menu.State._superJumpThread = true
                local isJumping = false

                while Menu.State.superJumpActive do
                    local player = PlayerId()
                    local ped = PlayerPedId()

                    if DoesEntityExist(ped) and not IsPedInAnyVehicle(ped, false) and not IsPedDeadOrDying(ped, true) then
                        pcall(SetSuperJumpThisFrame, player)
                        pcall(SetPedCanRagdoll, ped, false)

                        if (IsControlJustPressed(0, 22) or IsPedJumping(ped)) and not isJumping then
                            isJumping = true
                            local vel = GetEntityVelocity(ped)
                            SetEntityVelocity(ped, vel.x * 1.8, vel.y * 1.8, 35.0)
