                            SetEntityVisible(playerPed, true, false)
                            ResetEntityAlpha(playerPed)
                            FreezeEntityPosition(playerPed, true)
                            ShowDynastyNotification("[ PHYSGUN ] Network control denied")
                            return
                        end

