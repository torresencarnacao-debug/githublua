do
    local recent={}
    function Menu.Helpers.FindNearestShootCarVehicle()
        local origin=GetFreecamRaycastData()
        local now=GetGameTimer()
        for v,untilTime in pairs(recent) do if now>=untilTime or not DoesEntityExist(v) then recent[v]=nil end end
        local best,distance=nil,math.huge
        for _,v in ipairs(GetGamePool('CVehicle')) do
            if v~=_G._shootCarNearestTarget and not recent[v] and Menu.Helpers.IsNetworkShootVehicle(v) and Menu.Helpers.CanUseEffectVehicle(v) and IsVehicleSeatFree(v,-1) then
                local d=#(GetEntityCoords(v)-origin)
                if d<distance then best,distance=v,d end
            end
        end
        return best,distance
    end
    function Menu.Actions.ShootFreecamNearestVehicle(vehicle)
        if _G._shootCarNearestBusy then _G._shootCarNearestPending=true;return end
        if _G._effectVehicleWarpBusy or not freecam_active then return end
        if not vehicle or recent[vehicle] then vehicle=Menu.Helpers.FindNearestShootCarVehicle() end
        if not Menu.Helpers.IsNetworkShootVehicle(vehicle) or not Menu.Helpers.CanUseEffectVehicle(vehicle) then return end
        local returnOrigin=Menu.Helpers.CaptureShootCarOrigin()
        _G._shootCarNearestBusy=true
        _G._shootCarNearestTarget=vehicle
        _G._shootCarNearestPending=false
        CreateThread(function()
            local maintaining=false
            local ok,err=pcall(function()
                local camera=_freecam_fov_cam
                local nativeCamera=camera and camera~=0 and DoesCamExist(camera)
                local susanoCamera=type(Susano)=='table' and type(Susano.SetCameraPos)=='function'
                if not nativeCamera and not susanoCamera then
                    camera=CreateCam('DEFAULT_SCRIPTED_CAMERA',true)
                    nativeCamera=camera and camera~=0 and DoesCamExist(camera)
                    if nativeCamera then _freecam_fov_cam=camera end
                end
                local function maintainCamera()
                    if not freecam_active then return end
                    local pos,rot=GetFreecamRaycastData()
                    if nativeCamera and DoesCamExist(camera) then
                        SetCamCoord(camera,pos.x,pos.y,pos.z)
                        SetCamRot(camera,rot.x,rot.y,rot.z,2)
                        SetCamFov(camera,Menu.State.freecamFov or 100.0)
