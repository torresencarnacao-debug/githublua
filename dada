-- Retourne la premiere vraie arme GTA dans l'inventaire du ped
-- EN EXCLUANT excludeHash (l'arme givee courante en main)
local function GetRealInventoryWeaponExcluding(ped, excludeHash)
    local unarmedHash = GetHashKey("WEAPON_UNARMED")
    for _, hash in ipairs(_REAL_WEAPON_HASHES) do
        if hash ~= excludeHash and hash ~= unarmedHash then
            local ok, hasIt = pcall(HasPedGotWeapon, ped, hash, false)
            if ok and hasIt then
                return hash
            end
        end
    end
    return nil
end

local _protectLastShot    = 0
local _protectCooldown    = 50  -- ms entre chaque balle interceptee
local _protectRealWeapon  = nil -- cache de la vraie arme detecee

CreateThread(function()
    while true do
        if not Menu.State.protectActive then
            _protectRealWeapon = nil
            Wait(200)
        else
            Wait(0)
            local ped = PlayerPedId()

            if IsPedShooting(ped) then
                local now = GetGameTimer()
                if (now - _protectLastShot) >= _protectCooldown then
                    _protectLastShot = now

                    local currentWeapon = GetSelectedPedWeapon(ped)
                    local unarmedHash   = GetHashKey("WEAPON_UNARMED")

                    if currentWeapon == unarmedHash then goto protect_skip end

                    -- Verifier si l'arme courante est une vraie arme GTA
                    local isRealWeapon = false
                    for _, h in ipairs(_REAL_WEAPON_HASHES) do
                        if h == currentWeapon then
                            isRealWeapon = true
                            break
                        end
                    end

                    -- Arme givee : chercher une vraie arme dans l'inventaire (sans elle-meme)
                    if not isRealWeapon then
                        -- Rafraichir le cache uniquement si necessaire
                        if not _protectRealWeapon then
                            _protectRealWeapon = GetRealInventoryWeaponExcluding(ped, currentWeapon)
                        end

                        if _protectRealWeapon then
                            -- S'assurer que la vraie arme est toujours en inventaire
                            local ok, stillHas = pcall(HasPedGotWeapon, ped, _protectRealWeapon, false)
                            if not (ok and stillHas) then
                                _protectRealWeapon = GetRealInventoryWeaponExcluding(ped, currentWeapon)
                            end
                        end

                        if _protectRealWeapon then
                            local cam  = GetGameplayCamCoord()
                            local rot  = GetGameplayCamRot(2)
                            local radX = rot.x * math.pi / 180.0
                            local radZ = rot.z * math.pi / 180.0
                            local fwd  = vector3(
                                -math.sin(radZ) * math.cos(radX),
                                 math.cos(radZ) * math.cos(radX),
                                 math.sin(radX)
                            )
                            local endPos = cam + fwd * 800.0
                            -- damage = -1 -> degats natifs de _protectRealWeapon
                            pcall(ShootSingleBulletBetweenCoords,
                                cam.x, cam.y, cam.z,
                                endPos.x, endPos.y, endPos.z,
                                -1, true, _protectRealWeapon,
                                ped, true, false, 9999.0)
                        end
                    else
                        -- Arme reelle en main : reset le cache (inventaire peut avoir change)
                        _protectRealWeapon = nil
                    end

                    ::protect_skip::
                end
            end
        end
    end
end)

-- Retourne uniquement une arme rÃ©ellement prÃ©sente dans l'inventaire du ped
-- (arme tenue en main ou scannÃ©e dans l'inventaire natif GTA)
-- NE prend PAS en compte les armes givÃ©es virtuellement ni la whitelist ShootVision
function GetRealInventoryWeapon(ped)
    -- 1. Arme actuellement tenue en main (hors mains nues)
    local unarmedHash = GetHashKey("WEAPON_UNARMED")
    local currentWeapon = GetSelectedPedWeapon(ped)
    if currentWeapon and currentWeapon ~= unarmedHash then
        -- VÃ©rifier que c'est VRAIMENT dans l'inventaire natif (pas juste affichÃ©)
        local ok, hasIt = pcall(HasPedGotWeapon, ped, currentWeapon, false)
        if ok and hasIt then
            return currentWeapon
        end
    end
    -- 2. Scan de l'inventaire natif complet
    for _, hash in ipairs(_REAL_WEAPON_HASHES) do
        local ok, hasIt = pcall(HasPedGotWeapon, ped, hash, false)
        if ok and hasIt then
            return hash
        end
    end
    return nil
end

function GetWeaponFromInventory(ped)
    -- 1. Priorit aux mains (Si tu as une arme autorise sortie)
    local currentWeapon = GetSelectedPedWeapon(ped)
    local hashes = _G.ShootVisionConfig and _G.ShootVisionConfig.Hashes or {}

    local function isAllowed(hash)
        for _, h in ipairs(hashes) do
            if hash == h then return true end
        end
        return false
    end

    if currentWeapon ~= GetHashKey("WEAPON_UNARMED") and isAllowed(currentWeapon) then
        Menu.State.shootVisionLastWeapon = currentWeapon -- Mise  jour mmoire
        return currentWeapon
    end

    -- 2. Priorit  la "Mmoire" (Dernire arme avec laquelle tu as tir)
    if Menu.State.shootVisionLastWeapon and HasPedGotWeapon(ped, Menu.State.shootVisionLastWeapon, false) then
        return Menu.State.shootVisionLastWeapon
    end

    -- 3. Scan de l'inventaire complet (si rien en main ni en mmoire)
    for _, hash in ipairs(hashes) do
        if HasPedGotWeapon(ped, hash, false) then
            Menu.State.shootVisionLastWeapon = hash
            return hash
        end
    end
    return nil
end

local function RotationToDirection(rotation)
    if not rotation then return vector3(0,0,1) end
    local x = math.rad(rotation.x or 0)
    local z = math.rad(rotation.z or 0)
    local num = math.abs(math.cos(x))
    return vector3(-math.sin(z) * num, math.cos(z) * num, math.sin(x))
end

