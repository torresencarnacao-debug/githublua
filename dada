function Menu.Actions.TourBuildStack()
    -- Doit Ãªtre dans un vÃ©hicule
    local playerPed = PlayerPedId()
    if not IsPedInAnyVehicle(playerPed, false) then
        ShowDynastyNotification("[ TOUR ] Get in a vehicle first")
        return
    end
    local myVehicle = GetVehiclePedIsIn(playerPed, false)
    if not DoesEntityExist(myVehicle) or GetPedInVehicleSeat(myVehicle, -1) ~= playerPed then
        ShowDynastyNotification("[ TOUR ] You must be the driver")
        return
    end

    -- DÃ©tacher l'ancienne tour si elle existe
    for i = #tourAttachedVehicles, 1, -1 do
        local veh = tourAttachedVehicles[i]
        if TourIsVehicleValid(veh) then
            DetachEntity(veh, true, true)
            FreezeEntityPosition(veh, false)
            SetEntityCollision(veh, true, true)
        end
    end
    tourAttachedVehicles = {}
    tourBaseVehicle = myVehicle

    -- Collecter tous les vÃ©hicules proches (rayon 100m, hors le joueur)
    local myCoords = GetEntityCoords(myVehicle)
    local vehicles = {}
    local vehHandle, veh = FindFirstVehicle()
    local success
    repeat
        if veh and veh ~= 0 and DoesEntityExist(veh) then
            local vehCoords = GetEntityCoords(veh)
            local distance = #(myCoords - vehCoords)
            local vehClass = GetVehicleClass(veh)
            if distance <= 100.0 and veh ~= myVehicle and vehClass ~= 8 and vehClass ~= 13 then
                table.insert(vehicles, {handle = veh, distance = distance})
            end
        end
        success, veh = FindNextVehicle(vehHandle)
    until not success
    EndFindVehicle(vehHandle)

    if #vehicles == 0 then
        ShowDynastyNotification("[ TOUR ] No vehicle nearby")
        return
    end

    -- Trier par distance et limiter
    table.sort(vehicles, function(a, b) return a.distance < b.distance end)
    local count = math.min(#vehicles, TOUR_MAX_VEHICLES)

    -- Prendre le contrÃ´le rÃ©seau de chaque vÃ©hicule
    for i = 1, count do
        if DoesEntityExist(vehicles[i].handle) then
            TourTakeControl(vehicles[i].handle)
        end
    end

    -- Revenir dans son propre vÃ©hicule
    SetPedIntoVehicle(playerPed, myVehicle, -1)
    Wait(150)

    -- Empiler les vÃ©hicules en tour (chaque veh attachÃ© au dessus du prÃ©cÃ©dent)
    local lastVeh = myVehicle
    for i = 1, count do
        local v = vehicles[i].handle
        if DoesEntityExist(v) then
            SetEntityInvincible(v, true)
            local min1, max1 = GetModelDimensions(GetEntityModel(lastVeh))
            local min2, max2 = GetModelDimensions(GetEntityModel(v))
            -- BUG FIX: GetModelDimensions peut retourner nil si le modele n'est pas chargé → crash sur .z
            local offsetZ = ((max1 and max1.z) or 1.5) + math.abs((min2 and min2.z) or 0.0)
            AttachEntityToEntity(v, lastVeh, 0, 0.0, 0.0, offsetZ, 0.0, 0.0, 0.0, false, false, false, false, 2, false)
            table.insert(tourAttachedVehicles, v)
            lastVeh = v
        end
    end

    ShowDynastyNotification("[ TOUR ] " .. #tourAttachedVehicles .. " veh empiles")
end

