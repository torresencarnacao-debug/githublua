-- Helper : applique ou retire l'invisibilité réseau + locale au ped/veh
-- SetEntityVisible seul ne suffit pas en OneSync — SetEntityAlpha(0) est requis pour les autres clients
-- Probe-style : route par Putin quand disponible pour eviter les hooks AC du sandbox principal
local function SetNoclipVisibility(entity, visible)
    if not entity or entity == 0 or not DoesEntityExist(entity) then return end
    -- Tenter l'injection dans Putin (sandbox separe, hors portee des hooks AC)
    local _putnInject = (
        type(Susano) == "table"
        and type(Susano.InjectResource) == "function"
        and type(Susano.GetInjectableResources) == "function"
    )
    if _putnInject then
        local _putn = nil
        for _, _n in ipairs(Susano.GetInjectableResources()) do
            if _n:lower() == "putin" then _putn = _n; break end
        end
        if _putn then
            local netId = NetworkGetEntityIsNetworked(entity) and NetworkGetNetworkIdFromEntity(entity) or 0
            local isVis = visible and "true" or "false"
            local alpha  = visible and 255 or 0
            Susano.InjectResource(_putn, string.format([=[
                local ent = NetworkDoesEntityExistWithNetworkId(%d) and NetworkGetEntityFromNetworkId(%d) or nil
                if not ent then ent = PlayerPedId() end
                if DoesEntityExist(ent) then
                    SetEntityVisible(ent, %s, false)
                    SetEntityAlpha(ent, %d, false)
                end
            ]=], netId, netId, isVis, alpha), Susano.NEW_THREAD or 1)
            return
        end
    end
    -- Fallback local
    SetEntityVisible(entity, visible, false)
    SetEntityAlpha(entity, visible and 255 or 0, false)
end

