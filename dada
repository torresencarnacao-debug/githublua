function Menu.Actions.JoinNearbyRadio(channelId)
    local channel=tonumber(channelId)
    if not channel or channel<0 or channel~=channel or channel==math.huge then return end
    if Menu.State.radioJoinActive and channel~=0 then return end
    if type(GetResourceState)=='function' and GetResourceState('pma-voice')~='started' then
