    local c = GetPedBoneCoords(
        ped, boneB, 0.0, 0.0, 0.0
    )

    staffThickLine(
        a.x, a.y, a.z,
        c.x, c.y, c.z,
        r, g, b, 255
    )
end

local function drawSkeleton(ped, r, g, b)
    for _, pair in ipairs(bones) do
        drawBone(
            ped, pair[1], pair[2],
            r, g, b
        )
    end
end

local function drawText3D(x, y, z, message, r, g, b)
