        end
    end
    local session, running, serial = nil, true, 0
    local pendingStart = false
    local function log(message) print('[' .. id .. '] ' .. message) end
    local function readOptional(fn, ...)
        if type(fn) ~= 'function' then return 'indisponible' end
        local success, value = pcall(fn, ...)
        if success then return value end
        return 'erreur_lecture'
    end
    local function isTrue(value) return value == true or value == 1 end
    local function readReasons(pd)
        local safe = readOptional(_W90.GetGameInstanceDefaultDataByKey, 'safe')
