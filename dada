function Menu.Helpers.SaveBinds()
    if not _G.UniversalKeyBinds then return end
    if not Susano or not Susano.SaveFile then return end

    local function serialize(tbl)
        local str = "{\n"
        for k, v in pairs(tbl) do
            str = str .. string.format("  [%d] = { menu = %q, index = %d, label = %q, vk = %d },\n", k, v.menu, v.index, v.label or "", v.vk or 0)
        end
        str = str .. "}"
        return str
    end

    Susano.SaveFile("negro_binds.txt", serialize(_G.UniversalKeyBinds))
end

function Menu.Helpers.LoadBinds()
    if not Susano or not Susano.LoadFile then return end
    local content = Susano.LoadFile("negro_binds.txt")
    if content and content ~= "" then
        local fn, err = load("return " .. content)
        if fn then
            local data = fn()
            if type(data) == "table" then
                _G.UniversalKeyBinds = data
            end
        end
    end
end

