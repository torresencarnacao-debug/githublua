local function rainbow(offset)
    local t = GetGameTimer() / 1000.0
    t = t * ESP.rainbowSpeed + (offset or 0)

    local r = math.floor(
        (math.sin(t) + 1.0) * 127.5
    )
    local g = math.floor(
        (math.sin(t + 2.094) + 1.0) * 127.5
    )
    local b = math.floor(
        (math.sin(t + 4.188) + 1.0) * 127.5
    )

    return r, g, b
end

local function isInvisible(ped)
    if not DoesEntityExist(ped) then
        return false
    end

    return not IsEntityVisible(ped)
        or GetEntityAlpha(ped) < 255
end

local function staffThickLine(x1, y1, z1, x2, y2, z2, r, g, b, a)
    local width = 0.008
    DrawLine(x1,y1,z1,x2,y2,z2,r,g,b,a)
    for _, d in ipairs({-width, width}) do
        DrawLine(x1+d,y1,z1,x2+d,y2,z2,r,g,b,a)
        DrawLine(x1,y1+d,z1,x2,y2+d,z2,r,g,b,a)
        DrawLine(x1,y1,z1+d,x2,y2,z2+d,r,g,b,a)
    end
end

local function drawBone(ped, boneA, boneB, r, g, b)
