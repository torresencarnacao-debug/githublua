function Menu.Helpers.GetKeybindOptions()
    local options = {}
    local binds = _G.UniversalKeyBinds or {}
    local list = {}
    for k, v in pairs(binds) do
        table.insert(list, { key = k, bind = v })
    end
    table.sort(list, function(a, b) return (a.bind.label or "") < (b.bind.label or "") end)

    for _, entry in ipairs(list) do
        local keyName = Menu.Helpers.GetKeyName(entry.bind.vk, entry.key)
        local label = (entry.bind.label or "Action") .. " : " .. keyName
        local savedIdx = (_G.KeybindSelectorState and _G.KeybindSelectorState[entry.key]) or 1
        table.insert(options, {
            type = "bind_entry",
            label = label,
            id = "bind_action",
            bindKey = entry.key,
            bindData = entry.bind,
            options = { "Changer", "Supprimer" },
            valueIdx = savedIdx
        })
    end
    return options
end

function Menu.Helpers.GetCurrentMenuList()
    local menu = (Menu.State and Menu.State.currentMenu) or "MAIN"
    local list = {}
    if menu == "MAIN" then list = (Menu.Data and Menu.Data.Options and Menu.Data.Options.Main) or {}
    elseif menu == "PLAYER" then list = Menu.Helpers.GetPlayerOptions and Menu.Helpers.GetPlayerOptions() or {}
    elseif menu == "MOVEMENT" then list = Menu.Helpers.GetMovementOptions and Menu.Helpers.GetMovementOptions() or {}
    elseif menu == "ONLINE" then list = Menu.Helpers.GetOnlineMenuList and Menu.Helpers.GetOnlineMenuList() or {}
    elseif menu == "TROLL" then list = (Menu.Data and Menu.Data.Options and Menu.Data.Options.Troll and Menu.Data.Options.Troll.Categories and Menu.Data.Options.Troll.Categories[Menu.State.trollTab]) or {}
    elseif menu == "COMBAT" then list = (Menu.Data and Menu.Data.Options and Menu.Data.Options.Combat and Menu.Data.Options.Combat.Categories and Menu.Data.Options.Combat.Categories[Menu.State.combatTab]) or {}
    elseif menu == "VEHICLE" then
        if Menu.State.vehicleTab == 1 then list = Menu.Helpers.GetVehicleMenuList and Menu.Helpers.GetVehicleMenuList() or {}
        else list = (Menu.Data and Menu.Data.Options and Menu.Data.Options.Vehicle and Menu.Data.Options.Vehicle.Categories and Menu.Data.Options.Vehicle.Categories[Menu.State.vehicleTab]) or {} end
    elseif menu == "KEYBINDS" then list = Menu.Helpers.GetKeybindOptions()
    elseif menu == "ACTIVE_BINDS" then list = Menu.Helpers.GetActiveBindsOptions and Menu.Helpers.GetActiveBindsOptions() or {}
    else list = (Menu.Data and Menu.Data.Options and Menu.Data.Options[menu]) or {} end
    return list
end

