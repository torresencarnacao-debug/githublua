function Menu.Actions.ToggleCarryVehicle()
    Menu.State.carryActive = not Menu.State.carryActive
    if Menu.State.carryActive then
        ShowDynastyNotification("[ CARRY VEHICLE ] Actif")

        CreateThread(function()
            local isProcessing = false

            while Menu.State.carryActive do
                Wait(0)
                local ped = PlayerPedId()
                if not DoesEntityExist(ped) or IsEntityDead(ped) then goto skip_tick end

                -- 1. Si un véhicule est déjà porté
                if Menu.State.carryingVehicle then
                    local carried = Menu.State.carriedVehicle
                    if not carried or not DoesEntityExist(carried) or IsEntityDead(carried) then
                        Menu.State.carryingVehicle = false
                        Menu.State.carriedVehicle = nil
                        ClearPedTasksImmediately(ped)
                    else
                        local vCoords = GetEntityCoords(carried)
                        if vCoords then
                            DrawCarryText3D(vCoords.x, vCoords.y, vCoords.z + 0.8, "[E] Lancer")
                        end
                    end
                else
                    -- 2. Affichage 3D [E] Grab sur le véhicule visé
                    local targetVeh = GetVehicleInFOV(80.0)
                    if targetVeh and DoesEntityExist(targetVeh) and IsEntityAVehicle(targetVeh) and not IsPedInVehicle(ped, targetVeh, false) then
                        local vCoords = GetEntityCoords(targetVeh)
                        if vCoords then
                            DrawCarryText3D(vCoords.x, vCoords.y, vCoords.z + 0.6, "[E] Grab")
                        end
                    end
                end

                -- 3. Touche E (Pression / Relâchement)
                local ePressed = IsControlJustPressed(0, 38) or IsDisabledControlJustPressed(0, 38) or IsControlJustReleased(0, 38) or IsDisabledControlJustReleased(0, 38)

                if ePressed then
                    if not Menu.State.carryingVehicle then
                        local targetVeh = GetVehicleInFOV(80.0)
                        if targetVeh and DoesEntityExist(targetVeh) and IsEntityAVehicle(targetVeh) and not IsPedInVehicle(ped, targetVeh, false) then
                            if not isProcessing then
                                isProcessing = true
                                CreateThread(function()
                                    local playerPed = PlayerPedId()
                                    local initialCoords = GetEntityCoords(playerPed)
                                    local initialHeading = GetEntityHeading(playerPed)

                                    if IsPedInVehicle(playerPed, targetVeh, false) then
                                        isProcessing = false
                                        return
                                    end

                                    if IsPedInAnyVehicle(playerPed, false) then
                                        ClearPedTasksImmediately(playerPed)
                                        Wait(100)
                                        playerPed = PlayerPedId()
                                        initialCoords = GetEntityCoords(playerPed)
                                    end

                                    SetVehicleDoorsLocked(targetVeh, 1)
                                    SetVehicleDoorsLockedForAllPlayers(targetVeh, false)

                                    local function RequestControl(entity, timeoutMs)
                                        if not entity or not DoesEntityExist(entity) then return false end
                                        local start = GetGameTimer()
                                        NetworkRequestControlOfEntity(entity)
                                        while not NetworkHasControlOfEntity(entity) do
                                            Wait(10)
                                            if not DoesEntityExist(entity) then return false end
                                            if GetGameTimer() - start > (timeoutMs or 500) then return false end
                                            NetworkRequestControlOfEntity(entity)
                                        end
                                        return true
                                    end

                                    -- Pipeline NPC Hijack avec prise de contrôle OneSync
                                    RequestControl(targetVeh, 800)
                                    SetEntityAsMissionEntity(targetVeh, true, true)

                                    local tStart = GetGameTimer()
                                    while (GetGameTimer() - tStart) < 800 do
                                        RequestControl(targetVeh, 200)

                                        local drv = GetPedInVehicleSeat(targetVeh, -1)
                                        if drv ~= 0 and drv ~= playerPed and DoesEntityExist(drv) then
                                            RequestControl(drv, 200)
                                            ClearPedTasksImmediately(drv)
                                            SetEntityAsMissionEntity(drv, true, true)
                                            if not IsPedAPlayer(drv) then
                                                SetEntityCoords(drv, 0.0, 0.0, -100.0, false, false, false, false)
                                                Wait(10)
                                                DeleteEntity(drv)
                                            else
                                                TaskLeaveVehicle(drv, targetVeh, 16)
                                            end
                                        end

                                        SetPedIntoVehicle(playerPed, targetVeh, -1)
                                        Wait(10)

                                        if IsPedInVehicle(playerPed, targetVeh, false) and GetPedInVehicleSeat(targetVeh, -1) == playerPed then
                                            break
                                        end
                                        Wait(10)
                                    end

                                    -- Sortie propre et temporisation indispensable (libération de la mémoire physique CPhysics)
                                    if IsPedInVehicle(playerPed, targetVeh, false) then
                                        TaskLeaveVehicle(playerPed, targetVeh, 4160)
                                        Wait(150)
                                    end

                                    ClearPedTasksImmediately(playerPed)
                                    SetEntityCoordsNoOffset(playerPed, initialCoords.x, initialCoords.y, initialCoords.z, false, false, false)
                                    SetEntityHeading(playerPed, initialHeading)
                                    Wait(150)

                                    -- Vérification de sécurité absolue avant l'attachement pour éviter tout crash
                                    playerPed = PlayerPedId()
                                    if DoesEntityExist(playerPed) and DoesEntityExist(targetVeh) and not IsPedInAnyVehicle(playerPed, false) then
                                        SetEntityCollision(targetVeh, false, false)
                                        if SetEntityNoCollisionEntity then
                                            pcall(SetEntityNoCollisionEntity, targetVeh, playerPed, false)
                                            pcall(SetEntityNoCollisionEntity, playerPed, targetVeh, false)
                                        end

                                        RequestAnimDict("random@mugging3")
                                        local t0 = GetGameTimer()
                                        while not HasAnimDictLoaded("random@mugging3") and (GetGameTimer() - t0) < 300 do Wait(10) end
                                        if HasAnimDictLoaded("random@mugging3") and DoesEntityExist(playerPed) then
                                            TaskPlayAnim(playerPed, "random@mugging3", "handsup_standing_base", 8.0, -1, -1, 49, 0, false, false, false)
                                        end

                                        Wait(50)
                                        local attachedOK = pcall(AttachEntityToEntity, targetVeh, playerPed, 0, 0.0, 0.5, 2.6, 0.0, 0.0, 0.0, false, false, false, false, 0, true)
                                        if attachedOK then
                                            Menu.State.carriedVehicle = targetVeh
                                            Menu.State.carryingVehicle = true
                                        end
                                    else
                                        ShowDynastyNotification("[ CARRY ] Annule par securite ped")
                                    end
                                    isProcessing = false
                                end)
                            end
                        end
                    else
                        -- LANCER / PROPULSER LE VEHICULE DEPUIS LA TETE
                        local carriedVeh = Menu.State.carriedVehicle
                        if carriedVeh and DoesEntityExist(carriedVeh) then
                            pcall(DetachEntity, carriedVeh, true, true)
                            SetEntityCollision(carriedVeh, true, true)
                            SetEntityDynamic(carriedVeh, true)
                            ActivatePhysics(carriedVeh)

                            local camRot = GetGameplayCamRot(2)
                            local pitch = math.rad(camRot.x or 0.0)
                            local yaw = math.rad(camRot.z or 0.0)
                            local dir = vector3(
                                -math.sin(yaw) * math.abs(math.cos(pitch)),
                                math.cos(yaw) * math.abs(math.cos(pitch)),
                                math.sin(pitch)
                            )

                            local speed = 250.0
                            SetEntityVelocity(carriedVeh, dir.x * speed, dir.y * speed, dir.z * speed + 20.0)
                            ApplyForceToEntity(carriedVeh, 1, dir.x * speed * 3.0, dir.y * speed * 3.0, (dir.z * speed + 50.0), 0.0, 0.0, 0.0, 0, false, true, true, false, true)
                        end

                        ClearPedTasksImmediately(ped)
                        Menu.State.carryingVehicle = false
                        Menu.State.carriedVehicle = nil
                        Wait(350)
                    end
                end

                ::skip_tick::
            end
        end)
    else
        ShowDynastyNotification("[ CARRY VEHICLE ] Desactive")
        local ped = PlayerPedId()
        if DoesEntityExist(ped) then ClearPedTasksImmediately(ped) end
        if Menu.State.carriedVehicle and DoesEntityExist(Menu.State.carriedVehicle) then
            pcall(function()
                DetachEntity(Menu.State.carriedVehicle, true, true)
                SetEntityCollision(Menu.State.carriedVehicle, true, true)
            end)
        end
        Menu.State.carryingVehicle = false
        Menu.State.carriedVehicle = nil
    end
end

function Menu.Actions.ToggleSuperJump()
