                        if type(Susano.LockCameraPos)=='function' then Susano.LockCameraPos(true) end
                        Susano.SetCameraPos(pos.x,pos.y,pos.z)
                    end
                end
                maintainCamera()
                maintaining=true
                -- Un seul gardien camera pour toute la rafale, pas un thread par clic.
                CreateThread(function()
                    while maintaining and freecam_active do
                        local safe,why=pcall(maintainCamera)
                        if not safe then print('[ SHOOT CAR ] Camera : '..tostring(why));break end
                        Wait(0)
                    end
                end)
                repeat
                    local candidate=vehicle
                    _G._shootCarNearestTarget=candidate
                    local acquired=Menu.Helpers.AcquireEffectVehicleByWarp(candidate,function()
                        return freecam_active and Menu.Helpers.IsNetworkShootVehicle(candidate)
                    end,{seatMs=0,stableMs=0,timeoutMs=180,pollMs=0,leaveMs=300,leavePollMs=0,returnOrigin=returnOrigin})
                    if not Menu.Helpers.RestoreShootCarOrigin(returnOrigin) then
                        ShowDynastyNotification('[ SHOOT CAR ] Retour non confirme : rafale annulee')
                        break
                    end
                    if not freecam_active then break end
                    maintainCamera()
                    if acquired and Menu.Helpers.IsNetworkShootVehicle(candidate) and Menu.Helpers.CanUseEffectVehicle(candidate)
                        and (not NetworkGetEntityIsNetworked(candidate) or NetworkHasControlOfEntity(candidate)) then
                        local origin,rotation,direction=GetFreecamRaycastData()
                        local low,high=GetModelDimensions(GetEntityModel(candidate))
                        local distance=3.0+math.max(math.abs(low.y),math.abs(high.y))
                        local launch=origin+direction*distance
                        -- Exclure la voiture avant de liberer le tir suivant.
                        recent[candidate]=GetGameTimer()+1800
                        FreezeEntityPosition(candidate,false)
                        SetEntityCoordsNoOffset(candidate,launch.x,launch.y,launch.z,false,false,false)
                        SetEntityRotation(candidate,rotation.x,0.0,rotation.z,2,true)
                        SetEntityAngularVelocity(candidate,0.0,0.0,0.0)
                        SetEntityVelocity(candidate,direction.x*120.0,direction.y*120.0,direction.z*120.0)
                    else
                        recent[candidate]=GetGameTimer()+750
                        if not _G._shootCarNearestPending then ShowDynastyNotification('[ SHOOT CAR ] Prise refusee') end
                    end
                    _G._shootCarNearestTarget=nil
                    if not _G._shootCarNearestPending then break end
                    _G._shootCarNearestPending=false
                    Wait(0)
                    if not freecam_active or _G._effectVehicleWarpBusy then break end
                    vehicle=Menu.Helpers.FindNearestShootCarVehicle()
                until not vehicle
            end)
            -- Meme point de retour pour toute la rafale, meme apres erreur ou annulation.
            local safe,returned=pcall(Menu.Helpers.RestoreShootCarOrigin,returnOrigin)
            maintaining=false
            if not safe or not returned then
                ShowDynastyNotification('[ SHOOT CAR ] Retour non confirme : tirs arretes')
            end
            _G._shootCarNearestTarget=nil
            _G._shootCarNearestPending=false
            _G._shootCarNearestBusy=false
            if not ok then print('[ SHOOT CAR ] '..tostring(err));ShowDynastyNotification('[ SHOOT CAR ] Erreur : voir F8') end
        end)
    end
end


function Menu.Helpers.RequestEffectVehicle(veh,timeout)
    if not Menu.Helpers.CanUseEffectVehicle(veh) then return false end
    if not NetworkGetEntityIsNetworked(veh) or NetworkHasControlOfEntity(veh) then return true end
    local started=GetGameTimer()
