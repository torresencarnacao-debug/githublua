    Menu.State.radioJoinActive=true
    CreateThread(function()
        local ok,err=pcall(function()
            local sent,why=Menu.Helpers.RequestNearbyRadioJoin(channel)
            if not sent then error(why) end
            ShowDynastyNotification(channel==0 and '[ RADIO ] Deconnexion demandee' or '[ RADIO ] Connexion demandee : '..tostring(channel))
            local deadline=GetGameTimer()+2000
            repeat
