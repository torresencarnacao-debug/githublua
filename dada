function Menu.Actions.HandleHorizontalNavigation(dir)
    local menu = Menu.State.currentMenu
    local isSlider = false
    local opt = Menu.State.selectedOption

    -- 1. Identify context
    if Menu.State.currentMenu == "PLAYER" and opt == 3 then
        -- SOLO SESSION : ←/→ cycle entre Normal et Full Invisible
        local current = Menu.State.soloSessionIdx or 1
        local newIdx = current + dir
        if newIdx > 2 then newIdx = 1
        elseif newIdx < 1 then newIdx = 2 end
        Menu.State.soloSessionIdx = newIdx
        _G.soloSessionIdx = newIdx
        local names = {"Normal", "Full Invisible"}
        ShowDynastyNotification("[ SESSION ] Mode : " .. names[newIdx])
        PlaySoundFrontend(-1, "NAV_LEFT_RIGHT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        return
    elseif Menu.State.currentMenu == "PLAYER" and opt == 5 then
        -- MIRAGE PEWPEW : ←/→ cycle
        local current = Menu.State.miragePewPewIdx or 1
        local newIdx = current + dir
        if newIdx > 4 then newIdx = 1
        elseif newIdx < 1 then newIdx = 4 end
        
        Menu.State.miragePewPewIdx = newIdx
        Menu.State.miragePewPewPreviewIdx = newIdx
        Menu.State.pistolStaffActive = (newIdx == 2 or newIdx == 4)
        Menu.State.carPistolActive   = (newIdx == 3 or newIdx == 4)
        
        -- Sync the old selectedIdx variable too just in case
        miragePewPewSelectedIdx = newIdx
        
        local names = {"OFF", "Pistol Staff", "Car Pistol", "Both"}
        ShowDynastyNotification("[ MIRAGE PEWPEW ] " .. names[newIdx])
        PlaySoundFrontend(-1, "NAV_LEFT_RIGHT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        return
    elseif Menu.State.currentMenu == "VEHICLE" then
        local vlist
        if Menu.State.vehicleTab == 1 then
            vlist = Menu.Helpers.GetVehicleMenuList()
        else
            vlist = Menu.Data.Options.Vehicle.Categories[Menu.State.vehicleTab]
        end
