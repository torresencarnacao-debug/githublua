                            while (GetGameTimer() - t1) < 500 do
                                if IsVehicleSeatFree(targetVeh, -1) and tryEnterSeat(-1) then
                                    takeoverSuccess = true
                                    break
                                end
                                Wait(0)
                            end
                            if takeoverSuccess then break end
                            Wait(0)
