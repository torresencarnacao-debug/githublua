    Menu.State.loadingProgress = 0

    -- Chargement fluide : ease-out cubique, jamais de recul
    local function advanceToIsLoading(targetP, ms, status)
        if status then Menu.State.loadingStatus = status end
        local startP  = Menu.State.loadingProgress
        if targetP <= startP then return end
        local steps   = math.max(1, math.floor(ms / 16))
        for s = 1, steps do
            local t     = s / steps
            local eased = 1 - (1 - t) ^ 3
            local p     = math.floor(startP + (targetP - startP) * eased)
            if p > Menu.State.loadingProgress then
                Menu.State.loadingProgress = math.min(p, 100)
            end
            Wait(16)
        end
        Menu.State.loadingProgress = math.max(Menu.State.loadingProgress, targetP)
