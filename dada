-- Vehicule vise par la camera de jeu (raycast), ou nil
function Menu.Helpers.GetAimedVehicle(maxDist)
    local playerPed = PlayerPedId()
    local camPos = GetGameplayCamCoord()
    local camRot = GetGameplayCamRot(2)
    local pitch  = math.rad(camRot.x)
    local yaw    = math.rad(camRot.z)
    local dist   = maxDist or 400.0
    local dirX   = -math.sin(yaw) * math.cos(pitch)
    local dirY   =  math.cos(yaw) * math.cos(pitch)
    local dirZ   =  math.sin(pitch)
    local ray = StartExpensiveSynchronousShapeTestLosProbe(
        camPos.x, camPos.y, camPos.z,
        camPos.x + dirX * dist, camPos.y + dirY * dist, camPos.z + dirZ * dist,
        -1, playerPed, 7
    )
    local _, hit, hitCoords, _, entityHit = GetShapeTestResult(ray)
    local myVeh = GetVehiclePedIsIn(playerPed, false)
    local found = nil
    if hit == 1 or hit == true then
        if entityHit and entityHit ~= 0 and DoesEntityExist(entityHit) then
            local t = GetEntityType(entityHit)
            if t == 2 then
                found = entityHit
            elseif t == 1 then
                local v = GetVehiclePedIsIn(entityHit, false)
                if v and v ~= 0 and DoesEntityExist(v) then found = v end
            end
        end
        if not found and hitCoords then
            local near = GetClosestVehicle(hitCoords.x, hitCoords.y, hitCoords.z, 6.0, 0, 70)
            if near and near ~= 0 and DoesEntityExist(near) then found = near end
        end
    end
    if found and found == myVeh then return nil end
    return found
end

