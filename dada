-- FREECAM BLACK HOLE (MAINTIEN CLIC GAUCHE)
-- Aspire les vehicules libres vers le point vise par la camera freecam.
-- Aucun joueur cible requis. S'arrete au relachement du clic.
-- ================================================================
_G.FreecamBHHold_active = false

function Menu.Actions.FreecamBlackHoleHold()
    if not freecam_active then
        ShowDynastyNotification("[ BLACK HOLE ] Ouvre la freecam d'abord")
        return
    end
    if _G.FreecamBHHold_active then return end

    CreateThread(function()
        _G.FreecamBHHold_active = true

        -- Calculer le centre du trou = raycast depuis la cam freecam
        local pitch = math.rad(cam_rot.x)
        local yaw   = math.rad(cam_rot.z)
        local dir   = vector3(-math.sin(yaw) * math.cos(pitch), math.cos(yaw) * math.cos(pitch), math.sin(pitch))

        local raycast = StartExpensiveSynchronousShapeTestLosProbe(
            cam_pos.x, cam_pos.y, cam_pos.z,
            cam_pos.x + dir.x * 1000.0,
            cam_pos.y + dir.y * 1000.0,
            cam_pos.z + dir.z * 1000.0,
            -1, PlayerPedId(), 7
        )
        local _, hit, hitCoords = GetShapeTestResult(raycast)
        local holeCenter = (hit and hitCoords ~= vector3(0,0,0)) and hitCoords or (cam_pos + dir * 300.0)

        -- Scanner les vehicules libres dans 800m autour du centre
        local playerPed = PlayerPedId()
        local savedPos  = GetEntityCoords(playerPed)
        local playerVeh = GetVehiclePedIsIn(playerPed, false)
        local netIds = {}

        for _, veh in ipairs(GetGamePool("CVehicle")) do
            if DoesEntityExist(veh) and veh ~= playerVeh then
                local vCoords = GetEntityCoords(veh)
                local dist = #(holeCenter - vCoords)
                local vehClass = GetVehicleClass(veh)
                -- Vérifier que le véhicule est entièrement vide (conducteur + passagers)
                local occupied = false
                local numSeats = GetVehicleMaxNumberOfPassengers(veh)
                for seat = -1, numSeats - 1 do
                    local ped = GetPedInVehicleSeat(veh, seat)
                    if ped ~= 0 and DoesEntityExist(ped) then
                        occupied = true
                        break
                    end
                end
                if dist <= 350.0 and vehClass ~= 8 and vehClass ~= 13 and not occupied then
                    if NetworkGetEntityIsNetworked(veh) then
                        table.insert(netIds, { netId = NetworkGetNetworkIdFromEntity(veh), handle = veh })
                    end
                end
            end
        end

        if #netIds == 0 then
            _G.FreecamBHHold_active = false
            ShowDynastyNotification("[ BLACK HOLE ] Aucun vehicule libre")
            return
        end

        -- Limiter a 8 vehicules les plus proches du centre
        table.sort(netIds, function(a, b)
            local ca = GetEntityCoords(a.handle)
            local cb = GetEntityCoords(b.handle)
            return #(holeCenter - ca) < #(holeCenter - cb)
        end)
        while #netIds > 8 do table.remove(netIds) end

        -- Prise de controle ownership + collisions forcees ON
        -- Invisible pendant le warp seulement si bypass seed inactif
        if not Menu.State.bypassSeedActive then
            SetEntityVisible(playerPed, true, false)
            ResetEntityAlpha(playerPed)
        end
        local controlled = {}
        for _, entry in ipairs(netIds) do
            local veh = entry.handle
            if DoesEntityExist(veh) then
                SetPedIntoVehicle(playerPed, veh, -1)
                Wait(150)
                SetEntityAsMissionEntity(veh, true, true)
                if NetworkGetEntityIsNetworked(veh) then
                    NetworkRequestControlOfEntity(veh)
                    local t = 0
                    while not NetworkHasControlOfEntity(veh) and t < 50 do
                        NetworkRequestControlOfEntity(veh)
                        Wait(10)
                        t = t + 1
                    end
                end
                SetEntityCoordsNoOffset(playerPed, savedPos.x, savedPos.y, savedPos.z, false, false, false)
                -- Forcer collisions ON : les vehicules se percutent entre eux
                SetEntityCollision(veh, true, true)
                table.insert(controlled, entry.netId)
            end
        end

        -- Restaurer visibilite apres la prise de controle
        SetEntityVisible(playerPed, true, false)
        ResetEntityAlpha(playerPed)

        if #controlled == 0 then
            _G.FreecamBHHold_active = false
            ShowDynastyNotification("[ BLACK HOLE ] Controle impossible")
            return
        end

        ShowDynastyNotification("[ BLACK HOLE ] " .. #controlled .. " veh — relache pour stopper")

        -- Boucle d'attraction tant que clic gauche maintenu
        local spawnedExplosions = {}
        local frameCount = 0
        while _G.FreecamBHHold_active do
            local clickHeld = Susano and Susano.GetAsyncKeyState and Susano.GetAsyncKeyState(0x01)
            if not clickHeld then break end
            Wait(0)
            frameCount = frameCount + 1

            -- Recalculer le centre a chaque frame selon le crosshair freecam
            local pitch2 = math.rad(cam_rot.x)
            local yaw2   = math.rad(cam_rot.z)
            local dir2   = vector3(-math.sin(yaw2) * math.cos(pitch2), math.cos(yaw2) * math.cos(pitch2), math.sin(pitch2))
            local ray2 = StartExpensiveSynchronousShapeTestLosProbe(
                cam_pos.x, cam_pos.y, cam_pos.z,
                cam_pos.x + dir2.x * 1000.0,
                cam_pos.y + dir2.y * 1000.0,
                cam_pos.z + dir2.z * 1000.0,
                1 | 16,
                PlayerPedId(), 7
            )
            local _, hit2, hitCoords2 = GetShapeTestResult(ray2)
            if hit2 and hitCoords2 ~= vector3(0,0,0) then
                holeCenter = hitCoords2
            else
                holeCenter = cam_pos + dir2 * 300.0
            end

            for _, netId in ipairs(controlled) do
                local veh = NetToVeh(netId)
                if veh and veh ~= 0 and DoesEntityExist(veh) then
                    -- Re-demander le controle + ré-affirmer collisions toutes les 60 frames
                    if frameCount % 60 == 0 then
                        if NetworkGetEntityIsNetworked(veh) and not NetworkHasControlOfEntity(veh) then
                            NetworkRequestControlOfEntity(veh)
                        end
                        SetEntityCollision(veh, true, true)
                    end

                    local vCoords = GetEntityCoords(veh)
                    local dx = holeCenter.x - vCoords.x
                    local dy = holeCenter.y - vCoords.y
                    local dz = holeCenter.z - vCoords.z
                    local dist = math.sqrt(dx*dx + dy*dy + dz*dz)

                    if dist < 3.0 then
                        -- Impact : exploser
                        if not spawnedExplosions[netId] then
                            spawnedExplosions[netId] = true
                            SetVehicleEngineHealth(veh, -4000.0)
                            SetVehicleBodyHealth(veh, 0.0)
                            NetworkExplodeVehicle(veh, true, false, -1)
                            AddExplosion(vCoords.x, vCoords.y, vCoords.z, 2, 10.0, true, false, 1.0)
                        end
                    elseif dist > 0.5 then
                        local spd = math.min(80.0, 8.0 + (200.0 / math.max(dist, 1.0)) * 8.0)
                        local nx, ny, nz = dx/dist, dy/dist, dz/dist
                        local spiral = 0.45
                        SetEntityVelocity(veh,
                            (nx - ny * spiral) * spd,
                            (ny + nx * spiral) * spd,
                            nz * spd)
                        local curRot = GetEntityRotation(veh, 2)
                        SetEntityRotation(veh, curRot.x + 8.0, curRot.y + 5.0, curRot.z + 12.0, 2, true)
                    end
                end
            end
        end

        -- Nettoyage (collisions jamais désactivées : rien à restaurer)

        _G.FreecamBHHold_active = false
        ShowDynastyNotification("[ BLACK HOLE ] OFF")
    end)
end

