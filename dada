function Menu.Helpers.GetWeaponAttachOptions()
    local ped = PlayerPedId()
    local weapHash = GetSelectedPedWeapon(ped)
    if not weapHash or weapHash == 0 or weapHash == GetHashKey("WEAPON_UNARMED") then
        return {{ type = "attach", name = "Aucune arme equipee", id = "none", weapHash = 0, toggleActive = false }}
    end
    local result = {}
    local catCounts = {}
    for _, def in ipairs(_ATTACH_DEFS) do
        for _, compName in ipairs(def.comps) do
            local compHash = GetHashKey(compName)
            local compatible = false
            local has = false
            local ok, hasNow = pcall(HasPedGotWeaponComponent, ped, weapHash, compHash)
            if ok and hasNow then
                compatible = true
                has = true
            else
                pcall(GiveWeaponComponentToPed, ped, weapHash, compHash)
                local ok2, nowHas = pcall(HasPedGotWeaponComponent, ped, weapHash, compHash)
                if ok2 and nowHas then
                    compatible = true
                    pcall(RemoveWeaponComponentFromPed, ped, weapHash, compHash)
                end
            end
            if compatible then
                catCounts[def.id] = (catCounts[def.id] or 0) + 1
                table.insert(result, {
                    type = "attach",
                    name = def.name .. " " .. catCounts[def.id],
                    id = compName,
                    weapHash = weapHash,
                    toggleActive = has,
                })
            end
        end
    end
    if #result == 0 then
        table.insert(result, { type = "attach", name = "Aucun accessoire disponible", id = "none", weapHash = weapHash, toggleActive = false })
    end

    table.insert(result, { type = "separator", name = "--- Mods ---", label = "--- Mods ---" })
    table.insert(result, {
        type = "weapon_size",
        name = "Weapon Size",
        id = "weapon_size",
        state = "weaponSizeActive"
    })
    table.insert(result, {
        type = "toggle",
        name = "Weapon RGB",
        id = "weapon_rgb",
        state = "weaponRgbActive"
    })

    return result
end

