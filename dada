function Menu.Actions.SoloSession()
    local mode = Menu.State.soloSessionIdx or 1

    if mode == 1 then
        -- Mode Normal : solo session standard, comportement original
        Menu.State.soloSessionActive = not Menu.State.soloSessionActive
        if Menu.State.soloSessionActive then
            NetworkStartSoloTutorialSession()
            ShowDynastyNotification("[ SESSION ] Solo ON")
        else
            NetworkEndTutorialSession()
            ShowDynastyNotification("[ SESSION ] Solo OFF")
        end
    else
        -- Mode Full Invisible : maintient en permanence une position réseau à z-60
        -- sous la map, mais localement le joueur reste à sa vraie position.
        -- Technique : boucle active qui alterne entre pos réseau (-60) et pos locale réelle.
        -- Le serveur + autres joueurs voient toujours le ped à z-60, donc personne
        -- ne peut vous streamer ni vous voir, même après un chargement de session.
        Menu.State.soloSessionActive = not Menu.State.soloSessionActive
        Menu.State.soloSessionFullInvisActive = Menu.State.soloSessionActive
        if Menu.State.soloSessionActive then
            NetworkStartSoloTutorialSession()
            ShowDynastyNotification("[ SESSION ] Full Invisible ON")
            CreateThread(function()
                Wait(300)
                while Menu.State.soloSessionFullInvisActive do
                    local myPed = PlayerPedId()
                    if not DoesEntityExist(myPed) then Wait(100) break end

                    -- Sauvegarder la position réelle locale
                    local c = GetEntityCoords(myPed)

                    -- Envoyer au réseau la position sous la map (z-60)
                    -- NetworkSetEntityCoordsNoOffset force la sync réseau sans bouger le rendu local
                    NetworkSetEntityCoordsNoOffset(myPed, c.x, c.y, c.z - 60.0, false, false, false)

                    -- Attendre 2 frames pour que le paquet réseau parte
                    Wait(0)
                    Wait(0)

                    -- Rétablir la position locale immédiatement (le client reste sur place)
                    SetEntityCoordsNoOffset(myPed, c.x, c.y, c.z, false, false, false)

                    -- Répéter toutes les 500ms pour maintenir le desync serveur en continu
                    Wait(500)
                end
            end)
        else
            NetworkEndTutorialSession()
            Menu.State.soloSessionFullInvisActive = false
            ShowDynastyNotification("[ SESSION ] Full Invisible OFF")
        end
    end
end

