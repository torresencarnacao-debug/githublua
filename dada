function Menu.Helpers.ApplyConfigData(data)
    if type(data) ~= "table" then return end
    if data.sidebarSide    then Menu.State.sidebarSide = data.sidebarSide end
    if data.menuScale      then _G.menuScale = data.menuScale; Menu.Cache.lastResCheck = 0 end
    if data.freecam_layout then _G.freecam_layout = data.freecam_layout end

    if data.themeIndex and Menu.Themes and Menu.Themes[data.themeIndex] then
        Menu.ThemeIndex = data.themeIndex
        local theme = Menu.Themes[data.themeIndex]
        if theme then Menu.Colors = theme end
    end
    if data.bannerIndex and Menu.AvailableBanners and Menu.AvailableBanners[data.bannerIndex] then
        Menu.BannerIndex = data.bannerIndex
        local b = Menu.AvailableBanners[data.bannerIndex]
        Menu.Banner.imageUrl = b.url
        if type(Menu.LoadBannerTexture) == "function" then Menu.LoadBannerTexture(b.url) end
        if type(Menu.ApplyBannerTheme)  == "function" then Menu.ApplyBannerTheme(b.name) end
    end

    if data.fullGodMode     ~= nil then Menu.State.fullGodModeActive   = data.fullGodMode     end
    if data.semiGodMode     ~= nil then Menu.State.semiGodModeActive   = data.semiGodMode     end
    if data.noWanted        ~= nil then Menu.State.noWantedActive       = data.noWanted        end
    if data.noReload        ~= nil then Menu.State.noReloadActive       = data.noReload        end
    if data.infiniteAmmo    ~= nil then Menu.State.infiniteAmmoActive   = data.infiniteAmmo    end
    if data.superJump       ~= nil then Menu.State.superJumpActive      = data.superJump       end
    if data.ragdollOff      ~= nil then Menu.State.ragdollOffActive     = data.ragdollOff      end
    if data.playerInvisible ~= nil then Menu.State.playerInvisible      = data.playerInvisible end
    if data.shiftBoost      ~= nil then Menu.State.shiftBoostActive     = data.shiftBoost      end
    if data.noclipInvisible ~= nil then Menu.State.noclipInvisible      = data.noclipInvisible end
    if data.noclipPose      ~= nil then Menu.State.noclipPose           = data.noclipPose      end
    if data.noclipSpeed     ~= nil then Menu.State.noclipSpeed          = data.noclipSpeed     end
    if data.slide           ~= nil then Menu.State.slideActive          = data.slide           end
    if data.antiCollision   ~= nil then Menu.State.antiCollisionActive  = data.antiCollision   end
    if data.damageBoost     ~= nil then Menu.State.damageBoostActive    = data.damageBoost     end
    if data.rapidFire       ~= nil then Menu.State.rapidFireActive      = data.rapidFire       end
    if data.highlighterSizeIdx ~= nil then
        Menu.State.highlighterSizeIdx = data.highlighterSizeIdx
        local sizes = { 1.0, 2.0, 3.5 }
        Menu.State.highlighterThickness = sizes[data.highlighterSizeIdx] or 1.0
    end

    -- Restaurer les binds
    if data.binds and data.binds ~= "" then
        local fn, err = load("return " .. data.binds)
        if fn then
            local ok, bindsData = pcall(fn)
            if ok and type(bindsData) == "table" then
                if not _G.UniversalKeyBinds then _G.UniversalKeyBinds = {} end
                for k, v in pairs(bindsData) do
                    -- Ne pas ecraser les binds fixes (M=244, H=251)
                    if k ~= 244 and k ~= 251 then
                        _G.UniversalKeyBinds[k] = v
                    end
                end
            end
        end
    end
end

